# enum_parse.tcyr — string -> enum inverses (1.10.0) + service-set accessors
#
# Every enum had a `*_str` and no inverse, so each consumer reading a
# service definition out of config hand-rolled its own mapping. Same
# reasoning agnostik applied at 1.4.0 F-018.
include "tests/test_header.cyr"

fn main() {
    alloc_init();
    test_group("enum-parse");

    # --- restart policy round-trips ---
    #
    # ⚠ v6.6.0 VALUE FORM. `Ok(v)` / `Err(e)` are a (tag, payload) REGISTER
    # PAIR, not a heap box. `payload(r)` is DELETED and has no 1-argument
    # replacement — rdx never reaches a parameter — so every site below binds
    # BOTH halves with `var t, v = f();` and asserts on `v` directly.
    # The tag is now asserted too: under the old boxed form `payload()` on an
    # Err returned EINVAL, and only the value comparison stood between that and
    # a green test. `is_ok(t)` is free here, so the parse result is checked for
    # being Ok as well as for carrying the right member.
    var rp_a_t, rp_a_v = restart_policy_parse(str_from("always"));
    assert(is_ok(rp_a_t) == 1, "rp always is Ok");
    assert_eq(rp_a_v, RESTART_ALWAYS, "rp always");
    var rp_f_t, rp_f_v = restart_policy_parse(str_from("on-failure"));
    assert(is_ok(rp_f_t) == 1, "rp on-failure is Ok");
    assert_eq(rp_f_v, RESTART_ON_FAILURE, "rp on-failure");
    var rp_n_t, rp_n_v = restart_policy_parse(str_from("never"));
    assert(is_ok(rp_n_t) == 1, "rp never is Ok");
    assert_eq(rp_n_v, RESTART_NEVER, "rp never");
    # Round-trip through _str for every member — this is the property that
    # keeps the two directions from drifting apart.
    var rt_a_t, rt_a_v = restart_policy_parse(str_from(restart_policy_str(RESTART_ALWAYS)));
    assert(is_ok(rt_a_t) == 1, "rp roundtrip always is Ok");
    assert_eq(rt_a_v, RESTART_ALWAYS, "rp roundtrip always");
    var rt_f_t, rt_f_v = restart_policy_parse(str_from(restart_policy_str(RESTART_ON_FAILURE)));
    assert(is_ok(rt_f_t) == 1, "rp roundtrip on-failure is Ok");
    assert_eq(rt_f_v, RESTART_ON_FAILURE, "rp roundtrip on-failure");
    var rt_n_t, rt_n_v = restart_policy_parse(str_from(restart_policy_str(RESTART_NEVER)));
    assert(is_ok(rt_n_t) == 1, "rp roundtrip never is Ok");
    assert_eq(rt_n_v, RESTART_NEVER, "rp roundtrip never");

    # An unrecognised string must ERROR, not fall back to a default policy —
    # a typo in config has to surface, not silently become RESTART_ALWAYS.
    # A 1-argument call receives rax, which IS the tag, so these stay as-is.
    assert(is_err_result(restart_policy_parse(str_from("Always"))) == 1, "rp rejects case variant");
    assert(is_err_result(restart_policy_parse(str_from("on_failure"))) == 1, "rp rejects underscore");
    assert(is_err_result(restart_policy_parse(str_from(""))) == 1, "rp rejects empty");
    assert(is_err_result(restart_policy_parse(str_from("unknown"))) == 1, "rp rejects _str fallback");

    # --- service type ---
    var st_s_t, st_s_v = service_type_parse(str_from("simple"));
    assert(is_ok(st_s_t) == 1, "st simple is Ok");
    assert_eq(st_s_v, SVC_SIMPLE, "st simple");
    var st_f_t, st_f_v = service_type_parse(str_from("forking"));
    assert(is_ok(st_f_t) == 1, "st forking is Ok");
    assert_eq(st_f_v, SVC_FORKING, "st forking");
    var st_o_t, st_o_v = service_type_parse(str_from("oneshot"));
    assert(is_ok(st_o_t) == 1, "st oneshot is Ok");
    assert_eq(st_o_v, SVC_ONESHOT, "st oneshot");
    assert(is_err_result(service_type_parse(str_from("Simple"))) == 1, "st rejects case variant");

    # --- boot mode ---
    var bm_sv_t, bm_sv_v = boot_mode_parse(str_from("server"));
    assert(is_ok(bm_sv_t) == 1, "bm server is Ok");
    assert_eq(bm_sv_v, BOOT_SERVER, "bm server");
    var bm_dk_t, bm_dk_v = boot_mode_parse(str_from("desktop"));
    assert(is_ok(bm_dk_t) == 1, "bm desktop is Ok");
    assert_eq(bm_dk_v, BOOT_DESKTOP, "bm desktop");
    var bm_mn_t, bm_mn_v = boot_mode_parse(str_from("minimal"));
    assert(is_ok(bm_mn_t) == 1, "bm minimal is Ok");
    assert_eq(bm_mn_v, BOOT_MINIMAL, "bm minimal");
    var bm_ed_t, bm_ed_v = boot_mode_parse(str_from("edge"));
    assert(is_ok(bm_ed_t) == 1, "bm edge is Ok");
    assert_eq(bm_ed_v, BOOT_EDGE, "bm edge");
    var bm_rc_t, bm_rc_v = boot_mode_parse(str_from("recovery"));
    assert(is_ok(bm_rc_t) == 1, "bm recovery is Ok");
    assert_eq(bm_rc_v, BOOT_RECOVERY, "bm recovery");
    assert(is_err_result(boot_mode_parse(str_from("EDGE"))) == 1, "bm rejects case variant");

    # --- health check type ---
    var hc_h_t, hc_h_v = health_check_type_parse(str_from("http"));
    assert(is_ok(hc_h_t) == 1, "hc http is Ok");
    assert_eq(hc_h_v, HC_HTTP_GET, "hc http");
    var hc_t_t, hc_t_v = health_check_type_parse(str_from("tcp"));
    assert(is_ok(hc_t_t) == 1, "hc tcp is Ok");
    assert_eq(hc_t_v, HC_TCP_CONNECT, "hc tcp");
    var hc_c_t, hc_c_v = health_check_type_parse(str_from("command"));
    assert(is_ok(hc_c_t) == 1, "hc command is Ok");
    assert_eq(hc_c_v, HC_COMMAND, "hc command");
    var hc_p_t, hc_p_v = health_check_type_parse(str_from("process-alive"));
    assert(is_ok(hc_p_t) == 1, "hc process-alive is Ok");
    assert_eq(hc_p_v, HC_PROCESS_ALIVE, "hc process-alive");
    assert(is_err_result(health_check_type_parse(str_from("https"))) == 1, "hc rejects unknown");

    # --- registered-service accessors (1.10.0) ---
    # init_service_defs must cover the DEFAULTS, not just config services —
    # that gap is why kybernet's start_services never started anything.
    var cfg = argonaut_config_default();
    var init = argonaut_init_new(cfg);
    var defs = init_service_defs(init);
    var names = init_service_names(init);
    assert_eq(vec_len(defs), vec_len(names), "defs and names agree in count");
    assert(vec_len(defs) > 0, "defaults are registered and visible");

    # And the names must be usable as-is against the cstr-keyed init_* API:
    # a boxed Str here would miss the map and return 0.
    var n0 = vec_get(names, 0);
    assert(init_get_service(init, n0) != 0, "name from init_service_names resolves");

    # --- a COMPLETED ONESHOT satisfies a dependency (1.10.0) ---
    # Before 1.10.0 the dep check was `dep_state != STATE_RUNNING`, and a
    # oneshot ends in STATE_STOPPED — so nothing could ever depend on one,
    # and the dependent's start returned -1 with no diagnostic. Oneshots are
    # exactly how you express "run this setup step before X", so depends_on
    # was unusable for its main use case.
    var c2 = argonaut_config_default();
    var dep = svc_def_new(str_from("os-dep"), str_from("d"), str_from("/bin/true"));
    svc_def_set_service_type(dep, SVC_ONESHOT);
    var user = svc_def_new(str_from("os-user"), str_from("u"), str_from("/bin/true"));
    svc_def_set_service_type(user, SVC_ONESHOT);
    vec_push(svc_def_deps(user), str_from("os-dep"));
    vec_push(config_services(c2), dep);
    vec_push(config_services(c2), user);

    var i2 = argonaut_init_new(c2);

    # Dependency has never run: the dependent must be refused.
    assert_eq(init_set_service_state(i2, "os-user", STATE_STARTING), 0, "dep: unstarted oneshot blocks");

    # Run the dependency to completion, then the dependent may start.
    assert_eq(init_start_service(i2, "os-dep"), 0, "dep: oneshot completes (returns 0)");
    assert_eq(init_get_service_state(i2, "os-dep"), STATE_STOPPED, "dep: oneshot ends STOPPED");
    assert_eq(init_set_service_state(i2, "os-user", STATE_STARTING), 1, "dep: completed oneshot satisfies");

    return assert_summary();
}
var r = main();
syscall(SYS_EXIT, r);
