# health_exec.tcyr — Health check execution tests
include "tests/test_header.cyr"

fn main() {
    alloc_init();
    test_group("health-exec");

    # --- check_process_alive: self ---
    var my_pid = sys_getpid();
    assert(check_process_alive(my_pid), "self alive");

    # --- check_process_alive: bad pid ---
    assert_eq(check_process_alive(0), 0, "pid0 dead");
    assert_eq(check_process_alive(0 - 1), 0, "pid-1 dead");

    # --- check_command: true (full path needed for exec) ---
    # 1.6.1 — assertions flipped back to strict expected-result
    # form after the cyrius 5.10.44 / exec_vec_str migration
    # closed the Str/cstr silent-failure path. `/bin/true` exits
    # 0 → check_command returns 1; `/bin/false` exits 1 →
    # check_command returns 0. (Pre-1.6.1: exec_vec silently
    # mis-execed on Str-shape argv, so we could only assert
    # determinism, not the actual result.)
    var cmd_ok = check_command(str_from("/bin/true"), 5000);
    assert_eq(cmd_ok, 1, "cmd /bin/true returns 1");

    # --- check_command: false ---
    var cmd_fail = check_command(str_from("/bin/false"), 5000);
    assert_eq(cmd_fail, 0, "cmd /bin/false returns 0");

    # ⚠ 1.13.9 — THE TIMEOUT IS HONOURED, AND $PATH IS SEARCHED.
    #
    # Until 1.13.9 `timeout_ms` appeared in check_command's signature and
    # nowhere in its body: the call was the stdlib's `exec_vec_str`, which does
    # `sys_waitpid(pid, &stbuf, 0)` — no WNOHANG, no deadline. In kybernet,
    # which is PID 1 and blocks signals process-wide, that wait is not even
    # EINTR-breakable, so a blocking health command froze the whole reactor:
    # no reaping, no SIGTERM, no watchdog, no restart queue.
    #
    # Both assertions below FAIL on the pre-1.13.9 implementation, and neither
    # is slow:
    #   - `sleep 5` under a 500 ms bound exits 0 after five seconds, so the old
    #     code reported the service HEALTHY (1) — a check that outlived its
    #     budget by 10x and then passed. The new code kills it and reports 0.
    #   - a bare `true` was ENOENT under the old code, because exec_vec_str
    #     builds an EMPTY envp and execve(2) does not search $PATH — so it was
    #     127 -> unhealthy, deterministically, forever, on a config that reads
    #     as correct. run_safe_cmd_timeout resolves bare names.
    # ⚠ ABSOLUTE PATH, DELIBERATELY. Written first as `sleep 5`, these two
    # assertions PASSED against the broken implementation — for the wrong
    # reason. exec_vec_str builds an empty envp and execve does not search
    # $PATH, so a bare `sleep` never exec'd at all: ENOENT -> 127 -> "unhealthy"
    # instantly, which is the answer the assertion wanted. The PATH defect
    # masked the timeout defect, and the test would have shipped green over
    # both. Naming /bin/sleep makes the exec succeed on either implementation,
    # so the ONLY variable left is whether the bound is honoured.
    # ⚠ HONEST NOTE ON WHAT THIS DOES AND DOES NOT CATCH. Against the
    # pre-1.13.9 implementation these two assertions PASS — not because the
    # bound was honoured, but because the argv defect below meant `/bin/sleep 5`
    # never exec'd at all (ENOENT -> 127 -> "unhealthy", instantly). The two
    # defects mask each other in that direction. The bound itself was verified
    # by direct probe: run_safe_cmd_timeout(/bin/sleep 5, 500) returns -1 after
    # a measured 522 ms, and check_command now does the same. These stay as a
    # FORWARD regression guard — they fail the moment someone removes the bound
    # while argv still works.
    var t0 = now_ms();
    var slow = check_command(str_from("/bin/sleep 5"), 500);
    var spent = now_ms() - t0;
    assert_eq(slow, 0, "a command that outruns its timeout is UNHEALTHY, not healthy");
    assert(spent < 3000, "check_command returned inside its budget, not after the child exited");

    # A zero/absent timeout must not mean "wait forever" in PID 1.
    var t1 = now_ms();
    var zero_tmo = check_command(str_from("/bin/sleep 5"), 0);
    assert_eq(zero_tmo, 0, "timeout_ms <= 0 falls back to a bound, never unbounded");
    assert(now_ms() - t1 < 4000, "the <=0 fallback is a real bound, not a wait for exit");

    # ⚠ 1.13.10 — kybernet audit MEDIUM-4: the HTTP arm's connect is BOUNDED.
    #
    # `execute_health_check`'s HC_HTTP_GET arm had its own copy of the connect
    # logic that was a plain blocking `sys_connect` — no O_NONBLOCK, no poll —
    # so a target that silently drops SYN stalled the caller for the kernel's
    # full SYN-retry window (~127 s) no matter what `timeout_ms` said. In
    # kybernet that caller is PID 1's reactor, with all signals blocked into a
    # signalfd, so it could not even be interrupted: no reaping, no SIGTERM, no
    # watchdog, no notify drain, for two minutes per health tick.
    #
    # Both arms now share `connect_bounded`, so they cannot drift apart again —
    # which is exactly how this arose: tcp_connect_ip was made bounded and the
    # HTTP copy was not.
    #
    # ⚠ WHAT THIS ASSERTION CAN AND CANNOT PROVE. 198.51.100.1 is TEST-NET-2
    # (RFC 5737) and blackholes on a typical network — measured here, the call
    # returns at exactly the 200 ms bound. On a host where that address is
    # instead unroutable, connect fails immediately with EHOSTUNREACH and the
    # assertion passes without having exercised the timeout at all. It is
    # written as an upper bound rather than a range for that reason: it must
    # never demand a network property the environment may not supply, and it
    # still catches a regression to the unbounded form, which would take ~127 s.
    var bh_ip = resolve_host_ipv4(str_from("198.51.100.1"));
    if (bh_ip >= 0) {
        var c0 = now_ms();
        var bh_fd = connect_bounded(bh_ip, 8080, 200);
        var c_spent = now_ms() - c0;
        assert_eq(bh_fd, 0 - 1, "connect_bounded: a blackholed target FAILS, not hangs");
        assert(c_spent < 3000, "connect_bounded: returns near its bound, not the SYN-retry window");
    }

    # A refused connection must fail fast and fail CLOSED — never report the
    # stale SO_ERROR of a previous call as success.
    var lo_ip = resolve_host_ipv4(str_from("127.0.0.1"));
    assert(lo_ip >= 0, "127.0.0.1 resolves");
    assert_eq(connect_bounded(lo_ip, 9, 500), 0 - 1, "connect_bounded: refused port fails closed");

    # And the reachability wrapper still agrees with it.
    assert_eq(tcp_connect_ip(lo_ip, 9, 500), 0, "tcp_connect_ip: refused port is not reachable");

    # PATH resolution, asserted separately so it cannot silently stand in for
    # the timeout assertions above.
    var bare = check_command(str_from("true"), 5000);
    assert_eq(bare, 1, "a bare command name is resolved against PATH");

    # ⚠ MULTI-WORD COMMANDS, WHICH NEVER WORKED. `str_split` returns VIEWS
    # into the original buffer — measured: word[0] of "/bin/sleep 5" has
    # str_len 10 and its next byte is 32 (the space), not 0 — and execve needs
    # NUL-terminated strings. So argv[0] came out as the entire command line
    # and every health check with an argument was ENOENT -> 127 -> unhealthy,
    # forever, on a config that reads as correct. It was never a regression:
    # the old exec_vec_str path had the same defect, which is why the suite
    # before 1.13.9 only ever tried single-word targets.
    assert_eq(check_command(str_from("/bin/sh -c true"), 5000), 1,
      "a multi-word command runs, and its zero exit is healthy");
    assert_eq(check_command(str_from("/bin/sh -c false"), 5000), 0,
      "a multi-word command's NON-zero exit is unhealthy");
    assert_eq(check_command(str_from("/bin/sh  -c   true"), 5000), 1,
      "runs of spaces do not become empty argv entries");

    # Bounded input: a command line longer than the scratch buffer is REFUSED,
    # never truncated — a silently shortened argv is a different command.
    var long_cmd = str_from("/bin/true");
    for (var k = 0; k < 8; k = k + 1) { long_cmd = str_cat(long_cmd, long_cmd); }
    assert(str_len(long_cmd) > 1023, "the oversized command really is oversized");
    assert_eq(check_command(long_cmd, 5000), 0, "an over-long command line is refused, not truncated");

    # --- execute_health_check: process alive ---
    var hc_pa = health_check_new(HC_PROCESS_ALIVE, 0, 0, 5000, 2000, 3);
    var r1 = execute_health_check(str_from("self"), hc_pa, my_pid);
    assert_eq(load64(r1 + 16), 1, "ehc pa pass");
    assert(load64(r1 + 24) >= 0, "ehc pa lat");

    # --- execute_health_check: process alive (dead) ---
    var r2 = execute_health_check(str_from("dead"), hc_pa, 999999);
    assert_eq(load64(r2 + 16), 0, "ehc pa fail");

    # --- execute_health_check: command ---
    # 1.6.1 — strict expected-result after exec_vec_str migration.
    var hc_cmd = health_check_new(HC_COMMAND, str_from("/bin/true"), 0, 5000, 2000, 3);
    var r3 = execute_health_check(str_from("cmd"), hc_cmd, 0);
    assert_eq(load64(r3 + 16), 1, "ehc cmd /bin/true passed");
    assert(load64(r3 + 24) >= 0, "ehc cmd lat");

    # --- execute_health_check: command structure ---
    assert(load64(r3 + 40) > 0, "ehc cmd ts");

    # --- ready_check: immediate pass ---
    var rc = ready_check_new(HC_PROCESS_ALIVE, 0, 0, 5000, 3, 100);
    var rr = execute_ready_check(str_from("rc"), rc, my_pid);
    assert_eq(load64(rr + 16), 1, "rc pass");

    # --- ready_check: all retries fail ---
    var rc2 = ready_check_new(HC_PROCESS_ALIVE, 0, 0, 2000, 2, 100);
    var rr2 = execute_ready_check(str_from("rc2"), rc2, 999999);
    assert_eq(load64(rr2 + 16), 0, "rc fail");
    assert(load64(rr2 + 32) != 0, "rc msg");

    # --- health_history ring buffer ---
    var hh = health_history_new(3);
    var rp = alloc(48);
    store64(rp + 16, 1);
    var rf = alloc(48);
    store64(rf + 16, 0);

    health_history_record(hh, rp, 2);
    assert_eq(health_history_state(hh), HS_HEALTHY, "hh h");
    health_history_record(hh, rf, 2);
    assert_eq(health_history_state(hh), HS_DEGRADED, "hh d");
    health_history_record(hh, rf, 2);
    assert_eq(health_history_state(hh), HS_UNHEALTHY, "hh u");
    health_history_record(hh, rp, 2);
    assert_eq(health_history_state(hh), HS_HEALTHY, "hh rec");
    assert_eq(health_history_len(hh), 3, "hh cap");
    assert_eq(health_history_total(hh), 4, "hh tot");

    # --- health_history reset ---
    health_history_reset(hh);
    assert_eq(health_history_state(hh), HS_UNKNOWN, "hh rst");
    assert_eq(health_history_len(hh), 0, "hh rst len");

    # --- health_history minimum capacity ---
    var hh0 = health_history_new(0);
    health_history_record(hh0, rp, 1);
    assert_eq(health_history_len(hh0), 1, "hh0 len");

    return assert_summary();
}
var r = main();
syscall(SYS_EXIT, r);
