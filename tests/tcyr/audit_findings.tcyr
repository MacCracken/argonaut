# audit_findings.tcyr — regression tests for the 1.4.0 P(-1) audit
# (docs/audit/2026-04-26-audit.md). Each `test_group` block targets one
# finding; comments cite the severity tag.

include "tests/test_header.cyr"

fn main() {
    alloc_init();

    # =====================================================================
    # is_hex64 — defensive validation of dm-verity root hashes (LOW-2)
    # =====================================================================
    test_group("audit-low2-is_hex64");

    var h_lower = str_from("0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef");
    var h_upper = str_from("0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF");
    var h_mixed = str_from("0123456789aBcDeF0123456789AbCdEf0123456789abcdef0123456789ABCDEF");
    assert_eq(is_hex64(h_lower), 1, "is_hex64: 64 lowercase hex");
    assert_eq(is_hex64(h_upper), 1, "is_hex64: 64 uppercase hex");
    assert_eq(is_hex64(h_mixed), 1, "is_hex64: mixed-case hex");

    var h_short = str_from("deadbeef");
    var h_long = str_from("0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef00");
    assert_eq(is_hex64(h_short), 0, "is_hex64: rejects short");
    assert_eq(is_hex64(h_long),  0, "is_hex64: rejects long");

    var h_dash = str_from("0123456789abcdef0123456789abcdef0123456789abcdef0123456789abc--ef");
    var h_inj  = str_from("--injected-arg-deadbeef-deadbeef-deadbeef-deadbeef-deadbeef-dead");
    assert_eq(is_hex64(h_dash), 0, "is_hex64: rejects '-' in hash");
    assert_eq(is_hex64(h_inj),  0, "is_hex64: rejects argv-injection-shaped");

    var h_space = str_from("0123456789abcdef 123456789abcdef0123456789abcdef0123456789abcdef");
    assert_eq(is_hex64(h_space), 0, "is_hex64: rejects whitespace");

    # =====================================================================
    # validate_mapper_name — LUKS mapped-device alias (LOW-1)
    # =====================================================================
    test_group("audit-low1-mapper_name");

    assert_eq(validate_mapper_name(str_from("agnos-data")),    1, "mapper: agnos-data");
    assert_eq(validate_mapper_name(str_from("verified_root")), 1, "mapper: verified_root");
    assert_eq(validate_mapper_name(str_from("a")),             1, "mapper: 1-char ok");

    assert_eq(validate_mapper_name(str_from("")),               0, "mapper: rejects empty");
    assert_eq(validate_mapper_name(str_from("../../../etc")),   0, "mapper: rejects ../");
    assert_eq(validate_mapper_name(str_from("foo/bar")),        0, "mapper: rejects slash");
    assert_eq(validate_mapper_name(str_from("foo bar")),        0, "mapper: rejects space");
    assert_eq(validate_mapper_name(str_from("foo;rm")),         0, "mapper: rejects ';'");
    assert_eq(validate_mapper_name(str_from("name\nwith\nnl")), 0, "mapper: rejects newline");

    var long_name = str_from("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");   # 33 chars
    assert_eq(validate_mapper_name(long_name), 0, "mapper: rejects > 32 chars");

    # =====================================================================
    # HIGH-1 — host resolver replaces loopback-only gate (closed 1.5.2)
    # =====================================================================
    # The 1.4.0 fix (`is_localhost_target` gate) preserved the safety
    # property at the cost of feature surface; 1.5.2 swaps in a real
    # IPv4 dotted-quad parser + /etc/hosts scan
    # (`src/resolver.cyr`), so external health checks work as
    # configured while keeping the no-silent-localhost-fallback
    # invariant. `is_localhost_target` is retained for callers that
    # need the predicate; it's no longer the only path through.
    test_group("audit-high1-resolver");

    # --- parse_ipv4 — accepts well-formed dotted quads ---
    assert(parse_ipv4(str_from("127.0.0.1"))         >= 0, "parse_ipv4: 127.0.0.1");
    assert(parse_ipv4(str_from("0.0.0.0"))           >= 0, "parse_ipv4: 0.0.0.0");
    assert(parse_ipv4(str_from("255.255.255.255"))   >= 0, "parse_ipv4: broadcast");
    assert(parse_ipv4(str_from("10.0.0.1"))          >= 0, "parse_ipv4: 10/8");
    assert(parse_ipv4(str_from("192.168.1.1"))       >= 0, "parse_ipv4: 192.168/16");

    # Packing is BE: 127.0.0.1 → (127<<24)|0|0|1 = 0x7f000001.
    assert_eq(parse_ipv4(str_from("127.0.0.1")),         2130706433, "parse_ipv4: 127.0.0.1 packs to 0x7f000001");
    assert_eq(parse_ipv4(str_from("0.0.0.0")),                    0, "parse_ipv4: 0.0.0.0 packs to 0");
    assert_eq(parse_ipv4(str_from("10.0.0.1")),          167772161, "parse_ipv4: 10.0.0.1 packs to 0x0a000001");

    # --- parse_ipv4 — rejects malformed inputs ---
    assert_eq(parse_ipv4(str_from("")),                  0 - 1, "parse_ipv4: rejects empty");
    assert_eq(parse_ipv4(str_from("127")),               0 - 1, "parse_ipv4: rejects single octet");
    assert_eq(parse_ipv4(str_from("127.0.0")),           0 - 1, "parse_ipv4: rejects 3 octets");
    assert_eq(parse_ipv4(str_from("127.0.0.1.5")),       0 - 1, "parse_ipv4: rejects 5 octets");
    assert_eq(parse_ipv4(str_from("256.0.0.1")),         0 - 1, "parse_ipv4: rejects octet > 255");
    assert_eq(parse_ipv4(str_from("999.0.0.1")),         0 - 1, "parse_ipv4: rejects 3-digit overflow");
    assert_eq(parse_ipv4(str_from("127.0.0.")),          0 - 1, "parse_ipv4: rejects trailing dot");
    assert_eq(parse_ipv4(str_from(".127.0.0.1")),        0 - 1, "parse_ipv4: rejects leading dot");
    assert_eq(parse_ipv4(str_from("127..0.1")),          0 - 1, "parse_ipv4: rejects empty octet");
    assert_eq(parse_ipv4(str_from("127.0.0.01")),        0 - 1, "parse_ipv4: rejects leading-zero (CVE-2021-29923)");
    assert_eq(parse_ipv4(str_from("127.0.0.x")),         0 - 1, "parse_ipv4: rejects non-digit");
    assert_eq(parse_ipv4(str_from("localhost")),         0 - 1, "parse_ipv4: rejects hostname");
    assert_eq(parse_ipv4(str_from("::1")),               0 - 1, "parse_ipv4: rejects IPv6");

    # --- resolve_host_ipv4 — full resolution flow ---
    # Dotted quads round-trip through parse_ipv4.
    assert_eq(resolve_host_ipv4(str_from("127.0.0.1")), 2130706433, "resolve: 127.0.0.1 from parser");
    assert_eq(resolve_host_ipv4(str_from("8.8.8.8")),    134744072, "resolve: 8.8.8.8 from parser");

    # /etc/hosts: "localhost" is on every Linux system; resolves
    # to 127.0.0.1 (or whatever the local file pins it to). We
    # don't assert the specific IP — just that resolution succeeds
    # for a name that's always present.
    var localhost_ip = resolve_host_ipv4(str_from("localhost"));
    assert(localhost_ip >= 0, "resolve: localhost present in /etc/hosts");

    # Unresolvable inputs return -1 (not silent-localhost).
    assert_eq(resolve_host_ipv4(str_from("")),                          0 - 1, "resolve: empty");
    assert_eq(resolve_host_ipv4(str_from("definitely.not.in.hosts.invalid")), 0 - 1, "resolve: unknown name");
    assert_eq(resolve_host_ipv4(str_from("::1")),                       0 - 1, "resolve: IPv6 deferred");

    # is_localhost_target retained for callers — still works.
    assert_eq(is_localhost_target(str_from("127.0.0.1")), 1, "is_localhost_target: 127.0.0.1");
    assert_eq(is_localhost_target(str_from("example.com")), 0, "is_localhost_target: rejects example.com");
    assert_eq(is_localhost_target(str_from("localhost.attacker.com")), 0, "is_localhost_target: subdomain trick");

    # End-to-end TCP: an unresolvable host yields a clear failure
    # with the resolver message — not a silent connect to 127.0.0.1.
    var hc = alloc(sizeof(HealthCheck));
    store64(hc, HC_TCP_CONNECT);
    store64(hc + 8, str_from("definitely.not.in.hosts.invalid"));
    store64(hc + 16, 80);
    store64(hc + 24, 0);
    store64(hc + 32, 100);
    store64(hc + 40, 0);
    var r = execute_health_check(str_from("svc"), hc, 0);
    assert_eq(load64(r + 16), 0, "high1: TCP unresolvable = not passed");
    var msg_a = load64(r + 32);
    assert(str_contains(msg_a, str_from("did not resolve")), "high1: TCP message names resolver miss");

    # End-to-end HTTP: same shape against a host that doesn't resolve.
    var hc2 = alloc(sizeof(HealthCheck));
    store64(hc2,      HC_HTTP_GET);
    store64(hc2 + 8,  str_from("http://definitely.not.in.hosts.invalid/healthz"));
    store64(hc2 + 16, 0);
    store64(hc2 + 24, 0);
    store64(hc2 + 32, 100);
    store64(hc2 + 40, 0);
    var r2 = execute_health_check(str_from("svc"), hc2, 0);
    assert_eq(load64(r2 + 16), 0, "high1: HTTP unresolvable = not passed");
    var msg_b = load64(r2 + 32);
    assert(str_contains(msg_b, str_from("did not resolve")), "high1: HTTP message names resolver miss");

    # A resolvable-but-unconnectable target (RFC 5737 TEST-NET-1)
    # gets past the resolver, hits the connect path, and the
    # message reports a connect failure rather than a resolver
    # miss — proves the wiring distinguishes the two failure modes.
    var hc3 = alloc(sizeof(HealthCheck));
    store64(hc3, HC_TCP_CONNECT);
    store64(hc3 + 8, str_from("192.0.2.1"));
    store64(hc3 + 16, 1);            # port 1, certainly closed
    store64(hc3 + 24, 0);
    store64(hc3 + 32, 50);            # short timeout
    store64(hc3 + 40, 0);
    var r3 = execute_health_check(str_from("svc"), hc3, 0);
    assert_eq(load64(r3 + 16), 0, "high1: TCP unreachable = not passed");
    var msg_c = load64(r3 + 32);
    assert(str_contains(msg_c, str_from("connect")), "high1: TCP message distinguishes connect failure");

    # =====================================================================
    # M1 — sd_notify SO_PEERCRED check (notify_try_recv_authenticated)
    # =====================================================================
    test_group("audit-m1-notify-cred");

    # socketpair(AF_UNIX=1, SOCK_DGRAM=2, 0, &fds)
    var fds[8];
    var sp = syscall(53, 1, 2, 0, &fds);
    if (sp == 0) {
        var rfd = load32(&fds);
        var sfd = load32(&fds + 4);

        # Enable SO_PASSCRED on receiver so kernel attaches SCM_CREDENTIALS.
        var one[4];
        store32(&one, 1);
        syscall(54, rfd, 1, 16, &one, 4);   # setsockopt(SOL_SOCKET=1, SO_PASSCRED=16)

        # Send a notify datagram from sfd; kernel stamps sender PID.
        var msg = "READY=1\n";
        syscall(44, sfd, msg, 8, 0, 0, 0);   # sendto(sfd, msg, 8, 0, NULL, 0)

        # Recv with expected = [my_pid] → cred matches → parse + return msg.
        var my_pid = sys_getpid();
        var ok_pids = vec_new();
        vec_push(ok_pids, my_pid);
        var nm_ok = notify_try_recv_authenticated(rfd, ok_pids);
        assert(nm_ok != 0, "m1: cred-matched datagram parsed");
        assert_eq(load64(nm_ok), 1, "m1: parsed READY=1");

        # Send again; recv with wrong pid set → drop, return 0.
        syscall(44, sfd, msg, 8, 0, 0, 0);
        var bad_pids = vec_new();
        vec_push(bad_pids, my_pid + 99999);
        var nm_bad = notify_try_recv_authenticated(rfd, bad_pids);
        assert_eq(nm_bad, 0, "m1: cred-mismatched datagram dropped");

        # Empty queue → 0.
        var nm_empty = notify_try_recv_authenticated(rfd, ok_pids);
        assert_eq(nm_empty, 0, "m1: empty queue returns 0");

        sys_close(rfd);
        sys_close(sfd);
    }

    # pid_in_vec sanity (decoupled from socketpair availability)
    var pv = vec_new();
    vec_push(pv, 100);
    vec_push(pv, 200);
    assert_eq(pid_in_vec(pv, 100), 1, "m1: pid_in_vec hit head");
    assert_eq(pid_in_vec(pv, 200), 1, "m1: pid_in_vec hit tail");
    assert_eq(pid_in_vec(pv, 300), 0, "m1: pid_in_vec miss");
    assert_eq(pid_in_vec(0, 100),  0, "m1: pid_in_vec rejects null vec");

    # =====================================================================
    # M3 — generic-waitpid reaper for orphans (proc_table_reap_orphans)
    # =====================================================================
    test_group("audit-m3-reaper-orphans");

    # Enrol as subreaper so the grandchild orphans up to us, not init.
    syscall(157, 36, 1, 0, 0, 0);   # SYS_prctl(PR_SET_CHILD_SUBREAPER=36, 1)

    var fpid = sys_fork();
    if (fpid == 0) {
        # Child: fork grandchild, then exit immediately so grandchild orphans.
        var gc = sys_fork();
        if (gc == 0) {
            # Grandchild: sleep 50ms so child exits first, then exit.
            var ts[16];
            store64(&ts, 0);
            store64(&ts + 8, 50000000);
            syscall(35, &ts, 0);
            sys_exit(0);
        }
        sys_exit(0);
    }

    # Parent: reap our direct child immediately.
    var st_c[8];
    sys_waitpid(fpid, &st_c, 0);

    # Wait long enough for the grandchild to also exit.
    var ts2[16];
    store64(&ts2, 0);
    store64(&ts2 + 8, 200000000);   # 200ms
    syscall(35, &ts2, 0);

    var n_orphans = proc_table_reap_orphans();
    assert(n_orphans >= 1, "m3: orphan reaped via waitpid(-1)");

    # Idempotent: second call with no waiters → 0; bounded loop, no hang.
    var n_empty = proc_table_reap_orphans();
    assert_eq(n_empty, 0, "m3: empty queue returns 0");

    # =====================================================================
    # L3 — fork_exec_service setsid (child becomes session leader)
    # =====================================================================
    test_group("audit-l3-fork-setsid");

    # Validate the platform setsid syscall used by fork_exec_service:
    # in a forked child, after syscall(112), getsid(0) returns the
    # child's own PID — i.e. the child became a session leader and is
    # now decoupled from any controlling TTY inherited from the parent.
    # End-to-end verification that fork_exec_service actually invokes
    # setsid before exec is gated on the QEMU PID-1 harness in 1.6.0
    # (the existing exec_env Str/cstr quirk noted in health_exec.tcyr
    # blocks unit-level shell exec testing).
    var sid_path = "/tmp/argonaut-l3-sid";
    syscall(87, sid_path);

    var l3_pid = sys_fork();
    if (l3_pid == 0) {
        syscall(112);                     # SYS_setsid
        var sid = syscall(124, 0);        # SYS_getsid(0)
        var sfd = sys_open(sid_path, 65, 384);   # O_WRONLY|O_CREAT, 0o600
        if (sfd >= 0) {
            var sbuf[24];
            var sl = fmt_int_buf(sid, &sbuf);
            sys_write(sfd, &sbuf, sl);
            sys_close(sfd);
        }
        sys_exit(0);
    }
    var st_l[8];
    sys_waitpid(l3_pid, &st_l, 0);

    var rb = alloc(64);
    var rn = file_read_all(sid_path, rb, 64);
    assert(rn > 0, "l3: child wrote sid file");
    var rs = str_to_int(str_new(rb, rn));
    assert_eq(rs, l3_pid, "l3: setsid → child sid == child pid");

    syscall(87, sid_path);

    # =====================================================================
    # 1.5.5 closeout audit (docs/audit/2026-05-10-audit.md)
    # =====================================================================

    test_group("closeout-medium1-etc-hosts-stable-buf");

    # MEDIUM-1: lookup_etc_hosts() must reuse a single static buffer
    # rather than alloc()ing 8 KB per call. Probe by capturing the
    # buffer pointer after a baseline call, then asserting it
    # doesn't move on repeated calls. (Earlier groups in this
    # suite — `audit-high1-resolver` — already triggered the first
    # alloc, so we don't assert `== 0` pre-call; the contract under
    # test is "stable across calls", not "lazy first alloc".)
    resolve_host_ipv4(str_from("localhost"));
    var p1 = _etc_hosts_buf_ptr();
    assert(p1 != 0, "M1: buf populated after lookup");
    var i_m1 = 0;
    while (i_m1 < 100) {
        resolve_host_ipv4(str_from("localhost"));
        i_m1 = i_m1 + 1;
    }
    var p2 = _etc_hosts_buf_ptr();
    assert_eq(p1, p2, "M1: buf ptr stable across 100 lookups");

    test_group("closeout-medium2-persist-disk-fail");

    # MEDIUM-2: audit_log_record_persistent must return 0 when the
    # patrastore append fails. Force the failure by passing a
    # PersistentAuditLog with a poisoned store handle (a sentinel
    # value the audit_ext recognises as "force-fail" — see the
    # `_audit_ext_test_force_disk_fail` helper that flags the store).
    var pal_test = audit_log_open_persistent(str_from("/tmp/argonaut_closeout_m2.patra"));
    assert(pal_test != 0, "M2: open succeeded for setup");
    _audit_ext_test_force_disk_fail(pal_test, 1);
    var e_fail = audit_log_record_persistent(pal_test, "svc-m2", EVT_STARTING);
    assert_eq(e_fail, 0, "M2: disk-fail path returns 0");
    _audit_ext_test_force_disk_fail(pal_test, 0);
    var e_ok = audit_log_record_persistent(pal_test, "svc-m2", EVT_STARTED);
    assert(e_ok != 0, "M2: clean-path still returns entry");
    audit_log_close_persistent(pal_test);
    syscall(87, str_data(str_from("/tmp/argonaut_closeout_m2.patra")));

    test_group("closeout-medium3-persist-tamper-rejected");

    # MEDIUM-3: open must verify chain integrity on replay. Build a
    # 3-entry log, close, mutate one stored entry's details field
    # directly via patra so the chain hash no longer holds, reopen
    # and assert it returns 0 (verify rejected). The mutation
    # helper `_audit_ext_test_mutate_first_detail` performs the
    # in-place SQL update bypassing the audit_log_record API.
    var m3_path = str_from("/tmp/argonaut_closeout_m3.patra");
    syscall(87, str_data(m3_path));
    var m3_pal = audit_log_open_persistent(m3_path);
    audit_log_record_persistent(m3_pal, "svc-m3", EVT_STARTING);
    audit_log_record_persistent(m3_pal, "svc-m3", EVT_STARTED);
    audit_log_record_persistent(m3_pal, "svc-m3", EVT_STOPPED_OK);
    audit_log_flush_persistent(m3_pal);
    audit_log_close_persistent(m3_pal);

    _audit_ext_test_mutate_first_detail(m3_path);

    var m3_pal2 = audit_log_open_persistent(m3_path);
    assert_eq(m3_pal2, 0, "M3: tampered chain rejected on open");
    syscall(87, str_data(m3_path));

    test_group("closeout-low2-http-port-range");

    # LOW-2: HTTP_GET branch must reject port > 65535 with a clear
    # message rather than silent connect-fail on a wraparound port.
    var hc_p = alloc(sizeof(HealthCheck));
    store64(hc_p,      HC_HTTP_GET);
    store64(hc_p + 8,  str_from("http://localhost:99999/healthz"));
    store64(hc_p + 16, 0);
    store64(hc_p + 24, 0);
    store64(hc_p + 32, 100);
    store64(hc_p + 40, 0);
    var r_p = execute_health_check(str_from("svc"), hc_p, 0);
    assert_eq(load64(r_p + 16), 0, "L2: out-of-range port = not passed");
    var msg_p = load64(r_p + 32);
    assert(str_contains(msg_p, str_from("port out of range")), "L2: message names port-range failure");

    test_group("closeout-low3-http-host-crlf");

    # LOW-3: defense-in-depth. The resolver gate already blocks
    # CRLF-containing hosts at parse_ipv4 / /etc/hosts lookup, but
    # `sanitize_host_for_header` is a separate gate so a future
    # refactor that skips the resolver doesn't re-open the injection.
    assert_eq(sanitize_host_for_header(str_from("localhost")),       1, "L3: alphanumeric accepted");
    assert_eq(sanitize_host_for_header(str_from("127.0.0.1")),       1, "L3: dotted quad accepted");
    assert_eq(sanitize_host_for_header(str_from("evil\r\nHost: x")), 0, "L3: CRLF rejected");
    assert_eq(sanitize_host_for_header(str_from("evil\nGET /")),     0, "L3: bare LF rejected");
    assert_eq(sanitize_host_for_header(str_from("")),                0, "L3: empty rejected");
    # NUL embedded in a Str (cstr literals truncate at first NUL —
    # build the string by hand: "evil" + NUL + "null"). Asserts
    # sanitize_host_for_header scans by length, not by NUL terminator.
    var nul_buf = alloc(9);
    store8(nul_buf,     101);   # e
    store8(nul_buf + 1, 118);   # v
    store8(nul_buf + 2, 105);   # i
    store8(nul_buf + 3, 108);   # l
    store8(nul_buf + 4, 0);     # NUL
    store8(nul_buf + 5, 110);   # n
    store8(nul_buf + 6, 117);   # u
    store8(nul_buf + 7, 108);   # l
    store8(nul_buf + 8, 108);   # l
    var nul_str = str_new(nul_buf, 9);
    assert_eq(sanitize_host_for_header(nul_str), 0, "L3: NUL byte rejected");

    # =====================================================================
    # 1.6.3 closeout audit (docs/audit/2026-05-11-audit.md)
    # =====================================================================

    test_group("closeout-medium1-fork-exec-sigmask-reset");

    # MEDIUM-1: fork_exec_service child path must reset the inherited
    # PID-1 signal mask before execve. The fix extracts the reset
    # into `reset_child_signal_mask()`; the unit test below verifies
    # the function clears the mask we artificially set in the parent.
    # (End-to-end coverage is in the qemu harness — argonaut isn't
    # PID 1 under `cyrius test`, so we can't reproduce the supervisor
    # loop's sigprocmask blocking.)
    var probe_set = sigset_new();
    sigset_add(probe_set, SIGTERM);
    sigset_add(probe_set, SIGINT);
    sys_sigprocmask(SIG_BLOCK, probe_set, 0);
    # Confirm we ARE now blocking SIGTERM via a read-back.
    var current_set = sigset_new();
    sys_sigprocmask(SIG_BLOCK, 0, current_set);
    assert_eq(sigset_has(current_set, SIGTERM), 1, "M1: pre-state — SIGTERM blocked");
    # Call the helper.
    reset_child_signal_mask();
    var post_set = sigset_new();
    sys_sigprocmask(SIG_BLOCK, 0, post_set);
    assert_eq(sigset_has(post_set, SIGTERM), 0, "M1: SIGTERM unblocked after reset");
    assert_eq(sigset_has(post_set, SIGINT),  0, "M1: SIGINT unblocked after reset");

    # =====================================================================
    # 2026-08-24 P(-1) audit findings (1.8.6)
    # =====================================================================

    test_group("audit-2026-08-24-medium1-notify-fields-key");

    # MEDIUM-1: notify_parse stored its `fields` map keys as a RAW POINTER
    # into the shared receive buffer via `map_set(fields, str_data(key), val)`.
    # The map is cstr-keyed, so hashing walks to the next NUL byte — but a
    # datagram delivered by sys_read() is NOT NUL-terminated, so the walk ran
    # past the intended key, through the rest of the datagram, and off the end
    # of the allocation. Measured before the fix: a "READY" key hashed with
    # strlen 65 against a 64-byte buffer, and the fields map was entirely
    # unusable (map_get for every real key returned 0).
    #
    # Two properties are asserted here:
    #   1. the map resolves the keys it claims to store, and
    #   2. the stored key length equals the key, not the rest of the datagram
    #      — which is what proves the read is bounded.
    var nf_payload = "READY=1\nSTATUS=running";
    var nf_len = strlen(nf_payload);
    var nf_buf = alloc(64);
    memcpy(nf_buf, nf_payload, nf_len);
    # Fill the tail with non-NUL bytes so an unbounded cstr walk would run on.
    for (var nfi = nf_len; nfi < 64; nfi = nfi + 1) { store8(nf_buf + nfi, 65); }

    var nf_msg = notify_parse(nf_buf, nf_len);
    assert_eq(load64(nf_msg), 1, "notify: READY=1 still parses");
    var nf_fields = load64(nf_msg + 48);
    assert_eq(map_count(nf_fields), 2, "notify: two fields recorded");

    var nf_ready = map_get(nf_fields, str_from("READY"));
    assert(nf_ready != 0, "notify: fields map resolves READY");
    assert(str_eq(nf_ready, str_from("1")), "notify: READY value is 1");
    var nf_status = map_get(nf_fields, str_from("STATUS"));
    assert(nf_status != 0, "notify: fields map resolves STATUS");
    assert(str_eq(nf_status, str_from("running")), "notify: STATUS value is running");

    var nf_keys = map_keys(nf_fields);
    assert_eq(vec_len(nf_keys), 2, "notify: two keys");
    var nf_k0 = vec_get(nf_keys, 0);
    assert_eq(str_len(nf_k0), 5, "notify: first key is 5 bytes (READY), not the whole datagram");

    # The parsed values must not alias the caller's buffer — overwrite it and
    # re-read. Before the fix these Strs pointed straight into nf_buf.
    for (var nfj = 0; nfj < 64; nfj = nfj + 1) { store8(nf_buf + nfj, 90); }
    assert(str_eq(nf_status, str_from("running")),
      "notify: STATUS survives caller-buffer reuse (no aliasing)");

    test_group("audit-2026-08-24-high1-health-null-result");

    # HIGH-1: execute_health_check returned a bare 0 — a NULL pointer — when
    # an HC_HTTP_GET target did not begin with "http://", while every other
    # path returns a HealthCheckResult struct. Both callers dereference the
    # result immediately (`load64(result + 16)` at src/health.cyr:468 and
    # src/init.cyr:676), so a service configured with an https:// URL, an
    # uppercase HTTP:// URL, or a bare host:port made argonaut read address
    # 0x10 during the health pass. Under PID 1 that is
    # "kernel panic - not syncing: Attempted to kill init".
    #
    # An unsupported scheme is a health check that FAILS, not one that
    # returns nothing.
    var hn_cases = vec_new();
    vec_push(hn_cases, str_from("https://svc.local/healthz"));
    vec_push(hn_cases, str_from("HTTP://svc.local/healthz"));
    vec_push(hn_cases, str_from("svc.local:8080/healthz"));
    vec_push(hn_cases, str_from(""));
    vec_push(hn_cases, str_from("http:/svc.local"));

    for (var hni = 0; hni < vec_len(hn_cases); hni = hni + 1) {
        var hn_hc = alloc(sizeof(HealthCheck));
        store64(hn_hc,      HC_HTTP_GET);
        store64(hn_hc + 8,  vec_get(hn_cases, hni));
        store64(hn_hc + 16, 0);
        store64(hn_hc + 24, 0);
        store64(hn_hc + 32, 100);
        store64(hn_hc + 40, 0);
        var hn_r = execute_health_check(str_from("svc"), hn_hc, 0);
        assert(hn_r != 0, "health: unsupported scheme returns a result, never NULL");
        assert_eq(load64(hn_r + 16), 0, "health: unsupported scheme is a FAILED check");
        var hn_msg = load64(hn_r + 32);
        assert(hn_msg != 0, "health: unsupported scheme carries a message");
    }

    test_group("audit-2026-08-24-medium4-tmpfiles-devtype-aliasing");

    # MEDIUM-4: generate_tmpfile_commands built the mknod device-type
    # argument from `var type_buf[2]`. A function-local fixed-size var in
    # Cyrius is STATIC storage, not stack, and `str_from(&type_buf)` BORROWS
    # that pointer rather than copying — so every device entry in one call
    # handed back a Str aliasing the same two bytes. With two or more device
    # nodes the last entry's type character won for all of them.
    #
    # Concretely: a config creating a CHARACTER device followed by a BLOCK
    # device produced `mknod <path> b ...` for both — argonaut creates the
    # character device with the wrong node type at boot.
    var td_entries = vec_new();

    var td_c = alloc(72);
    store64(td_c,      TMP_DEVICE);
    store64(td_c + 8,  str_from("/dev/testchar"));
    store64(td_c + 24, 384);
    store64(td_c + 32, 0);
    store64(td_c + 40, 0);
    store64(td_c + 48, 99);        # 'c'
    store64(td_c + 56, 1);
    store64(td_c + 64, 3);
    vec_push(td_entries, td_c);

    var td_b = alloc(72);
    store64(td_b,      TMP_DEVICE);
    store64(td_b + 8,  str_from("/dev/testblock"));
    store64(td_b + 24, 384);
    store64(td_b + 32, 0);
    store64(td_b + 40, 0);
    store64(td_b + 48, 98);        # 'b'
    store64(td_b + 56, 7);
    store64(td_b + 64, 0);
    vec_push(td_entries, td_b);

    var td_cmds = generate_tmpfile_commands(td_entries);
    # Each device entry emits mknod + chmod, so the two mknods are at 0 and 2.
    var td_mknod_c = vec_get(td_cmds, 0);
    var td_mknod_b = vec_get(td_cmds, 2);
    var td_type_c = vec_get(safe_cmd_args(td_mknod_c), 1);
    var td_type_b = vec_get(safe_cmd_args(td_mknod_b), 1);

    assert(str_eq(td_type_c, str_from("c")),
      "tmpfiles: char device keeps type 'c' after a later block device");
    assert(str_eq(td_type_b, str_from("b")),
      "tmpfiles: block device has type 'b'");
    assert(str_eq(td_type_c, td_type_b) == 0,
      "tmpfiles: the two device-type args are not the same aliased buffer");

    test_group("audit-2026-08-24-medium5-health-null-target");

    # MEDIUM-5: every check type except HC_PROCESS_ALIVE dereferences the
    # HealthCheck's `target` Str — resolve_host_ipv4(target) for TCP,
    # check_command(target, ...) for COMMAND, str_data(target) for HTTP.
    # A HealthCheck built with target = 0 (the natural mistake when copying
    # the HC_PROCESS_ALIVE idiom, which legitimately has no target) read
    # address 0x8 during the health pass — another way to panic PID 1.
    var hnt_types = vec_new();
    vec_push(hnt_types, HC_TCP_CONNECT);
    vec_push(hnt_types, HC_COMMAND);
    vec_push(hnt_types, HC_HTTP_GET);

    for (var hti = 0; hti < vec_len(hnt_types); hti = hti + 1) {
        var ht_hc = alloc(sizeof(HealthCheck));
        store64(ht_hc,      vec_get(hnt_types, hti));
        store64(ht_hc + 8,  0);          # NULL target
        store64(ht_hc + 16, 80);
        store64(ht_hc + 24, 0);
        store64(ht_hc + 32, 100);
        store64(ht_hc + 40, 0);
        var ht_r = execute_health_check(str_from("svc"), ht_hc, 0);
        assert(ht_r != 0, "health: NULL target returns a result, never NULL");
        assert_eq(load64(ht_r + 16), 0, "health: NULL target is a FAILED check");
    }

    # HC_PROCESS_ALIVE legitimately has no target and must still work.
    var ht_pa = alloc(sizeof(HealthCheck));
    store64(ht_pa,      HC_PROCESS_ALIVE);
    store64(ht_pa + 8,  0);
    store64(ht_pa + 16, 0);
    store64(ht_pa + 24, 0);
    store64(ht_pa + 32, 100);
    store64(ht_pa + 40, 0);
    var ht_rpa = execute_health_check(str_from("self"), ht_pa, sys_getpid());
    assert(ht_rpa != 0, "health: PROCESS_ALIVE with no target still returns a result");
    assert_eq(load64(ht_rpa + 16), 1, "health: PROCESS_ALIVE on self still passes");

    test_group("audit-2026-08-24-high2-pid1-idle-arena-growth");

    # HIGH-2: the PID-1 supervisor loop in src/main.cyr calls
    # init_reap_services() every 100 ms, forever. Each call allocated from
    # the BUMP arena unconditionally — map_keys() inside proc_table_reap,
    # plus two vec_new()s — and bump memory is never individually freed.
    # Measured before the fix: 456 bytes per idle tick = ~375 MB/day,
    # ~11 GB/month. PID 1 cannot be restarted, so the arena grows until
    # allocation fails and the kernel panics on init's death.
    #
    # The idle path — nothing exited, which is the overwhelmingly common
    # case — must now allocate NOTHING. This asserts that directly rather
    # than asserting a threshold, because any per-tick allocation at all is
    # unbounded over the life of PID 1.
    var pl_init = argonaut_init_new(argonaut_config_default());
    # Warm-up: let first-call lazy singletons settle before sampling.
    for (var plw = 0; plw < 10; plw = plw + 1) { init_reap_services(pl_init); }

    var pl_before = _heap_ptr;
    for (var pli = 0; pli < 500; pli = pli + 1) { init_reap_services(pl_init); }
    var pl_growth = _heap_ptr - pl_before;
    assert_eq(pl_growth, 0, "pid1: 500 idle reap ticks allocate zero bump memory");

    # The contract still holds: callers get a vec they can measure.
    var pl_res = init_reap_services(pl_init);
    assert(pl_res != 0, "pid1: reap still returns a vec");
    assert_eq(vec_len(pl_res), 0, "pid1: idle reap reports no exits");

    test_group("audit-2026-08-24-medium7-systemd-unit-injection");

    # MEDIUM-7: generate_unit sanitized the Description but added
    # dependency names to After= / Requires= RAW, and generate_unit_filename
    # used the service name raw. A dependency carrying a newline injected
    # arbitrary directives into the [Unit] section of a unit file that
    # systemd then executes as root; a service name carrying '/' or '..'
    # escaped the unit directory.
    var ui_svc = svc_def_new(str_from("victim"),
      str_from("desc"), str_from("/usr/bin/true"));
    var ui_deps = svc_def_deps(ui_svc);
    vec_push(ui_deps, str_from("net\n[Service]\nExecStart=/bin/sh -c evil"));
    var ui_unit = generate_unit(ui_svc);

    # The property that matters is that the injected text cannot become its
    # OWN directive line. sanitize_unit_value folds the newline to a space,
    # so the bytes survive as inert text on the After= line — but never at
    # the start of a line, which is the only place systemd reads a directive.
    assert(str_contains(ui_unit, str_from("\nExecStart=/bin/sh -c evil")) == 0,
      "systemd: injected ExecStart never begins a line");
    # Positive form: the payload survives FOLDED onto the After= line, which
    # is what proves the newline was neutralised rather than dropped. (The
    # unit legitimately contains a real "[Service]" section of its own, so
    # simply searching for that string proves nothing.)
    assert(str_contains(ui_unit, str_from("After=net [Service] ExecStart=/bin/sh -c evil.service")),
      "systemd: dependency newline is folded to a space, staying on After=");

    # Unit filename must stay a single path component.
    var uf_svc = svc_def_new(str_from("../../etc/systemd/system/evil"),
      str_from("desc"), str_from("/usr/bin/true"));
    var uf_name = generate_unit_filename(uf_svc);
    # A traversal needs a path SEPARATOR. With '/' gone the result is one
    # path component, and a leading '.' is rewritten so the name can never
    # be "." or ".." themselves; ".." embedded in a longer component is
    # inert.
    assert(str_contains(uf_name, str_from("/")) == 0,
      "systemd: unit filename contains no path separator");
    assert(str_eq(uf_name, str_from("...service")) == 0,
      "systemd: unit filename is not a bare dot-name");
    var uf_dd = svc_def_new(str_from(".."), str_from("d"), str_from("/usr/bin/true"));
    assert(str_eq(generate_unit_filename(uf_dd), str_from("_..service")),
      "systemd: a bare '..' name is rewritten, not preserved");

    # A well-formed name is left alone.
    var ok_svc = svc_def_new(str_from("postgres"),
      str_from("desc"), str_from("/usr/bin/true"));
    assert(str_eq(generate_unit_filename(ok_svc), str_from("postgres.service")),
      "systemd: ordinary service name is unchanged");

    test_group("audit-2026-08-24-medium6-forking-pidfile-owner");

    # MEDIUM-6 (CVE-2018-16888 class): a forking service's PID file is read
    # to learn the daemon's real PID, which argonaut then tracks and later
    # signals. `read_pid_file_safe` already implements the ownership and
    # writability checks — added for the M4 work — but the one production
    # call site (src/init.cyr:415) went through `read_pid_file`, which
    # passes -1 to SKIP the ownership check. A service whose PID file lives
    # in an attacker-writable directory could therefore hand argonaut an
    # arbitrary PID to adopt and later kill.
    #
    # systemd's fix for the same bug is "trust a PID file only when it is
    # root-owned". argonaut generalises that to "owned by the uid argonaut
    # itself runs as" — uid 0 under PID 1, and whatever the developer is
    # under a test sweep, which is why this test asks the kernel rather
    # than hardcoding 0.
    var pf_ok = str_from("/tmp/argonaut_pf_ok.pid");
    var pf_bad = str_from("/tmp/argonaut_pf_bad.pid");
    syscall(87, str_data(pf_ok));
    syscall(87, str_data(pf_bad));

    var pf_self = sys_getpid();
    var pf_sb = str_builder_new();
    str_builder_add_int(pf_sb, pf_self);
    var pf_txt = str_builder_build(pf_sb);

    # A 0600 own-uid file naming a live pid is accepted.
    var pf_fd = sys_open(str_data(pf_ok), 65, 384);   # O_WRONLY|O_CREAT, 0600
    sys_write(pf_fd, str_data(pf_txt), str_len(pf_txt));
    sys_close(pf_fd);
    assert_eq(read_pid_file_safe(pf_ok, sys_getuid()), pf_self,
      "pidfile: own-uid 0600 pid file is accepted");

    # The same content, but group/other-writable, must be rejected.
    var pf_fd2 = sys_open(str_data(pf_bad), 65, 438);  # 0666
    sys_write(pf_fd2, str_data(pf_txt), str_len(pf_txt));
    sys_close(pf_fd2);
    syscall(90, str_data(pf_bad), 438);                # chmod 0666
    assert_eq(read_pid_file_safe(pf_bad, sys_getuid()), 0 - 1,
      "pidfile: world-writable pid file is rejected");

    # And the production wrapper must apply the check, not skip it.
    assert_eq(read_pid_file(pf_bad), 0 - 1,
      "pidfile: the production reader rejects a world-writable pid file");

    syscall(87, str_data(pf_ok));
    syscall(87, str_data(pf_bad));

    test_group("audit-2026-08-24-medium2-merkle-proof-binding");

    # MEDIUM-2: audit_log_verify_inclusion / audit_log_verify_consistency
    # verified a proof against the root carried INSIDE that same proof, so a
    # proof built over a completely different chain verified as valid. libro
    # documents this as self-referential and ships root-binding variants.
    # The wrappers now take the expected root (and, for inclusion, the entry
    # hash) so the proof is tied to a chain the caller actually trusts.
    var mb_a = chain_new();
    chain_append(mb_a, SEV_INFO, str_from("argonaut"), str_from("Starting"), str_from("alpha"));
    chain_append(mb_a, SEV_INFO, str_from("argonaut"), str_from("Started"), str_from("alpha"));
    chain_append(mb_a, SEV_INFO, str_from("argonaut"), str_from("Starting"), str_from("beta"));
    chain_append(mb_a, SEV_INFO, str_from("argonaut"), str_from("Started"), str_from("beta"));

    var mb_b = chain_new();
    chain_append(mb_b, SEV_WARNING, str_from("attacker"), str_from("Forged"), str_from("gamma"));
    chain_append(mb_b, SEV_WARNING, str_from("attacker"), str_from("Forged"), str_from("delta"));

    var mb_root_a = audit_log_merkle_root(mb_a);
    var mb_root_b = audit_log_merkle_root(mb_b);
    assert(mb_root_a != 0, "merkle: chain A root non-null");
    assert(mb_root_b != 0, "merkle: chain B root non-null");
    assert(str_eq(mb_root_a, mb_root_b) == 0, "merkle: the two chains have different roots");

    var mb_entries_a = chain_entries(mb_a);
    var mb_e0 = vec_get(mb_entries_a, 0);
    var mb_p0 = audit_log_inclusion_proof(mb_a, 0);
    assert(mb_p0 != 0, "merkle: chain A inclusion proof built");
    assert_eq(audit_log_verify_inclusion(mb_p0, mb_root_a, entry_hash(mb_e0)), 1,
      "merkle: proof verifies against its OWN chain root");
    assert_eq(audit_log_verify_inclusion(mb_p0, mb_root_b, entry_hash(mb_e0)), 0,
      "merkle: proof is REJECTED against a foreign chain root");

    var mb_e1 = vec_get(mb_entries_a, 1);
    assert_eq(audit_log_verify_inclusion(mb_p0, mb_root_a, entry_hash(mb_e1)), 0,
      "merkle: proof is REJECTED for an entry it does not cover");

    var mb_cp = audit_log_consistency_proof(mb_a, 2);
    assert(mb_cp != 0, "merkle: consistency proof built");
    assert_eq(audit_log_verify_consistency(mb_cp, mb_root_a), 1,
      "merkle: consistency verifies against the real new root");
    assert_eq(audit_log_verify_consistency(mb_cp, mb_root_b), 0,
      "merkle: consistency REJECTED against a foreign new root");

    test_group("audit-2026-08-24-medium3-emergency-auth-fail-closed");

    # MEDIUM-3: verify_emergency_auth returned 1 (GRANT) when require_auth was
    # set but no password hash was configured — a fail-OPEN on misconfiguration
    # that handed out an emergency root shell with no credential. It now denies.
    # EmergencyShellConfig layout: +24 require_auth, +32 auth_password_hash.
    var ea = emergency_shell_default();
    store64(ea + 24, 1);   # require_auth = true
    store64(ea + 32, 0);   # ...but no hash configured
    assert_eq(verify_emergency_auth(ea, str_from("")), 0,
      "emergency: require_auth with NO hash configured is DENIED");
    assert_eq(verify_emergency_auth(ea, str_from("anything")), 0,
      "emergency: require_auth with no hash denies any password");

    store64(ea + 32, password_hash("hunter2", 7));
    assert_eq(verify_emergency_auth(ea, str_from("hunter2")), 1,
      "emergency: correct password still accepted");
    assert_eq(verify_emergency_auth(ea, str_from("hunter3")), 0,
      "emergency: wrong password rejected");

    store64(ea + 24, 0);   # require_auth = false
    assert_eq(verify_emergency_auth(ea, str_from("")), 1,
      "emergency: auth not required stays open");

    test_group("libro-2.8.7-persist-oversize-field");

    # 1.8.5 dep-bump regression. libro 2.8.7 made `patrastore_append`
    # REJECT any of its ten fields over 255 bytes with PATRA_ERR_ROWSZ
    # (`_ps_field_too_long`), where it previously truncated silently.
    # argonaut's only caller-controlled field is `details`, which is
    # `str_from(service)` — so an over-long service name is now a new
    # error path into the MEDIUM-2 disk-fail contract.
    #
    # This pins the contract rather than the libro internals: the
    # persistent record must report failure (return 0) instead of
    # writing a truncated row, and the in-memory chain — which
    # `chain_append` has already extended by then — must keep growing
    # so the divergence is observable rather than silent.
    var os_path = str_from("/tmp/argonaut_libro287_oversize.patra");
    syscall(87, str_data(os_path));
    var os_pal = audit_log_open_persistent(os_path);
    assert(os_pal != 0, "oversize: open succeeded for setup");

    var os_ok = audit_log_record_persistent(os_pal, "svc-short", EVT_STARTING);
    assert(os_ok != 0, "oversize: a short service name still persists");

    # A 260-byte service name — over the 255-byte field cap. Built with
    # str_builder and converted via str_cstr, because
    # `audit_log_record_persistent` takes `service` as a NUL-terminated
    # cstr and wraps it in `str_from` itself.
    var os_sb = str_builder_new();
    var os_i = 0;
    while (os_i < 26) {
        str_builder_add_cstr(os_sb, "0123456789");
        os_i = os_i + 1;
    }
    var os_long = str_builder_build(os_sb);
    assert_eq(str_len(os_long), 260, "oversize: built a 260-byte name");
    var os_long_c = str_cstr(os_long);

    var os_chain = load64(os_pal);
    var os_before = chain_len(os_chain);
    var os_res = audit_log_record_persistent(os_pal, os_long_c, EVT_STARTED);
    assert_eq(os_res, 0, "oversize: over-cap details reports failure");
    assert_eq(chain_len(os_chain), os_before + 1,
      "oversize: in-memory chain still advanced (divergence observable)");

    audit_log_close_persistent(os_pal);
    syscall(87, str_data(os_path));

    test_group("closeout-medium2-fork-exec-envp-path");

    # MEDIUM-2: fork_exec_service must pass a usable PATH in envp,
    # not an empty environment. The fix extracts the envp build into
    # `build_default_envp()`; the unit test below verifies the
    # produced vec starts with a "PATH=" entry.
    var envp = build_default_envp();
    assert(envp != 0, "M2: envp non-null");
    assert(vec_len(envp) >= 1, "M2: envp has at least one entry");
    var first_env = vec_get(envp, 0);
    var first_env_str = str_new(first_env, 5);
    assert(str_eq(first_env_str, str_from("PATH=")), "M2: first envp entry starts with PATH=");

    return assert_summary();
}

var r = main();
syscall(SYS_EXIT, r);
