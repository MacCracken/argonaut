# edge_exec.tcyr — Edge boot execution tests
include "tests/test_header.cyr"

fn main() {
    alloc_init();
    test_group("edge-exec");

    # --- configure_readonly_rootfs ---
    var cmds = configure_readonly_rootfs();
    assert(vec_len(cmds) > 0, "rootfs cmds");
    # First command should be mount
    var c0 = vec_get(cmds, 0);
    assert(streq(str_data(safe_cmd_binary(c0)), "mount"), "rootfs mount");

    # --- verify_rootfs_integrity ---
    var hash = str_from("abcdef1234567890abcdef1234567890abcdef1234567890abcdef1234567890");
    var vcmds = verify_rootfs_integrity(str_from("/dev/sda1"), str_from("/dev/sda2"), hash);
    assert(vec_len(vcmds) > 0, "verity cmds");
    var vc0 = vec_get(vcmds, 0);
    assert(streq(str_data(safe_cmd_binary(vc0)), "veritysetup"), "verity bin");

    # --- unlock_luks ---
    var lcmds = unlock_luks(str_from("/dev/sda3"), str_from("crypt-root"));
    assert(vec_len(lcmds) > 0, "luks cmds");
    var lc0 = vec_get(lcmds, 0);
    assert(streq(str_data(safe_cmd_binary(lc0)), "cryptsetup"), "luks bin");

    # --- close_luks ---
    var clcmds = close_luks(str_from("crypt-root"));
    assert(vec_len(clcmds) > 0, "close cmds");
    var cl0 = vec_get(clcmds, 0);
    assert(streq(str_data(safe_cmd_binary(cl0)), "cryptsetup"), "close bin");
    # Verify 'close' is in the args
    var cl_args = safe_cmd_args(cl0);
    assert(vec_len(cl_args) >= 2, "close args");

    # --- validate_device_path ---
    assert(validate_device_path(str_from("/dev/sda1")), "dev ok");
    assert(validate_device_path(str_from("/dev/mapper/crypt-root")), "dev map");
    assert_eq(validate_device_path(str_from("/etc/shadow")), 0, "dev bad");
    assert_eq(validate_device_path(str_from("/dev/../etc/shadow")), 0, "dev trav");

    # --- execute_edge_boot: all disabled ---
    var ecfg = alloc(sizeof(EdgeBootConfig));
    store64(ecfg, 0);      # readonly_rootfs off
    store64(ecfg + 8, 0);  # luks off
    store64(ecfg + 16, 0); # tpm off
    store64(ecfg + 24, 5000);
    store64(ecfg + 32, str_from(""));
    var result = execute_edge_boot(ecfg, str_from(""), str_from(""), str_from(""), str_from(""));
    # When readonly=0, rootfs_locked=1 (skip = success)
    assert_eq(load64(result), 1, "eb rootfs skip");
    # No verity inputs = skip
    assert_eq(load64(result + 8), 0, "eb no verity");
    # luks off + no device = luks_unlocked=1 (skip = success)
    assert_eq(load64(result + 16), 1, "eb luks skip");
    assert(load64(result + 24) >= 0, "eb time");

    # --- validate_edge_profile: within budget ---
    var br = alloc(48);
    store64(br, 1);       # rootfs_locked
    store64(br + 8, 1);   # verity
    store64(br + 16, 1);  # luks
    store64(br + 24, 500); # boot_time 500ms
    store64(br + 32, 1);  # within_budget
    store64(br + 40, vec_new());
    var vr = validate_edge_profile(br, 999999);
    # Returns vec of violations — 0 = ok
    assert_eq(vec_len(vr), 0, "vep ok");

    # --- validate_edge_profile: over budget ---
    store64(br + 32, 0);  # within_budget = false
    var vr2 = validate_edge_profile(br, 999999);
    assert(vec_len(vr2) > 0, "vep over");

    test_group("safe-cmd-binary-resolution");

    # 1.13.2. Every SafeCommand above is built with a BARE binary name
    # ("mount", "veritysetup", "cryptsetup"), and run_safe_cmd ultimately
    # reaches the stdlib's exec_vec_str, which calls sys_execve directly.
    # execve(2) does NOT search $PATH — a name with no slash is resolved
    # against the CWD — so every one of these commands used to fail ENOENT
    # and the child died on exec_vec_str's sys_exit(127). The whole
    # edge-boot execution path could never succeed; it went unnoticed only
    # because no consumer imported this module.
    var t = safe_cmd_new(str_from("true"));
    assert_eq(run_safe_cmd(t), 0, "resolve: bare 'true' resolves and runs");

    var f = safe_cmd_new(str_from("false"));
    assert_eq(run_safe_cmd(f), 1, "resolve: bare 'false' runs, exit code preserved");

    var a = safe_cmd_new(str_from("/bin/true"));
    assert_eq(run_safe_cmd(a), 0, "resolve: explicit path still runs");

    # A missing binary must be a clean 127, not a hang and not a false 0.
    var n = safe_cmd_new(str_from("arg-no-such-binary-xyz"));
    assert_eq(run_safe_cmd(n), 127, "resolve: missing binary -> 127");

    # Resolver unit behaviour.
    assert_eq(_resolve_safe_binary(str_from("arg-no-such-binary-xyz")), 0,
      "resolve: returns 0 when nothing matches");
    assert(str_eq(_resolve_safe_binary(str_from("/bin/true")), str_from("/bin/true")) == 1,
      "resolve: explicit path passes through unchanged");
    var rt = _resolve_safe_binary(str_from("true"));
    assert(rt != 0, "resolve: bare name resolves to something");
    assert(str_starts_with(rt, "/") == 1, "resolve: result is absolute");

    # A sequence stops on the first failure and reports its code.
    var seq = vec_new();
    vec_push(seq, safe_cmd_new(str_from("true")));
    vec_push(seq, safe_cmd_new(str_from("arg-no-such-binary-xyz")));
    vec_push(seq, safe_cmd_new(str_from("true")));
    assert_eq(run_safe_cmd_sequence(seq), 127, "resolve: sequence stops on missing binary");

    test_group("safe-cmd-bounded-exec");

    # 1.13.2. run_safe_cmd no longer delegates to the stdlib's exec_vec_str,
    # which waits unbounded AND fails open (it discards waitpid's return and
    # reads a STATIC status buffer, so a failed wait reports the previous
    # command's exit code — or 0, i.e. SUCCESS, on the first call).

    # A command that outruns its bound must be KILLED and reported as
    # failure, not waited on forever. `sleep 5` against a 300 ms bound.
    var slow = safe_cmd_new(str_from("sleep"));
    safe_cmd_add_arg(slow, str_from("5"));
    var t0 = monotonic_ms();
    var rc = run_safe_cmd_timeout(slow, 300);
    var elapsed = monotonic_ms() - t0;
    assert_eq(rc, 0 - 1, "timeout: over-budget command reports failure");
    assert(elapsed < 3000, "timeout: returned well before the child would exit");

    # And the bound does not penalise a command that finishes inside it.
    var quick = safe_cmd_new(str_from("true"));
    assert_eq(run_safe_cmd_timeout(quick, 10000), 0, "timeout: fast command still returns 0");

    # Exit codes survive the new wait path, including non-zero ones. This is
    # the fail-open regression test: under exec_vec_str a wait that did not
    # land reported the STATIC buffer's contents rather than this exit code.
    var f2 = safe_cmd_new(str_from("false"));
    assert_eq(run_safe_cmd_timeout(f2, 10000), 1, "timeout: exit 1 preserved");
    var t2 = safe_cmd_new(str_from("true"));
    assert_eq(run_safe_cmd_timeout(t2, 10000), 0, "timeout: exit 0 after a failure, not sticky");

    return assert_summary();
}
var r = main();
syscall(SYS_EXIT, r);
