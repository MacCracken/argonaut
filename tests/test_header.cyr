# test_header.cyr — shared includes and helpers for .tcyr test files
# lib/ is filled by `cyrius deps` from cyrius.cyml (gitignored).

# Core stdlib
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/syscalls.cyr"
include "lib/io.cyr"
include "lib/fs.cyr"
include "lib/process.cyr"
include "lib/hashmap.cyr"
include "lib/tagged.cyr"
include "lib/args.cyr"
include "lib/assert.cyr"
include "lib/bayan.cyr"
include "lib/fnptr.cyr"

# Libro dependencies (audit.cyr, which init.cyr requires, sits on libro)
include "lib/freelist.cyr"
include "lib/chrono.cyr"
include "lib/thread_local.cyr"

# Sakshi stubs for tests. They override the manifest-resolved sakshi (last
# definition wins), so each test build prints eight expected `duplicate fn
# 'sakshi_*'` warnings.
fn sakshi_info(msg, len) { return 0; }
fn sakshi_warn(msg, len) { return 0; }
fn sakshi_error(msg, len) { return 0; }
fn sakshi_debug(msg, len) { return 0; }
fn sakshi_trace(msg, len) { return 0; }
fn sakshi_span_enter(name, len) { return 0; }
fn sakshi_span_exit() { return 0; }
fn sakshi_span_depth() { return 0; }

# Libro (the whole dist bundle).
#
# Do NOT add `include "lib/sigil.cyr"` here or in any .tcyr/.bcyr. sigil comes
# only as the thin sub-bundles `[deps.sigil]` declares (sha256 / sha_ni / mldsa /
# hex / argon2). The monolith pulls the full x509 + RSA surface, collides with the
# thin bundles (hundreds of `duplicate fn ... last definition wins`), and makes the
# bench-gate binary stop describing the production binary.
include "lib/libro.cyr"

# Argonaut modules (audit before init — init depends on audit;
# resolver before health — health.cyr consumes resolve_host_ipv4)
include "src/syscall_compat.cyr"
include "src/types.cyr"
include "src/boot.cyr"
include "src/services.cyr"
include "src/process_mgmt.cyr"
include "src/resolver.cyr"
include "src/health.cyr"
include "src/edge_boot.cyr"
include "src/notify.cyr"
include "src/security.cyr"
include "src/systemd.cyr"
include "src/tmpfiles.cyr"
include "src/audit.cyr"
include "src/audit_ext.cyr"
include "src/init.cyr"

# =========================================================================
# Shared test helpers
# =========================================================================

fn minimal_init() {
    var cfg = argonaut_config_default();
    store64(cfg, BOOT_MINIMAL);
    return argonaut_init_new(cfg);
}

fn server_init() {
    var cfg = argonaut_config_default();
    store64(cfg, BOOT_SERVER);
    return argonaut_init_new(cfg);
}

fn desktop_init() {
    var cfg = argonaut_config_default();
    store64(cfg, BOOT_DESKTOP);
    return argonaut_init_new(cfg);
}

fn edge_init_fn() {
    var cfg = argonaut_config_default();
    store64(cfg, BOOT_EDGE);
    return argonaut_init_new(cfg);
}

fn steps_has_stage(steps, stage) {
    for (var i = 0; i < vec_len(steps); i = i + 1) {
        if (load64(vec_get(steps, i)) == stage) { return 1; }
    }
    return 0;
}

fn svcs_has_name(svcs, name) {
    for (var i = 0; i < vec_len(svcs); i = i + 1) {
        if (str_eq_cstr(svc_def_name(vec_get(svcs, i)), name)) { return 1; }
    }
    return 0;
}

fn order_pos(order, name) {
    for (var i = 0; i < vec_len(order); i = i + 1) {
        if (str_eq_cstr(vec_get(order, i), name)) { return i; }
    }
    return 0 - 1;
}

fn vec_contains_str(v, s) {
    for (var i = 0; i < vec_len(v); i = i + 1) {
        if (str_eq(vec_get(v, i), s)) { return 1; }
    }
    return 0;
}

fn dummy_svc(name, deps) {
    var sd = svc_def_new(name, str_cat(str_from("test "), name), str_cat(str_from("/usr/bin/"), name));
    store64(sd + 56, RESTART_NEVER);
    vec_push(svc_def_modes(sd), BOOT_MINIMAL);
    if (deps != 0) {
        for (var i = 0; i < vec_len(deps); i = i + 1) {
            vec_push(svc_def_deps(sd), vec_get(deps, i));
        }
    }
    return sd;
}
