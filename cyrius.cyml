[package]
name = "argonaut"
version = "${file:VERSION}"
description = "Init system and service manager for AGNOS"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/argonaut"
language = "cyrius"
cyrius = "6.5.35"

[build]
entry = "src/main.cyr"
output = "build/argonaut"

# `sigil` is NOT listed in `deps.stdlib` and has no git block here — it
# resolves transitively via libro's own `deps.sigil` block, which selects
# the THIN sub-bundles (dist/sigil-mldsa.cyr + src/sha_ni.cyr + src/sha256.cyr
# + src/hex.cyr) rather than the monolithic `dist/sigil.cyr`. Naming "sigil"
# in the array below would pull the FOLD, i.e. the monolith: 27,671 lines /
# 1,084,265 bytes of source at 6.5.35, against 5,698 / 226,926 for the four
# thin bundles argonaut actually links. sigil 3.12.9 de-banked the RSA /
# bignum globals, so the monolith's static footprint is well under the ~13 MB
# it used to carry (upstream measures 785,408 B) — but it is still the whole
# x509 + RSA + authenticode surface, none of which is reachable from the audit
# chain. Keep it out, and never hand-include it in a .tcyr/.bcyr either.
#
# `sakshi` and `patra` used to be explicit git dep blocks here. Both were
# RETIRED at 1.8.5. They are NOT newly folded — `lib/sakshi.cyr` and
# `lib/patra.cyr` have shipped in the cyrius stdlib snapshot since at least
# 6.0.1. That is exactly why the blocks were harmful: `cyrius deps` overlays
# a git dep's resolution on top of the fold snapshot on *every build*, so a
# pin that lags the fold silently DOWNGRADES the file, and `deps --verify`
# cannot catch it (the lock is written from disk, recording the downgraded
# hash). Measured under the old 6.4.62 pin: patra 1.12.9 over a 1.12.10 fold
# — reverting the `''` SQL-escaping fix argonaut itself filed — and sakshi
# 2.4.2 over a 2.4.6 fold. Both upstream manifests removed the identical
# block for the same reason (patra at 1.13.0, sigil at 3.12.7).
# Verified byte-identical after the fix: 6.5.35's lib/patra.cyr == patra
# 1.13.10 dist, lib/sakshi.cyr == sakshi 2.4.11 dist.
#
# NOTE — never write a bracketed deps-section header inside a comment in this
# file; backtick it as `deps.NAME`. `cyrius distlib` scans for that opening
# bracket sequence unanchored and matches it in comment prose, dropping NAME
# from the sidecar. Separately, the word "stdlib" in prose above the section
# tripped a raw-byte key scan before cyrius 6.5.17.
[deps]
stdlib = [
    "string",
    "fmt",
    "alloc",
    "vec",
    "str",
    "slice",
    "syscalls",
    "io",
    "fs",
    "process",
    "hashmap",
    "tagged",
    "args",
    "bayan",
    "fnptr",
    "freelist",
    "chrono",
    "ct",
    "keccak",
    "thread",
    "thread_local",
    "random",
    "assert",
    "bench",
    "sakshi",
    "patra",
]

# UPSTREAM-1 RETIRED (1.8.1) — the `ct_eq` shim is gone. libro migrated
# to `ct_eq_bytes_lens` directly, and that symbol now lives in the stdlib
# `ct` module (not sigil's mutable dist), so the tag-mutation churn the
# shim insulated against can no longer occur. sigil (3.12.x) no longer
# ships its own `ct_eq`; nothing calls the bare symbol.
#
# `bayan` (6.2.x) replaces the standalone `json` + `bigint` modules it
# consolidates; `thread_local` is force-included in src/main.cyr ahead of
# sigil (6.2.x won't auto-pull a module referenced only by a transitive
# git dep).
#
# `atomic`, `sync` and `test` are declared as leaves by dist/libro.deps but
# called zero times by dist/libro.cyr — they come from libro's own test
# harness. Deliberately not named here: cyrius resolves them transitively
# (clean-room `rm -rf lib && cyrius deps` -> 56 deps, 0 failed), and naming
# a module force-includes it into the compilation unit.

[deps.libro]
git = "https://github.com/MacCracken/libro.git"
tag = "2.9.0"
modules = ["dist/libro.cyr"]
