[package]
name = "argonaut"
version = "${file:VERSION}"
description = "Init system and service manager for AGNOS"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/argonaut"
language = "cyrius"
cyrius = "6.6.6"

[build]
entry = "src/main.cyr"
output = "build/argonaut"

# Stdlib modules `cyrius deps` copies into lib/.
#
# sakshi and patra come from the stdlib fold and follow the `cyrius` pin.
# libro also resolves patra as a package; cyrius keeps this copy, so the
# "refusing to overwrite stdlib leaf 'patra'" build warning is expected.
#
# Never add "sigil": that name is the monolithic bundle (x509, RSA,
# authenticode), none of which the audit chain reaches. libro's `deps.sigil`
# block already resolves the thin sub-bundles argonaut links.
[deps]
stdlib = [
    "string",
    "fmt",
    "alloc",
    "vec",
    "str",
    "slice",
    "syscalls",
    "io",
    "fs",
    "process",
    "hashmap",
    "tagged",
    "args",
    "bayan",
    "fnptr",
    "freelist",
    "chrono",
    "ct",
    "keccak",
    "thread",
    "thread_local",
    "random",
    "assert",
    "bench",
    "sakshi",
    "patra",
]

[deps.libro]
git = "https://github.com/MacCracken/libro.git"
tag = "2.10.3"
modules = ["dist/libro.cyr"]
