# health.cyr — Health check execution
# Runs health and readiness checks against live services.
# Ported from rust-old/src/health.rs

# =========================================================================
# 1.5.5 audit helpers — LOW-3 defense-in-depth
# =========================================================================
# sanitize_host_for_header(host): 1 if `host` is safe to embed in an
# HTTP `Host:` header, 0 otherwise. Rejects empty strings + any byte
# in the control-character range [0..31] or DEL (127). The primary
# defense against HTTP request-line / Host-header injection is the
# resolver gate (`resolve_host_ipv4` only accepts dotted quads or
# /etc/hosts names, neither of which can contain CRLF); this is a
# second gate so a future refactor that skips the resolver doesn't
# re-open the injection class.
fn sanitize_host_for_header(host) {
    var n = str_len(host);
    if (n == 0) { return 0; }
    var d = str_data(host);
    for (var i = 0; i < n; i = i + 1) {
        var c = load8(d + i);
        if (c < 32)  { return 0; }
        if (c == 127) { return 0; }
    }
    return 1;
}

# =========================================================================
# Health state
# =========================================================================

enum HealthState {
    HS_UNKNOWN;
    HS_HEALTHY;
    HS_DEGRADED;
    HS_UNHEALTHY;
}

fn health_state_str(s) {
    if (s == HS_UNKNOWN)   { return "unknown"; }
    if (s == HS_HEALTHY)   { return "healthy"; }
    if (s == HS_DEGRADED)  { return "degraded"; }
    if (s == HS_UNHEALTHY) { return "unhealthy"; }
    return "unknown";
}

# =========================================================================
# Individual check implementations
# =========================================================================

# tcp_connect_ip(ip, port, timeout_ms) — core TCP connect over a
# pre-resolved packed-BE IPv4. Returns 1 on success, 0 on failure.
# Split from `check_tcp_connect` (1.5.5 audit LOW-1) so the
# dispatcher can pre-resolve once and pass the IP, avoiding the
# duplicate /etc/hosts read on the hot path.
# ⚠ THE ONE BOUNDED CONNECT. 1.13.10 — kybernet audit MEDIUM-4.
#
# Returns a CONNECTED, BLOCKING fd (>= 0), or -1. The caller owns the fd.
#
# Factored out of `tcp_connect_ip` because the HTTP_GET arm of
# `execute_health_check` had its own copy that was a plain, blocking
# `sys_connect` with no O_NONBLOCK and no poll — so a `"type": "http"` check
# against an address that silently drops SYN (host down, firewall DROP rather
# than REJECT, cable pulled — ordinary for a health endpoint on another box)
# blocked the caller for the kernel's full SYN-retry window, roughly 127
# seconds, no matter what `timeout_ms` the operator configured.
#
# In kybernet that caller is PID 1's reactor, which blocks all signals into a
# signalfd and installs no handler, so the connect cannot even be cut short by
# EINTR: for those two minutes nothing reaps zombies, nothing handles SIGTERM,
# no watchdog is serviced and the notify socket is not drained. With a poll
# interval shorter than the stall the board is unresponsive essentially
# continuously.
#
# One implementation, two callers, so the bounded and unbounded versions cannot
# drift apart again — which is how this happened: `tcp_connect_ip` was made
# bounded and the HTTP copy was not.
#
# The fd comes back in BLOCKING mode. O_NONBLOCK is an implementation detail of
# bounding the connect; the HTTP arm then does an ordinary write and a
# poll-bounded read, exactly as it did before.
fn connect_bounded(ip, port, timeout_ms) {
    # socket(AF_INET=2, SOCK_STREAM=1, 0)
    var fd = sys_socket(2, 1, 0);
    if (fd < 0) { return 0 - 1; }

    # Build sockaddr_in (16 bytes)
    var addr[16];
    memset(&addr, 0, 16);
    store16(&addr, 2);      # AF_INET

    # Convert port to network byte order (big endian)
    var port_be = ((port & 255) << 8) | ((port >> 8) & 255);
    store16(&addr + 2, port_be);

    # sin_addr (4 bytes, big-endian).
    write_ipv4_octets(&addr + 4, ip);

    # Non-blocking so the connect can be bounded.
    # fcntl(fd, F_SETFL=4, O_NONBLOCK=2048)
    ag_sys_fcntl(fd, 4, 2048);

    var ret = sys_connect(fd, &addr, 16);

    if (ret == 0) {
        ag_sys_fcntl(fd, 4, 0);          # back to blocking
        return fd;
    }

    # EINPROGRESS = -115: wait for writability, bounded.
    if (ret == (0 - 115)) {
        var pollfd[8];
        store32(&pollfd, fd);
        store16(&pollfd + 4, 4);  # POLLOUT
        store16(&pollfd + 6, 0);  # revents

        var poll_ret = ag_sys_poll(&pollfd, 1, timeout_ms);
        if (poll_ret > 0) {
            var revents = load16(&pollfd + 6);
            if (revents & 4) {  # POLLOUT
                # 2026-08-24 audit LOW-5: zero the buffer AND check the
                # getsockopt return. `so_err` is static storage, so a failed
                # getsockopt left the previous call's value in place — and a
                # stale 0 reports a REFUSED connection as a successful one,
                # which is precisely the "misleading green badge" this
                # module exists to prevent. Fail closed instead.
                var so_err[8];
                var so_len[8];
                store64(&so_err, 0);
                store64(&so_len, 4);
                # getsockopt(fd, SOL_SOCKET=1, SO_ERROR=4, &val, &len)
                var so_ret = ag_sys_getsockopt(fd, 1, 4, &so_err, &so_len);
                if (so_ret == 0 && load32(&so_err) == 0) {
                    ag_sys_fcntl(fd, 4, 0);      # back to blocking
                    return fd;
                }
            }
        }
    }

    sys_close(fd);
    return 0 - 1;
}

# TCP reachability probe. 1 if a connection completed inside the bound.
fn tcp_connect_ip(ip, port, timeout_ms) {
    var fd = connect_bounded(ip, port, timeout_ms);
    if (fd < 0) { return 0; }
    sys_close(fd);
    return 1;
}

# check_tcp_connect(host, port, timeout_ms) — backwards-compatible
# wrapper. Resolves host then dispatches to `tcp_connect_ip`. Returns
# 1 on success, 0 on resolver miss OR connect failure (the
# dispatcher in `execute_health_check` re-resolves separately to
# distinguish the two cases in the audit message).
fn check_tcp_connect(host, port, timeout_ms) {
    var ip = resolve_host_ipv4(host);
    if (ip < 0) { return 0; }
    return tcp_connect_ip(ip, port, timeout_ms);
}

# Process alive check — kill(pid, 0)
fn check_process_alive(pid) {
    if (pid <= 0) { return 0; }
    return process_alive(pid);
}

# Command check — run command, exit 0 = healthy
#
# ⚠ THIS RAN UNBOUNDED ON PID 1's REACTOR PATH UNTIL 1.13.9, AND IGNORED THE
# TIMEOUT IT WAS HANDED.
#
# `timeout_ms` appeared in the signature and NOWHERE in the body: the call was
# `exec_vec_str(argv)`, and the cyrius stdlib's `exec_vec_str` does
# `sys_waitpid(pid, &stbuf, 0)` — flag 0, no WNOHANG, no deadline. Under
# kybernet, which is PID 1 and blocks signals process-wide, that wait is not
# even EINTR-breakable. A health command that blocks on a flock, a dead NFS
# mount, a socket read or a full pipe therefore froze the entire reactor: no
# SIGCHLD reaping (zombies to PID exhaustion), no SIGTERM/SIGINT handling (the
# box cannot shut down), no watchdog, no restart queue, no notify drain. The
# board looks alive and is dead.
#
# Two more defects in the same call, both from the same stdlib function:
#   - `exec_vec_str` builds an EMPTY envp and `execve(2)` does not search
#     $PATH, so a target like "true" or "systemctl is-active foo" was ENOENT
#     -> 127 -> unhealthy, deterministically, forever. A supervisor then
#     restarts a perfectly healthy service on a config that reads as correct.
#   - It DISCARDS waitpid's return before reading a `var stbuf[4]` that is
#     STATIC storage in cyrius, so a wait that does not land decodes status 0
#     as SUCCESS — a health check that never ran, reported as passing.
#
# `run_safe_cmd_timeout` is the bounded, status-checked, PATH-resolving,
# mask-resetting replacement that has been in this repo since 1.13.2, and
# which the consumer's own standing rule 17 mandates for exactly this reason.
# kybernet's edge-boot path made this move at its 1.5.7 and left the health
# path — one function away — on the unbounded stdlib call.
# ⚠ `str_split` RETURNS VIEWS, NOT NUL-TERMINATED STRINGS, AND execve NEEDS
# NUL-TERMINATED STRINGS.
#
# Measured on 6.5.35: splitting "/bin/sleep 5" on " " gives word[0] with
# str_len 10 whose NEXT BYTE IS 32 (the space), not 0 — the parts alias the
# original buffer. `run_safe_cmd_timeout` builds execve's argv from
# `str_data()`, so argv[0] came out as the whole "/bin/sleep 5" and every
# multi-word health command was ENOENT -> 127 -> unhealthy, forever. The old
# `exec_vec_str` path had the identical defect, so this was never a regression
# — it is why `check_command` only ever worked for a single-word target, and
# the reason the pre-1.13.9 test suite only ever tried `/bin/true`.
#
# Copied into a STATIC scratch buffer and split IN PLACE by overwriting each
# separator with a NUL. Static because this runs once per health poll per
# service on PID 1's reactor path, where an allocation per tick is a slow OOM
# of init — the defect class kybernet has now fixed five times. The buffer is
# 1024 bytes at global scope ([128] slots x 8); a longer command line is
# refused rather than truncated, because a silently shortened argv is a
# different command.
var _HC_CMD_BUF[128];
var _HC_WORDS[16];

# ⚠ THE SafeCommand AND ITS Str BOXES ARE REUSED TOO. 1.14.0.
#
# Measured on 1.13.10: `check_command` allocated **232 bytes per invocation**, of
# which **184 was `safe_cmd_new`** — an `alloc(16)` struct plus a fresh
# `vec_new()` for the args every single time — and 32 was inside
# `run_safe_cmd_timeout`. On PID 1's reactor path, once per health poll per
# service, in an arena init never resets, that is ~4 MB/day/service at a 5 s
# interval. Same defect class as the per-tick leaks kybernet has now fixed five
# times over.
#
# One SafeCommand per process, its args vec TRUNCATED rather than replaced, and
# a fixed pool of Str boxes rewritten in place over the words already sitting in
# `_HC_CMD_BUF`. A Str is {data, len}, so rewriting a box is two stores and
# allocates nothing.
#
# Safe because PID 1's reactor is single-threaded and `check_command` does not
# recurse: the command has been fully consumed by `run_safe_cmd_timeout` before
# the function returns, and nothing retains the SafeCommand or the boxes.
var _HC_SAFE_CMD = 0;
var _HC_STRS[16];

fn _hc_str(slot, cstr_ptr, n) {
    var box = load64((&_HC_STRS) + slot * 8);
    if (box == 0) {
        box = str_new(cstr_ptr, n);
        store64((&_HC_STRS) + slot * 8, box);
        return box;
    }
    store64(box, cstr_ptr);
    store64(box + 8, n);
    return box;
}

fn check_command(cmd_str, timeout_ms) {
    var slen = str_len(cmd_str);
    if (slen <= 0 || slen >= 1023) { return 0; }
    memcpy(&_HC_CMD_BUF, str_data(cmd_str), slen);
    store8((&_HC_CMD_BUF) + slen, 0);

    # Split in place: each word becomes its own NUL-terminated C string.
    var nwords = 0;
    var i = 0;
    while (i < slen) {
        while (i < slen && load8((&_HC_CMD_BUF) + i) == 32) { i = i + 1; }
        if (i >= slen) { break; }
        # ⚠ REFUSE, DO NOT TRUNCATE. 1.14.0.
        #
        # This was `while (i < slen && nwords < 16)`, which silently DROPPED
        # every word past the sixteenth and then ran the shortened command — the
        # exact defect the length guard above exists to prevent, reintroduced one
        # loop down. A command with more arguments than fit is a different
        # command, and running it is worse than reporting the service unhealthy.
        # Found by the over-long-argv assertion in tests/tcyr/health_exec.tcyr,
        # which was written to check the refusal and instead caught the truncation.
        if (nwords >= 16) { return 0; }
        var start = i;
        while (i < slen && load8((&_HC_CMD_BUF) + i) != 32) { i = i + 1; }
        store8((&_HC_CMD_BUF) + i, 0);
        store64((&_HC_WORDS) + nwords * 8, (&_HC_CMD_BUF) + start);
        nwords = nwords + 1;
        i = i + 1;
    }
    if (nwords == 0) { return 0; }

    # Word lengths, for the reusable Str boxes. Each word is NUL-terminated in
    # place inside _HC_CMD_BUF by the split above.
    var w0 = load64(&_HC_WORDS);
    var cmd = _HC_SAFE_CMD;
    if (cmd == 0) {
        cmd = safe_cmd_new(_hc_str(0, w0, strlen(w0)));
        _HC_SAFE_CMD = cmd;
    } else {
        store64(cmd, _hc_str(0, w0, strlen(w0)));
        vec_truncate(safe_cmd_args(cmd), 0);
    }
    for (var j = 1; j < nwords; j = j + 1) {
        var wj = load64((&_HC_WORDS) + j * 8);
        safe_cmd_add_arg(cmd, _hc_str(j, wj, strlen(wj)));
    }

    # A caller that passes 0/negative gets the HealthCheck default rather than
    # an unbounded wait: "no timeout configured" must never mean "wait forever"
    # in PID 1.
    var tmo = timeout_ms;
    if (tmo <= 0) { tmo = 2000; }

    var code = run_safe_cmd_timeout(cmd, tmo);
    return code == 0;
}

# =========================================================================
# Execute a health check
# =========================================================================

# health_result_new: allocate + fill a HealthCheckResult. `checked_at`
# is stamped with now_ms() here so every result carries a wall-clock
# timestamp. Consolidates the 6-store64 layout that was open-coded at
# every check exit (1.8.0 closeout refactor — behavior-preserving).
# Pass check_type_str=0 for results that don't carry a type label.
fn health_result_new(service, check_type_str, passed, latency, message) {
    var result = alloc(sizeof(HealthCheckResult));
    store64(result, service);
    store64(result + 8, check_type_str);
    store64(result + 16, passed);
    store64(result + 24, latency);
    store64(result + 32, message);
    store64(result + 40, now_ms());
    return result;
}

fn execute_health_check(service_name, hc, pid) {
    var start = monotonic_ms();
    var check_type = load64(hc);      # HealthCheckType
    var target = load64(hc + 8);      # Str ptr
    var port = load64(hc + 16);
    var timeout = load64(hc + 32);    # timeout_ms

    var passed = 0;
    var message = 0;

    # 2026-08-24 audit MEDIUM-5: every check type except HC_PROCESS_ALIVE
    # dereferences `target` — resolve_host_ipv4(target) for TCP,
    # check_command(target, …) for COMMAND, str_data(target) for HTTP. A
    # HealthCheck built with target = 0 (the natural mistake when copying
    # the HC_PROCESS_ALIVE idiom, which legitimately has none) read address
    # 0x8 during the health pass and took PID 1 down with it. A missing
    # target is a check that FAILS.
    if (check_type != HC_PROCESS_ALIVE) {
        if (target == 0) {
            return health_result_new(service_name,
              str_from(health_check_type_str(check_type)), 0, 0,
              str_from("health check: no target configured"));
        }
    }

    if (check_type == HC_TCP_CONNECT) {
        # H1 (closed 1.5.2): resolve the configured host via
        # `resolve_host_ipv4` rather than silently probing 127.0.0.1.
        # `check_tcp_connect` returns 0 for both "unresolvable" and
        # "connect failed"; disambiguate by pre-resolving here so the
        # supervisor's audit trail names the actual cause.
        # **LOW-1 (1.5.5 audit):** pre-resolve once and dispatch to
        # `tcp_connect_ip` with the resolved value rather than letting
        # `check_tcp_connect` re-resolve internally.
        var tcp_ip = resolve_host_ipv4(target);
        if (tcp_ip < 0) {
            passed = 0;
            message = str_from("TCP check: host did not resolve");
        } else {
            passed = tcp_connect_ip(tcp_ip, port, timeout);
            if (passed) {
                message = str_from("TCP connect succeeded");
            } else {
                message = str_from("TCP connect failed");
            }
        }
    } elif (check_type == HC_PROCESS_ALIVE) {
        passed = check_process_alive(pid);
        if (passed == 0) {
            message = str_from("process not alive");
        }
    } elif (check_type == HC_COMMAND) {
        passed = check_command(target, timeout);
        if (passed == 0) {
            message = str_from("command check failed");
        }
    } elif (check_type == HC_HTTP_GET) {
        # HTTP GET: connect, send GET request, validate status line
        var url_data = str_data(target);
        var url_len = str_len(target);
        # Require http:// — reject https and other schemes.
        #
        # 2026-08-24 audit HIGH-1: this used to `return 0` — a NULL pointer —
        # while every other path in this function returns a
        # HealthCheckResult. Both callers dereference immediately
        # (`load64(result + 16)` at :468 below and src/init.cyr:676), so an
        # https:// / HTTP:// / bare host:port target read address 0x10 during
        # the health pass. Under PID 1 that is a kernel panic. An
        # unsupported scheme is a check that FAILS, not one that returns
        # nothing.
        if (str_starts_with(target, "http://") == 0) {
            return health_result_new(service_name,
              str_from(health_check_type_str(check_type)), 0, 0,
              str_from("HTTP check: unsupported scheme (only http:// is supported)"));
        }
        var offset = 7;
        # Parse host and port
        var colon_pos = 0 - 1;
        var slash_pos = url_len;
        for (var i = offset; i < url_len; i = i + 1) {
            var c = load8(url_data + i);
            if (c == 58 && colon_pos < 0) { colon_pos = i; }
            if (c == 47) { slash_pos = i; break; }
        }
        var http_port = 80;
        var host_end = slash_pos;
        if (colon_pos > 0) {
            host_end = colon_pos;
            var port_start = colon_pos + 1;
            var port_end = port_start;
            while (port_end < slash_pos && load8(url_data + port_end) >= 48 && load8(url_data + port_end) <= 57) {
                port_end = port_end + 1;
            }
            if (port_end > port_start) {
                http_port = str_to_int(str_new(url_data + port_start, port_end - port_start));
            }
        }

        # LOW-2 (1.5.5 audit): reject ports outside the valid TCP
        # range (1..65535) at parse time so the supervisor sees a
        # clear "port out of range" message instead of a silent
        # connect failure on a wraparound port.
        if (http_port < 1 || http_port > 65535) {
            return health_result_new(service_name,
              str_from(health_check_type_str(check_type)), 0, 0,
              str_from("HTTP check: port out of range"));
        }

        # H1 (closed 1.5.2): resolve the configured host via
        # `resolve_host_ipv4`. Unresolvable inputs short-circuit with
        # a clear message rather than the silent-localhost fallback
        # that shipped pre-1.4.0.
        var host_str = str_new(url_data + offset, host_end - offset);

        # LOW-3 (1.5.5 audit): defense-in-depth — block CRLF / NUL /
        # control bytes from reaching the `Host:` header builder.
        # The resolver gate already rejects these, but a future
        # refactor that skips the resolver shouldn't re-open the
        # injection class.
        if (sanitize_host_for_header(host_str) == 0) {
            return health_result_new(service_name,
              str_from(health_check_type_str(check_type)), 0, 0,
              str_from("HTTP check: host has invalid byte"));
        }

        var http_ip = resolve_host_ipv4(host_str);
        if (http_ip < 0) {
            return health_result_new(service_name,
              str_from(health_check_type_str(check_type)), 0, 0,
              str_from("HTTP check: host did not resolve"));
        }

        # M2: heap-copy + NUL-terminate the path. The legacy code
        # set `path` to a raw pointer into url_data, then passed it
        # to str_builder_add_cstr which reads until NUL — undefined
        # for Str-data pointers (not guaranteed NUL-terminated).
        var path = "/";
        var path_len = 1;
        if (slash_pos < url_len) {
            path_len = url_len - slash_pos;
            var path_buf = alloc(path_len + 1);
            memcpy(path_buf, url_data + slash_pos, path_len);
            store8(path_buf + path_len, 0);
            path = path_buf;
        }

        # ⚠ BOUNDED CONNECT — 1.13.10, kybernet audit MEDIUM-4. This was a
        # plain blocking `sys_connect`, so a blackholed target stalled the
        # caller for the kernel's whole SYN-retry window (~127 s) regardless of
        # `timeout_ms`. In kybernet the caller is PID 1's reactor. Shares one
        # implementation with `tcp_connect_ip` now so the two cannot drift.
        var fd = connect_bounded(http_ip, http_port, timeout);
        if (fd >= 0) {
            var ret = 0;
            if (ret == 0) {
                # Send HTTP GET request. Host: header echoes the
                # configured host (not hardcoded 127.0.0.1) so
                # virtual-host servers route the request correctly.
                var req_sb = str_builder_new();
                str_builder_add_cstr(req_sb, "GET ");
                str_builder_add_cstr(req_sb, path);
                str_builder_add_cstr(req_sb, " HTTP/1.0\r\nHost: ");
                str_builder_add(req_sb, host_str);
                str_builder_add_cstr(req_sb, "\r\nConnection: close\r\n\r\n");
                var req = str_builder_build(req_sb);
                var req_data = str_data(req);
                var req_len = str_len(req);
                # 2026-08-24 audit LOW-3: check the write. A short or failed
                # write used to fall through to the poll below and surface as
                # "HTTP response timeout", blaming the peer for a local error.
                var wrote = sys_write(fd, req_data, req_len);
                if (wrote != req_len) {
                    message = str_from("HTTP request write failed");
                    sys_close(fd);
                    return health_result_new(service_name,
                      str_from(health_check_type_str(check_type)), 0, 0, message);
                }

                # Read response (just need status line)
                var resp[512];
                # Poll for data with timeout
                var pfd[8];
                store32(&pfd, fd);
                store16(&pfd + 4, 1);  # POLLIN
                store16(&pfd + 6, 0);
                var poll_ret = ag_sys_poll(&pfd, 1, timeout);
                if (poll_ret > 0) {
                    # 2026-08-24 audit LOW-3: a single read() assumed the whole
                    # status line arrived in one segment. A server that splits
                    # "HTTP/1.1 200 OK" across TCP segments returned n < 12 and
                    # was reported as an "invalid HTTP response" — a FALSE
                    # negative that restarts a healthy service under PID 1.
                    # Keep reading until the status line is complete (CR/LF
                    # seen, or enough bytes to hold a code), the peer closes,
                    # or the poll budget is spent.
                    var n = 0;
                    var reading = 1;
                    while (reading == 1) {
                        var got = sys_read(fd, &resp + n, 511 - n);
                        if (got <= 0) { reading = 0; }
                        else {
                            n = n + got;
                            if (n >= 511) { reading = 0; }
                            else {
                                var saw_eol = 0;
                                for (var ri = 0; ri < n; ri = ri + 1) {
                                    if (load8(&resp + ri) == 10) { saw_eol = 1; }
                                }
                                if (saw_eol == 1) { reading = 0; }
                                else {
                                    var pr = ag_sys_poll(&pfd, 1, timeout);
                                    if (pr <= 0) { reading = 0; }
                                }
                            }
                        }
                    }
                    if (n > 0) {
                        store8(&resp + n, 0);
                        # L5: parse status by finding the first space
                        # rather than hardcoding offsets 9-11. Handles
                        # any HTTP/x.y prefix length without misreading.
                        if (n >= 12 && load8(&resp) == 72 && load8(&resp + 1) == 84) {
                            var status_code = 0;
                            var sp = 0 - 1;
                            for (var si = 0; si < n; si = si + 1) {
                                if (load8(&resp + si) == 32) { sp = si; break; }
                            }
                            if (sp >= 0 && sp + 3 < n) {
                                var d0 = load8(&resp + sp + 1) - 48;
                                var d1 = load8(&resp + sp + 2) - 48;
                                var d2 = load8(&resp + sp + 3) - 48;
                                if (d0 >= 0 && d0 <= 9 && d1 >= 0 && d1 <= 9 && d2 >= 0 && d2 <= 9) {
                                    status_code = d0 * 100 + d1 * 10 + d2;
                                }
                            }
                            if (status_code >= 200 && status_code < 400) {
                                passed = 1;
                                var msb = str_builder_new();
                                str_builder_add_cstr(msb, "HTTP ");
                                str_builder_add_int(msb, status_code);
                                message = str_builder_build(msb);
                            } else {
                                var msb = str_builder_new();
                                str_builder_add_cstr(msb, "HTTP ");
                                str_builder_add_int(msb, status_code);
                                message = str_builder_build(msb);
                            }
                        } else {
                            message = str_from("invalid HTTP response");
                        }
                    } else {
                        message = str_from("HTTP read failed");
                    }
                } else {
                    message = str_from("HTTP response timeout");
                }
            } else {
                message = str_from("HTTP connect failed");
            }
            sys_close(fd);
        } else {
            message = str_from("HTTP socket failed");
        }
    }

    var latency = monotonic_ms() - start;

    var result = health_result_new(service_name,
      str_from(health_check_type_str(check_type)), passed, latency, message);

    # Trace result
    if (passed) {
        sakshi_debug(str_data(service_name), str_len(service_name));
    } else {
        var emsg = str_data(service_name);
        sakshi_warn(emsg, str_len(service_name));
    }

    return result;
}

# =========================================================================
# Execute a readiness check with retries
# =========================================================================

fn execute_ready_check(service_name, rc, pid) {
    var check_type = load64(rc);
    var target = load64(rc + 8);
    var port = load64(rc + 16);
    var timeout = load64(rc + 24);
    var retries = load64(rc + 32);
    var retry_delay = load64(rc + 40);

    var overall_start = monotonic_ms();

    # Pre-allocate temporary HealthCheck outside retry loop
    var hc = alloc(sizeof(HealthCheck));
    store64(hc, check_type);
    store64(hc + 8, target);
    store64(hc + 16, port);
    store64(hc + 24, 0);        # interval (unused)
    store64(hc + 32, timeout);  # timeout_ms
    store64(hc + 40, 0);        # retries (unused)

    sakshi_debug(str_data(service_name), str_len(service_name));

    for (var attempt = 0; attempt <= retries; attempt = attempt + 1) {
        var remaining = timeout - (monotonic_ms() - overall_start);
        if (remaining <= 0) {
            # Timed out
            return health_result_new(service_name, 0, 0,
              monotonic_ms() - overall_start,
              str_from("ready check timed out"));
        }

        # Update remaining timeout for this attempt
        store64(hc + 32, remaining);

        var result = execute_health_check(service_name, hc, pid);
        if (load64(result + 16)) {  # passed
            return result;
        }

        if (attempt < retries) {
            sleep_ms(retry_delay);
        }
    }

    # All retries exhausted
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "ready check failed after ");
    str_builder_add_int(sb, retries);
    str_builder_add_cstr(sb, " retries");
    return health_result_new(service_name, 0, 0,
      monotonic_ms() - overall_start, str_builder_build(sb));
}

# =========================================================================
# Health history — ring buffer
# =========================================================================

struct HealthHistory {
    results;                # vec of HealthCheckResult ptrs
    capacity;
    write_pos;
    total;
    consecutive_failures;
    state;                  # HealthState
}

fn health_history_new(capacity) {
    if (capacity < 1) { capacity = 1; }
    var hh = alloc(sizeof(HealthHistory));
    store64(hh, vec_new());
    store64(hh + 8, capacity);
    store64(hh + 16, 0);  # write_pos
    store64(hh + 24, 0);  # total
    store64(hh + 32, 0);  # consecutive_failures
    store64(hh + 40, HS_UNKNOWN);
    return hh;
}

fn health_history_record(hh, result, threshold) {
    var passed = load64(result + 16);

    if (passed) {
        store64(hh + 32, 0);            # consecutive_failures = 0
        store64(hh + 40, HS_HEALTHY);
    } else {
        var cf = load64(hh + 32) + 1;
        store64(hh + 32, cf);
        if (cf >= threshold) {
            store64(hh + 40, HS_UNHEALTHY);
        } else {
            store64(hh + 40, HS_DEGRADED);
        }
    }

    # Insert into ring buffer
    var results = load64(hh);
    var capacity = load64(hh + 8);
    var write_pos = load64(hh + 16);

    if (vec_len(results) < capacity) {
        vec_push(results, result);
    } else {
        vec_set(results, write_pos, result);
    }

    store64(hh + 16, (write_pos + 1) % capacity);
    store64(hh + 24, load64(hh + 24) + 1);  # total++
}

fn health_history_failures(hh) { return load64(hh + 32); }
fn health_history_total(hh)    { return load64(hh + 24); }
fn health_history_state(hh)    { return load64(hh + 40); }
fn health_history_len(hh)      { return vec_len(load64(hh)); }

fn health_history_reset(hh) {
    store64(hh, vec_new());
    store64(hh + 16, 0);
    store64(hh + 24, 0);
    store64(hh + 32, 0);
    store64(hh + 40, HS_UNKNOWN);
}
