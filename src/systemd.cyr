# systemd.cyr — systemd unit file generation
# Generates .service unit files from argonaut service definitions.
# Ported from rust-old/src/systemd.rs

# =========================================================================
# Escaping
# =========================================================================
#
# ⚠ 1.16.1 audit B-2: EACH SETTING INTERPRETS DIFFERENT CHARACTERS, SO EACH
# GETS ITS OWN ESCAPE. One sanitiser for all of them left four injections open
# after 2026-08-24 MEDIUM-7 (systemd.service(5), systemd.exec(5),
# systemd.unit(5) "Specifiers"):
#   * every value here undergoes specifier expansion, so '%' is doubled
#     everywhere — `%h` in an argument became the service user's home;
#   * only Exec*= lines expand `$VAR`, so '$' is doubled there alone;
#     Environment= and Description= take '$' literally and doubling it
#     corrupted the value;
#   * a lone ';' word separates commands on an Exec line, so it is
#     written as `\;`;
#   * an Environment= value sits inside a double-quoted word, where an
#     unescaped '"' closed the word and opened a new assignment
#     (`v" "LD_PRELOAD=/tmp/e.so`);
#   * a newline would end the setting and start a new one, so it is folded
#     to a space; a CR is dropped.
# Keys and dependency names are VALIDATED instead of escaped — see
# generate_unit.

# Append `value` to `sb` with line breaks folded, '%' doubled, and — when
# `is_exec` is 1 — '$' doubled. When `quoted` is 1, '"' and '\' are
# backslash-escaped for use inside a double-quoted word.
fn _unit_escape_into(sb, value, is_exec, quoted) {
    var data = str_data(value);
    var len = str_len(value);
    for (var i = 0; i < len; i = i + 1) {
        var c = load8(data + i);
        if (c == 10) {                  # \n -> space
            str_builder_putc(sb, 32);
        } elif (c == 13) {              # \r -> dropped
            continue;
        } elif (c == 37) {              # % -> %%
            str_builder_putc(sb, 37);
            str_builder_putc(sb, 37);
        } elif (c == 36) {              # $ -> $$ on Exec lines only
            str_builder_putc(sb, 36);
            if (is_exec == 1) { str_builder_putc(sb, 36); }
        } elif (quoted == 1) {
            if (c == 34) { str_builder_putc(sb, 92); }   # \"
            if (c == 92) { str_builder_putc(sb, 92); }   # \\
            str_builder_putc(sb, c);
        } else {
            str_builder_putc(sb, c);
        }
    }
    return 0;
}

# A free-text value (Description=): one line, '%' doubled, '$' literal.
fn sanitize_unit_value(value) {
    var sb = str_builder_new();
    _unit_escape_into(sb, value, 0, 0);
    return str_builder_build(sb);
}

# One word of an Exec*= command line. Quoted when it contains whitespace or a
# quote/backslash character (systemd splits on both quote styles and C-unescapes
# backslashes); an empty argument is written `""` so it stays an argument; a
# lone ';' is written `\;` so it is an argument, not a command separator.
fn escape_systemd_value(value) {
    var data = str_data(value);
    var len = str_len(value);
    if (len == 0) { return str_from("\"\""); }
    if (len == 1) {
        if (load8(data) == 59) { return str_from("\\;"); }
    }

    var needs_quote = 0;
    for (var i = 0; i < len; i = i + 1) {
        var c = load8(data + i);
        if (c == 32) { needs_quote = 1; }   # space
        if (c == 9)  { needs_quote = 1; }   # tab
        if (c == 10) { needs_quote = 1; }   # newline (folded to a space)
        if (c == 34) { needs_quote = 1; }   # "
        if (c == 39) { needs_quote = 1; }   # '
        if (c == 92) { needs_quote = 1; }   # backslash
    }

    var sb = str_builder_new();
    if (needs_quote == 1) { str_builder_putc(sb, 34); }
    _unit_escape_into(sb, value, 1, needs_quote);
    if (needs_quote == 1) { str_builder_putc(sb, 34); }
    return str_builder_build(sb);
}

# 1 when the cstr `key` is a usable environment name, [A-Za-z_][A-Za-z0-9_]*.
fn _unit_env_key_ok(key) {
    var c = load8(key);
    if (c == 0) { return 0; }
    var ok = 1;
    var i = 0;
    while (ok == 1 && c != 0) {
        var good = 0;
        if (c >= 65 && c <= 90)  { good = 1; }       # A-Z
        if (c >= 97 && c <= 122) { good = 1; }       # a-z
        if (c == 95)             { good = 1; }       # _
        if (i > 0) {
            if (c >= 48 && c <= 57) { good = 1; }    # 0-9, not first
        }
        if (good == 0) { ok = 0; }
        i = i + 1;
        c = load8(key + i);
    }
    return ok;
}

# =========================================================================
# Unit file generation
# =========================================================================

fn generate_unit(svc) {
    var sb = str_builder_new();

    # [Unit] section
    str_builder_add_cstr(sb, "[Unit]\n");
    str_builder_add_cstr(sb, "Description=");
    var desc = svc_def_desc(svc);
    if (desc != 0) { _unit_escape_into(sb, desc, 0, 0); }
    str_builder_add_cstr(sb, "\n");

    var deps = svc_def_deps(svc);
    if (vec_len(deps) > 0) {
        # Build dependency string
        var dep_sb = str_builder_new();
        for (var i = 0; i < vec_len(deps); i = i + 1) {
            if (i > 0) { str_builder_add_cstr(dep_sb, " "); }
            # 2026-08-24 audit MEDIUM-7: sanitize. The Description above
            # already went through sanitize_unit_value, but dependency names
            # were added raw — a dep carrying a newline closed the After=
            # line and opened its own section, injecting arbitrary directives
            # (e.g. a second ExecStart) into a unit systemd runs as root.
            # 1.16.1 audit B-2: through the unit-NAME sanitiser, not the value
            # one. After=/Requires= are space-separated lists, so a folded
            # newline or a plain space ("db debug-shell") still added a second
            # unit; a name is now one [A-Za-z0-9_.-] token.
            str_builder_add(dep_sb, sanitize_unit_name(vec_get(deps, i)));
            str_builder_add_cstr(dep_sb, ".service");
        }
        var dep_str = str_builder_build(dep_sb);
        str_builder_add_cstr(sb, "After=");
        str_builder_add(sb, dep_str);
        str_builder_add_cstr(sb, "\n");
        str_builder_add_cstr(sb, "Requires=");
        str_builder_add(sb, dep_str);
        str_builder_add_cstr(sb, "\n");
    }

    str_builder_add_cstr(sb, "\n");

    # [Service] section
    str_builder_add_cstr(sb, "[Service]\n");
    # 1.16.1 audit B-2 LOW: each type maps to its own Type=. SVC_SIMPLE was
    # rendered Type=notify, so systemd held a service that never sends
    # READY=1 in "activating" until its start timeout failed it.
    var svc_type = svc_def_service_type(svc);
    if (svc_type == SVC_FORKING) {
        str_builder_add_cstr(sb, "Type=forking\n");
    } elif (svc_type == SVC_ONESHOT) {
        str_builder_add_cstr(sb, "Type=oneshot\n");
    } elif (svc_type == SVC_NOTIFY) {
        str_builder_add_cstr(sb, "Type=notify\n");
    } else {
        str_builder_add_cstr(sb, "Type=simple\n");
    }

    # ExecStart
    str_builder_add_cstr(sb, "ExecStart=");
    str_builder_add(sb, escape_systemd_value(svc_def_binary(svc)));
    var args = svc_def_args(svc);
    for (var i = 0; i < vec_len(args); i = i + 1) {
        str_builder_add_cstr(sb, " ");
        str_builder_add(sb, escape_systemd_value(vec_get(args, i)));
    }
    str_builder_add_cstr(sb, "\n");

    # Environment — sorted keys for deterministic output
    var env = svc_def_env(svc);
    var env_keys = map_keys(env);
    # Inline insertion sort to avoid cc3 bug #16 (new function shifts addresses)
    # Flag-style loops: no `break` inside a while that declares `var`.
    for (var si = 1; si < vec_len(env_keys); si = si + 1) {
        var skey = vec_get(env_keys, si);
        var sj = si - 1;
        var placed = 0;
        while (placed == 0 && sj >= 0) {
            var sa = vec_get(env_keys, sj);
            # Lexicographic compare inline (strcmp sign)
            var sk = 0;
            var cmp = 0;
            var scanning = 1;
            while (scanning == 1) {
                var ca = load8(sa + sk);
                var cb = load8(skey + sk);
                if (ca != cb) {
                    cmp = ca - cb;
                    scanning = 0;
                } elif (ca == 0) {
                    scanning = 0;
                } else {
                    sk = sk + 1;
                }
            }
            if (cmp <= 0) {
                placed = 1;
            } else {
                vec_set(env_keys, sj + 1, sa);
                sj = sj - 1;
            }
        }
        vec_set(env_keys, sj + 1, skey);
    }
    for (var i = 0; i < vec_len(env_keys); i = i + 1) {
        var key = vec_get(env_keys, i);
        var val = map_get(env, key);
        # 1.16.1 audit B-2: a key is emitted raw, so it is validated rather
        # than escaped — one carrying a newline injected `ExecStartPre=`.
        # Anything that is not an environment name is skipped.
        if (val != 0) {
            if (_unit_env_key_ok(key) == 1) {
                str_builder_add_cstr(sb, "Environment=\"");
                str_builder_add_cstr(sb, key);
                str_builder_add_cstr(sb, "=");
                _unit_escape_into(sb, val, 0, 1);
                str_builder_add_cstr(sb, "\"\n");
            }
        }
    }

    # Restart policy
    var policy = svc_def_restart_policy(svc);
    str_builder_add_cstr(sb, "Restart=");
    if (policy == RESTART_ALWAYS) {
        str_builder_add_cstr(sb, "always");
    } elif (policy == RESTART_ON_FAILURE) {
        str_builder_add_cstr(sb, "on-failure");
    } else {
        str_builder_add_cstr(sb, "no");
    }
    str_builder_add_cstr(sb, "\n");

    # RestartSec
    var rc = svc_def_restart_config(svc);
    var restart_sec = load64(rc + 8) / 1000;  # base_delay_ms to seconds
    if (restart_sec < 1) { restart_sec = 1; }
    str_builder_add_cstr(sb, "RestartSec=");
    str_builder_add_int(sb, restart_sec);
    str_builder_add_cstr(sb, "\n");

    # StartLimitBurst
    var max_restarts = load64(rc);
    if (max_restarts > 0) {
        str_builder_add_cstr(sb, "StartLimitBurst=");
        str_builder_add_int(sb, max_restarts);
        str_builder_add_cstr(sb, "\n");
    }

    # WatchdogSec from health check
    var hc = svc_def_health_check(svc);
    if (hc != 0) {
        var interval = load64(hc + 24);  # interval_ms
        var retries = load64(hc + 40);   # retries
        var watchdog_sec = (interval * retries) / 1000;
        if (watchdog_sec > 0) {
            str_builder_add_cstr(sb, "WatchdogSec=");
            str_builder_add_int(sb, watchdog_sec);
            str_builder_add_cstr(sb, "\n");
        }
    }

    str_builder_add_cstr(sb, "NotifyAccess=main\n");
    str_builder_add_cstr(sb, "\n");

    # [Install] section
    str_builder_add_cstr(sb, "[Install]\n");
    var modes = svc_def_modes(svc);
    var has_graphical = 0;
    for (var i = 0; i < vec_len(modes); i = i + 1) {
        if (vec_get(modes, i) == BOOT_DESKTOP) { has_graphical = 1; }
    }
    if (has_graphical) {
        str_builder_add_cstr(sb, "WantedBy=graphical.target\n");
    } else {
        str_builder_add_cstr(sb, "WantedBy=multi-user.target\n");
    }

    return str_builder_build(sb);
}

# sanitize_unit_name — reduce a service name to a single safe path
# component for use as a unit FILENAME.
#
# 2026-08-24 audit MEDIUM-7: `generate_unit_filename` interpolated the
# service name raw, so a name containing '/' or '..' escaped the unit
# directory the caller writes into. Anything outside [A-Za-z0-9_.-] becomes
# '_', and a leading '.' is replaced too so neither "." nor ".." can be
# produced. Ordinary names are unchanged.
fn sanitize_unit_name(name) {
    var data = str_data(name);
    var len = str_len(name);
    var sb = str_builder_new();
    if (len == 0) { return str_from("unnamed"); }
    for (var i = 0; i < len; i = i + 1) {
        var c = load8(data + i);
        var ok = 0;
        if (c >= 48 && c <= 57)  { ok = 1; }       # 0-9
        if (c >= 65 && c <= 90)  { ok = 1; }       # A-Z
        if (c >= 97 && c <= 122) { ok = 1; }       # a-z
        if (c == 45 || c == 95)  { ok = 1; }       # - _
        if (c == 46 && i > 0)    { ok = 1; }       # '.' but never leading
        if (ok == 1) { str_builder_putc(sb, c); }
        else { str_builder_putc(sb, 95); }         # '_'
    }
    return str_builder_build(sb);
}

fn generate_unit_filename(svc) {
    var sb = str_builder_new();
    str_builder_add(sb, sanitize_unit_name(svc_def_name(svc)));
    str_builder_add_cstr(sb, ".service");
    return str_builder_build(sb);
}
