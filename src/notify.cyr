# notify.cyr — sd_notify compatible readiness notification
# Implements server side of the systemd notification protocol.
# Ported from rust-old/src/notify.rs

# =========================================================================
# NotifyMessage — parsed sd_notify fields
# =========================================================================

struct NotifyMessage {
    ready;          # 1/0
    status;         # Str ptr (0 = none)
    main_pid;       # i64 (0 = not set)
    watchdog;       # 1/0
    reloading;      # 1/0
    stopping;       # 1/0
    fields;         # map of key -> value
}

fn notify_msg_new() {
    var msg = alloc(sizeof(NotifyMessage));
    store64(msg, 0);          # ready
    store64(msg + 8, 0);      # status
    store64(msg + 16, 0);     # main_pid
    store64(msg + 24, 0);     # watchdog
    store64(msg + 32, 0);     # reloading
    store64(msg + 40, 0);     # stopping
    # 2026-08-24 audit MEDIUM-1: Str-keyed, NOT cstr-keyed. A cstr map
    # hashes by walking to the next NUL, and notify datagrams arrive from
    # sys_read() with no terminator — so the walk ran off the end of the
    # receive buffer. map_new_str hashes over the Str's length instead.
    store64(msg + 48, map_new_str());  # fields
    return msg;
}

# Parse an sd_notify message (newline-separated KEY=VALUE pairs)
fn notify_parse(data, len) {
    var msg = notify_msg_new();
    var fields = load64(msg + 48);

    var line_start = 0;
    for (var i = 0; i <= len; i = i + 1) {
        var c = 0;
        if (i < len) { c = load8(data + i); }

        if (c == 10 || i == len) {
            var line_len = i - line_start;
            if (line_len > 0) {
                # Find '=' in line
                var eq_pos = 0 - 1;
                for (var j = line_start; j < i; j = j + 1) {
                    if (load8(data + j) == 61) {  # '='
                        eq_pos = j;
                        break;
                    }
                }
                if (eq_pos > line_start) {
                    # 2026-08-24 audit MEDIUM-1: str_new BORROWS `data`, which
                    # is the shared module-level receive buffer — every later
                    # datagram overwrote the Strs handed back for earlier ones
                    # (notify_drain returned N messages all aliasing the last
                    # one). str_clone gives each message its own bytes.
                    var key = str_clone(str_new(data + line_start, eq_pos - line_start));
                    var val = str_clone(str_new(data + eq_pos + 1, i - eq_pos - 1));

                    map_set(fields, key, val);

                    # Match known keys
                    if (str_eq(key, str_from("READY"))) {
                        store64(msg, str_eq(val, str_from("1")));
                    } elif (str_eq(key, str_from("STATUS"))) {
                        store64(msg + 8, val);
                    } elif (str_eq(key, str_from("MAINPID"))) {
                        store64(msg + 16, str_to_int(val));
                    } elif (str_eq(key, str_from("WATCHDOG"))) {
                        store64(msg + 24, str_eq(val, str_from("1")));
                    } elif (str_eq(key, str_from("RELOADING"))) {
                        store64(msg + 32, str_eq(val, str_from("1")));
                    } elif (str_eq(key, str_from("STOPPING"))) {
                        store64(msg + 40, str_eq(val, str_from("1")));
                    }
                }
            }
            line_start = i + 1;
        }
    }

    return msg;
}

# =========================================================================
# NotifyListener — Unix datagram socket listener
# =========================================================================

# Create a notify listener bound to a socket path.
# Returns socket fd or -1 on error.
fn notify_bind(path) {
    # Remove stale socket
    sys_unlink(str_data(path));

    # Ensure parent directory exists
    sys_mkdir("/run/argonaut", 448);  # 0o700 — argonaut-internal; no other process should traverse

    # socket(AF_UNIX=1, SOCK_DGRAM=2, 0)
    var fd = sys_socket(1, 2, 0);
    if (fd < 0) { return 0 - 1; }

    # Build sockaddr_un
    var addr[110];
    memset(&addr, 0, 110);
    store16(&addr, 1);  # AF_UNIX
    var path_data = str_data(path);
    var path_len = str_len(path);
    if (path_len > 107) { path_len = 107; }
    memcpy(&addr + 2, path_data, path_len);

    # bind(fd, &addr, sizeof(sa_family) + path_len + 1)
    var ret = sys_bind(fd, &addr, 2 + path_len + 1);
    if (ret < 0) {
        sys_close(fd);
        return 0 - 1;
    }

    # Set non-blocking
    ag_sys_fcntl(fd, 4, 2048);  # F_SETFL O_NONBLOCK

    # M1: enable SO_PASSCRED so recvmsg() with SCM_CREDENTIALS gives us
    # the kernel-stamped sender credentials. notify_try_recv_authenticated
    # below relies on this for the per-datagram peer-cred check.
    var one[4];
    store32(&one, 1);
    sys_setsockopt(fd, 1, 16, &one, 4);   # SOL_SOCKET=1, SO_PASSCRED=16

    return fd;
}

# Shared recv buffer — allocated once on first call
var _notify_recv_buf = 0;

# pid_in_vec — linear membership test for tiny pid sets (running services).
fn pid_in_vec(pids, pid) {
    if (pids == 0) { return 0; }
    for (var i = 0; i < vec_len(pids); i = i + 1) {
        if (vec_get(pids, i) == pid) { return 1; }
    }
    return 0;
}

# notify_try_recv_authenticated — M1 (sd_notify SO_PEERCRED check).
# recvmsg() variant that requires the SCM_CREDENTIALS ancillary the
# kernel attaches when SO_PASSCRED is enabled (notify_bind sets it).
# Drops any datagram whose sender PID is NOT in the expected_pids vec —
# blocks the spoofing primitive where a local attacker on the notify
# socket fakes READY=1 / WATCHDOG=1 for a service they don't own.
# Returns NotifyMessage ptr on accept; 0 on (no message OR rejected).
# Outcome of the most recent notify_try_recv_authenticated call.
enum NotifyRecvOutcome {
    NOTIFY_RECV_EMPTY = 0;         # nothing queued — the ONLY "stop draining"
    NOTIFY_RECV_OK = 1;            # authenticated and attributed
    NOTIFY_RECV_NOCRED = 2;        # consumed; no/invalid SCM_CREDENTIALS
    NOTIFY_RECV_TRUNCATED = 3;     # consumed; MSG_CTRUNC, credentials untrustworthy
    NOTIFY_RECV_UNATTRIBUTED = 4;  # consumed; authenticated but not a known service pid
}

var _notify_last = 0;
var _notify_sender_pid = 0;
var _notify_sender_uid = 0;

fn notify_try_recv_authenticated(fd, expected_pids) {
    if (_notify_recv_buf == 0) {
        _notify_recv_buf = alloc(1024);
    }
    # iovec { base, len }
    var iov[16];
    store64(&iov, _notify_recv_buf);
    store64(&iov + 8, 1024);
    # control buffer for one SCM_CREDENTIALS (cmsghdr 16 + ucred 12, aligned to 32)
    var ctrl[32];
    memset(&ctrl, 0, 32);
    # msghdr { name, namelen, iov, iovlen, control, controllen, flags }
    var mh[56];
    memset(&mh, 0, 56);
    store64(&mh + 16, &iov);     # msg_iov
    store64(&mh + 24, 1);        # msg_iovlen
    store64(&mh + 32, &ctrl);    # msg_control
    store64(&mh + 40, 32);       # msg_controllen
    # recvmsg(fd, &mh, MSG_DONTWAIT=64)
    _notify_last = NOTIFY_RECV_EMPTY;
    var n = sys_recvmsg(fd, &mh, 64);
    if (n < 0) { return 0; }
    # A zero-length datagram is legal on AF_UNIX SOCK_DGRAM and recvmsg
    # returns 0 having CONSUMED it — reporting that as "queue empty" ends the
    # drain early, which is the same starvation this change exists to fix.
    if (n == 0) { _notify_last = NOTIFY_RECV_NOCRED; return 0; }
    # Require an SCM_CREDENTIALS cmsg. Drop on missing/wrong type so a
    # caller that forgets SO_PASSCRED can't slip messages through.
    var ctrllen = load64(&mh + 40);
    # Stricter than `< 16`: a cmsghdr(16) plus a struct ucred(12) is 28 bytes,
    # and MSG_CTRUNC means the ancillary data was cut short so the credentials
    # cannot be trusted even if the header looks plausible.
    var mflags = load32(&mh + 48);
    if (mflags & 8 != 0) { _notify_last = NOTIFY_RECV_TRUNCATED; return 0; }   # MSG_CTRUNC
    if (ctrllen < 28) { _notify_last = NOTIFY_RECV_NOCRED; return 0; }
    var cmsg_len = load64(&ctrl);
    if (cmsg_len < 28) { _notify_last = NOTIFY_RECV_NOCRED; return 0; }
    var cmsg_level = load32(&ctrl + 8);
    var cmsg_type  = load32(&ctrl + 12);
    if (cmsg_level != 1 || cmsg_type != 2) {                 # SOL_SOCKET=1, SCM_CREDENTIALS=2
        _notify_last = NOTIFY_RECV_NOCRED;
        return 0;
    }
    var sender_pid = load32(&ctrl + 16);
    _notify_sender_pid = sender_pid;
    _notify_sender_uid = load32(&ctrl + 20);
    if (pid_in_vec(expected_pids, sender_pid) == 0) {
        _notify_last = NOTIFY_RECV_UNATTRIBUTED;
        return 0;
    }
    _notify_last = NOTIFY_RECV_OK;
    return notify_parse(_notify_recv_buf, n);
}

# Why the last outcome and the sender identity are exposed.
#
# ⚠ RETURNING A BARE 0 FOR FOUR DIFFERENT OUTCOMES IS A DEFECT, NOT A
# SIMPLIFICATION. Until 1.13.5 this function answered 0 for "queue empty",
# "ancillary truncated", "no or wrong SCM_CREDENTIALS" and "sender is not a
# known service pid" alike. Two consequences, both real:
#
#   - The drain loop in init_poll_health `break`s on 0, so ONE forged datagram
#     per tick truncated the drain and starved every legitimate message queued
#     behind it. A local attacker could silence sd_notify entirely by sending
#     one bad datagram per tick.
#   - The caller could not tell a spoofing attempt from an idle socket, so
#     there was nothing to log or rate-limit. That is standing rule 29's shape:
#     the middle arm looks like success and is not.
#
# It also DISCARDED the authenticated sender pid it had just validated, so a
# consumer could prove a datagram came from *a* service but never *which* —
# and every sd_notify verb (READY, WATCHDOG, MAINPID) needs that attribution.
# kybernet wrote its own stricter receive at 1.6.3 rather than wait; exposing
# these lets the two converge.
fn notify_recv_outcome()   { return _notify_last; }
fn notify_recv_sender_pid() { return _notify_sender_pid; }
fn notify_recv_sender_uid() { return _notify_sender_uid; }

# Try to receive a notification without blocking.
# Returns a NotifyMessage ptr, or 0 if no message available.
fn notify_try_recv(fd) {
    if (_notify_recv_buf == 0) {
        _notify_recv_buf = alloc(1024);
    }
    var n = sys_read(fd, _notify_recv_buf, 1024);
    if (n <= 0) { return 0; }
    return notify_parse(_notify_recv_buf, n);
}

# Drain pending notifications, up to limit.
# Returns vec of NotifyMessage ptrs.
fn notify_drain(fd, limit) {
    var messages = vec_new();
    for (var i = 0; i < limit; i = i + 1) {
        var msg = notify_try_recv(fd);
        if (msg == 0) { break; }
        vec_push(messages, msg);
    }
    return messages;
}

# Send an sd_notify message to a socket path (client side).
fn send_notify(socket_path, message) {
    var fd = sys_socket(1, 2, 0);  # AF_UNIX, SOCK_DGRAM
    if (fd < 0) { return 0 - 1; }

    var addr[110];
    memset(&addr, 0, 110);
    store16(&addr, 1);  # AF_UNIX
    var path_data = str_data(socket_path);
    var path_len = str_len(socket_path);
    if (path_len > 107) { path_len = 107; }
    memcpy(&addr + 2, path_data, path_len);

    var msg_data = str_data(message);
    var msg_len = str_len(message);

    # sendto(fd, msg, len, 0, &addr, addrlen)
    var ret = ag_sys_sendto(fd, msg_data, msg_len, 0, &addr, 2 + path_len + 1);
    sys_close(fd);

    if (ret < 0) { return 0 - 1; }
    return 0;
}
