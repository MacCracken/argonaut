# notify.cyr — sd_notify compatible readiness notification
# Implements server side of the systemd notification protocol.
# Ported from rust-old/src/notify.rs

# =========================================================================
# NotifyMessage — parsed sd_notify fields
# =========================================================================

struct NotifyMessage {
    ready;          # 1/0
    status;         # Str ptr (0 = none)
    main_pid;       # i64 (0 = not set)
    watchdog;       # 1/0
    reloading;      # 1/0
    stopping;       # 1/0
    fields;         # map of key -> value
}

fn notify_msg_new() {
    var msg = alloc(sizeof(NotifyMessage));
    store64(msg, 0);          # ready
    store64(msg + 8, 0);      # status
    store64(msg + 16, 0);     # main_pid
    store64(msg + 24, 0);     # watchdog
    store64(msg + 32, 0);     # reloading
    store64(msg + 40, 0);     # stopping
    # 2026-08-24 audit MEDIUM-1: Str-keyed, NOT cstr-keyed. A cstr map
    # hashes by walking to the next NUL, and notify datagrams arrive off
    # the socket with no terminator — so the walk ran off the end of the
    # receive buffer. map_new_str hashes over the Str's length instead.
    store64(msg + 48, map_new_str());  # fields
    return msg;
}

# 1 if the `n` bytes at `p` are exactly the `litlen`-byte literal `lit`.
# Compares in place: `notify_parse` used to `str_from` each candidate key (and
# the "1" it compared values against) just to call `str_eq` — up to seven
# boxes per field, on every datagram the reactor drains (1.16.1 audit, perf).
fn _notify_is(p, n, lit, litlen) {
    if (n != litlen) { return 0; }
    return memeq(p, lit, n);
}

# 1.16.1 audit A-9: MAINPID's value as a pid, or 0 when it is not one.
# Decimal digits only, 2..2147483647. `str_to_int` skipped any non-digit and
# took a leading '-', so `MAINPID=-1` became -1 (kill(-1, ...) is every
# process the caller may signal), `1x2` became 12, and 99999999999 went
# through as is. 1 is init itself and never a service's main pid.
fn _notify_parse_pid(p, n) {
    if (n <= 0) { return 0; }
    if (n > 10) { return 0; }
    var v = 0;
    for (var i = 0; i < n; i = i + 1) {
        var c = load8(p + i);
        if (c < 48) { return 0; }
        if (c > 57) { return 0; }
        v = v * 10 + (c - 48);
    }
    if (v < 2) { return 0; }
    if (v > 2147483647) { return 0; }
    return v;
}

# Parse an sd_notify message (newline-separated KEY=VALUE pairs)
fn notify_parse(data, len) {
    var msg = notify_msg_new();
    var fields = load64(msg + 48);

    var line_start = 0;
    for (var i = 0; i <= len; i = i + 1) {
        var c = 0;
        if (i < len) { c = load8(data + i); }

        if (c == 10 || i == len) {
            var line_len = i - line_start;
            if (line_len > 0) {
                # Find the first '=' in the line.
                var eq_pos = 0 - 1;
                for (var j = line_start; j < i; j = j + 1) {
                    if (eq_pos < 0 && load8(data + j) == 61) { eq_pos = j; }  # '='
                }
                if (eq_pos > line_start) {
                    # 2026-08-24 audit MEDIUM-1: str_new BORROWS `data`, which
                    # is the shared module-level receive buffer — every later
                    # datagram overwrote the Strs handed back for earlier ones
                    # (notify_drain returned N messages all aliasing the last
                    # one). Each message gets its own bytes: `str_from_buf`
                    # copies (and NUL-terminates) without the throwaway header
                    # `str_clone(str_new(...))` allocated first.
                    var kp = data + line_start;
                    var kn = eq_pos - line_start;
                    var vp = data + eq_pos + 1;
                    var vn = i - eq_pos - 1;
                    var key = str_from_buf(kp, kn);
                    var val = str_from_buf(vp, vn);

                    map_set(fields, key, val);

                    # Match known keys
                    if (_notify_is(kp, kn, "READY", 5)) {
                        store64(msg, _notify_is(vp, vn, "1", 1));
                    } elif (_notify_is(kp, kn, "STATUS", 6)) {
                        store64(msg + 8, val);
                    } elif (_notify_is(kp, kn, "MAINPID", 7)) {
                        store64(msg + 16, _notify_parse_pid(vp, vn));
                    } elif (_notify_is(kp, kn, "WATCHDOG", 8)) {
                        store64(msg + 24, _notify_is(vp, vn, "1", 1));
                    } elif (_notify_is(kp, kn, "RELOADING", 9)) {
                        store64(msg + 32, _notify_is(vp, vn, "1", 1));
                    } elif (_notify_is(kp, kn, "STOPPING", 8)) {
                        store64(msg + 40, _notify_is(vp, vn, "1", 1));
                    }
                }
            }
            line_start = i + 1;
        }
    }

    return msg;
}

# =========================================================================
# NotifyListener — Unix datagram socket listener
# =========================================================================

# Create a notify listener bound to a socket path.
# Returns socket fd or -1 on error.
fn notify_bind(path) {
    # sun_path holds 107 bytes and a NUL. A longer path is REFUSED, not
    # truncated — a shortened path binds (and first unlinks) a different
    # file. 1.16.1 audit.
    var path_len = str_len(path);
    if (path_len <= 0 || path_len > 107) { return 0 - 1; }

    # Build sockaddr_un
    var addr[110];
    memset(&addr, 0, 110);
    store16(&addr, 1);  # AF_UNIX
    memcpy(&addr + 2, str_data(path), path_len);

    # Remove stale socket. Through the NUL-terminated copy in sun_path, not
    # `str_data(path)`: a Str is not NUL-terminated at its length, so a path
    # that is a view into a longer buffer unlinked some other name and the
    # bind below then failed on the stale socket. 1.16.1 audit.
    sys_unlink(&addr + 2);

    # Ensure parent directory exists
    sys_mkdir("/run/argonaut", 448);  # 0o700 — argonaut-internal; no other process should traverse

    # socket(AF_UNIX=1, SOCK_DGRAM=2 | SOCK_CLOEXEC=0x80000, 0)
    # 1.16.1 audit A-8: close-on-exec. Without it every service PID 1 spawned
    # inherited the notify fd and could read — and so swallow — the other
    # services' READY / WATCHDOG datagrams. 0x80000 is SOCK_CLOEXEC on both
    # x86_64 and aarch64.
    var fd = sys_socket(1, 2 | 0x80000, 0);
    if (fd < 0) { return 0 - 1; }

    # bind(fd, &addr, sizeof(sa_family) + path_len + 1)
    var ret = sys_bind(fd, &addr, 2 + path_len + 1);
    if (ret < 0) {
        sys_close(fd);
        return 0 - 1;
    }

    # Set non-blocking
    sys_fcntl(fd, 4, 2048);  # F_SETFL O_NONBLOCK

    # M1: enable SO_PASSCRED so recvmsg() with SCM_CREDENTIALS gives us
    # the kernel-stamped sender credentials. notify_try_recv_authenticated
    # below relies on this for the per-datagram peer-cred check.
    # 1.16.1 audit A-8: checked. A socket without it delivers no credentials,
    # so every datagram would be dropped as NOCRED — a listener that is bound
    # and can never accept anything. Fail the bind instead.
    var one[4];
    store32(&one, 1);
    if (sys_setsockopt(fd, 1, 16, &one, 4) < 0) {   # SOL_SOCKET=1, SO_PASSCRED=16
        sys_close(fd);
        return 0 - 1;
    }

    return fd;
}

# Shared recv buffer — allocated once on first call
var _notify_recv_buf = 0;

# pid_in_vec — linear membership test for tiny pid sets (running services).
fn pid_in_vec(pids, pid) {
    if (pids == 0) { return 0; }
    for (var i = 0; i < vec_len(pids); i = i + 1) {
        if (vec_get(pids, i) == pid) { return 1; }
    }
    return 0;
}

# notify_try_recv_authenticated — M1 (sd_notify SO_PEERCRED check).
# recvmsg() variant that requires the SCM_CREDENTIALS ancillary the
# kernel attaches when SO_PASSCRED is enabled (notify_bind sets it).
# Drops any datagram whose sender PID is NOT in the expected_pids vec —
# blocks the spoofing primitive where a local attacker on the notify
# socket fakes READY=1 / WATCHDOG=1 for a service they don't own.
# Returns NotifyMessage ptr on accept; 0 on (no message OR rejected).
# Outcome of the most recent notify_try_recv_authenticated call.
enum NotifyRecvOutcome {
    NOTIFY_RECV_EMPTY = 0;         # nothing queued — the ONLY "stop draining"
    NOTIFY_RECV_OK = 1;            # authenticated and attributed
    NOTIFY_RECV_NOCRED = 2;        # consumed; no/invalid SCM_CREDENTIALS
    NOTIFY_RECV_TRUNCATED = 3;     # consumed; MSG_CTRUNC (credentials) or MSG_TRUNC (payload) cut short
    NOTIFY_RECV_UNATTRIBUTED = 4;  # consumed; authenticated but not a known service pid
}

var _notify_last = 0;
var _notify_sender_pid = 0;
var _notify_sender_uid = 0;

# 1.16.2: the one recvmsg both receive paths share. Reads one datagram into
# _notify_recv_buf without blocking (MSG_DONTWAIT). `ctrl` / `ctrllen` is the
# ancillary buffer, or 0 / 0 for none. Returns recvmsg's result and leaves the
# received msg_flags in _notify_rflags and msg_controllen in _notify_rctrllen.
var _notify_rflags = 0;
var _notify_rctrllen = 0;

fn _notify_recvmsg(fd, ctrl, ctrllen) {
    if (_notify_recv_buf == 0) {
        _notify_recv_buf = alloc(1024);
    }
    # iovec { base, len }
    var iov[16];
    store64(&iov, _notify_recv_buf);
    store64(&iov + 8, 1024);
    # msghdr { name, namelen, iov, iovlen, control, controllen, flags }
    var mh[56];
    memset(&mh, 0, 56);
    store64(&mh + 16, &iov);     # msg_iov
    store64(&mh + 24, 1);        # msg_iovlen
    store64(&mh + 32, ctrl);     # msg_control
    store64(&mh + 40, ctrllen);  # msg_controllen
    # recvmsg(fd, &mh, MSG_DONTWAIT=64)
    var n = sys_recvmsg(fd, &mh, 64);
    _notify_rflags = load32(&mh + 48);
    _notify_rctrllen = load64(&mh + 40);
    return n;
}

# Close every descriptor a sender passed with SCM_RIGHTS in the received
# control data (`ctrllen` bytes at `ctrl`). 1.16.2: on a socket without
# SO_PASSCRED the control buffer has room for one SCM_RIGHTS header, so the
# kernel INSTALLED the sender's fds in this process; the datagram was then
# refused for lacking credentials and the fds stayed open in PID 1 for good,
# one leak per datagram from anyone who can reach the socket. Walks each
# cmsghdr {len u64, level u32, type u32, data} at its 8-byte-aligned stride.
fn _notify_close_passed_fds(ctrl, ctrllen) {
    var off = 0;
    var walking = 1;
    while (walking == 1) {
        if (off + 16 > ctrllen) {
            walking = 0;
        } else {
            var clen = load64(ctrl + off);
            if (clen < 16) {
                walking = 0;
            } else {
                var avail = ctrllen - off;
                if (clen < avail) { avail = clen; }
                if (load32(ctrl + off + 8) == 1) {          # SOL_SOCKET
                    if (load32(ctrl + off + 12) == 1) {     # SCM_RIGHTS
                        var nfd = (avail - 16) / 4;
                        for (var k = 0; k < nfd; k = k + 1) {
                            var pfd = load32(ctrl + off + 16 + k * 4);
                            if (pfd >= 0) { sys_close(pfd); }
                        }
                    }
                }
                off = off + ((clen + 7) & (0 - 8));
            }
        }
    }
    return 0;
}

fn notify_try_recv_authenticated(fd, expected_pids) {
    # control buffer for one SCM_CREDENTIALS (cmsghdr 16 + ucred 12, aligned to 32)
    var ctrl[32];
    memset(&ctrl, 0, 32);
    _notify_last = NOTIFY_RECV_EMPTY;
    var n = _notify_recvmsg(fd, &ctrl, 32);
    if (n < 0) { return 0; }
    # 1.16.2: before any verdict, close whatever descriptors came with it.
    var rcv_ctrl = _notify_rctrllen;
    if (rcv_ctrl > 32) { rcv_ctrl = 32; }
    _notify_close_passed_fds(&ctrl, rcv_ctrl);
    # A zero-length datagram is legal on AF_UNIX SOCK_DGRAM and recvmsg
    # returns 0 having CONSUMED it — reporting that as "queue empty" ends the
    # drain early, which is the same starvation this change exists to fix.
    if (n == 0) { _notify_last = NOTIFY_RECV_NOCRED; return 0; }
    # Require an SCM_CREDENTIALS cmsg. Drop on missing/wrong type so a
    # caller that forgets SO_PASSCRED can't slip messages through.
    var ctrllen = _notify_rctrllen;
    # Stricter than `< 16`: a cmsghdr(16) plus a struct ucred(12) is 28 bytes,
    # and MSG_CTRUNC means the ancillary data was cut short so the credentials
    # cannot be trusted even if the header looks plausible.
    var mflags = _notify_rflags;
    if ((mflags & 8) != 0) { _notify_last = NOTIFY_RECV_TRUNCATED; return 0; }   # MSG_CTRUNC
    # 1.16.1 audit A-9: MSG_TRUNC — the datagram was longer than the receive
    # buffer and its tail is gone. Parsing the head acted on a message the
    # sender never sent: a cut can land inside a value (`MAINPID=12345`
    # arriving as `MAINPID=12`). Dropped, and reported as truncated so the
    # drain carries on past it.
    if ((mflags & 0x20) != 0) { _notify_last = NOTIFY_RECV_TRUNCATED; return 0; }
    if (ctrllen < 28) { _notify_last = NOTIFY_RECV_NOCRED; return 0; }
    var cmsg_len = load64(&ctrl);
    if (cmsg_len < 28) { _notify_last = NOTIFY_RECV_NOCRED; return 0; }
    var cmsg_level = load32(&ctrl + 8);
    var cmsg_type  = load32(&ctrl + 12);
    if (cmsg_level != 1 || cmsg_type != 2) {                 # SOL_SOCKET=1, SCM_CREDENTIALS=2
        _notify_last = NOTIFY_RECV_NOCRED;
        return 0;
    }
    var sender_pid = load32(&ctrl + 16);
    _notify_sender_pid = sender_pid;
    _notify_sender_uid = load32(&ctrl + 20);
    if (pid_in_vec(expected_pids, sender_pid) == 0) {
        _notify_last = NOTIFY_RECV_UNATTRIBUTED;
        return 0;
    }
    _notify_last = NOTIFY_RECV_OK;
    return notify_parse(_notify_recv_buf, n);
}

# Why the last outcome and the sender identity are exposed.
#
# ⚠ RETURNING A BARE 0 FOR FOUR DIFFERENT OUTCOMES IS A DEFECT, NOT A
# SIMPLIFICATION. Until 1.13.5 this function answered 0 for "queue empty",
# "ancillary truncated", "no or wrong SCM_CREDENTIALS" and "sender is not a
# known service pid" alike. Two consequences, both real:
#
#   - The drain loop in init_poll_health `break`s on 0, so ONE forged datagram
#     per tick truncated the drain and starved every legitimate message queued
#     behind it. A local attacker could silence sd_notify entirely by sending
#     one bad datagram per tick.
#   - The caller could not tell a spoofing attempt from an idle socket, so
#     there was nothing to log or rate-limit. That is standing rule 29's shape:
#     the middle arm looks like success and is not.
#
# It also DISCARDED the authenticated sender pid it had just validated, so a
# consumer could prove a datagram came from *a* service but never *which* —
# and every sd_notify verb (READY, WATCHDOG, MAINPID) needs that attribution.
# kybernet wrote its own stricter receive at 1.6.3 rather than wait; exposing
# these lets the two converge.
fn notify_recv_outcome()   { return _notify_last; }
fn notify_recv_sender_pid() { return _notify_sender_pid; }
fn notify_recv_sender_uid() { return _notify_sender_uid; }

# The unauthenticated receive behind notify_try_recv / notify_drain.
# Returns a NotifyMessage ptr, or 0. _notify_unauth_consumed is 1 when a
# datagram was taken off the queue (parsed or dropped), 0 when none was queued.
#
# 1.16.2 (a LOW the 1.16.1 audit left open; A-9's unauthenticated half):
# recvmsg, not sys_read. read(2) cannot see MSG_TRUNC, so a datagram longer
# than the buffer was parsed from its head — a cut inside `MAINPID=12345`
# delivered `MAINPID=12`. A truncated datagram is now dropped. No control
# buffer is passed: credentials are not checked on this path, and a
# descriptor sent with SCM_RIGHTS must not be installed in PID 1 (with no
# room for it the kernel discards it and sets MSG_CTRUNC, ignored here).
var _notify_unauth_consumed = 0;

fn _notify_recv_unauth(fd) {
    _notify_unauth_consumed = 0;
    var n = _notify_recvmsg(fd, 0, 0);
    if (n < 0) { return 0; }
    _notify_unauth_consumed = 1;
    if (n == 0) { return 0; }
    if ((_notify_rflags & 0x20) != 0) { return 0; }   # MSG_TRUNC
    return notify_parse(_notify_recv_buf, n);
}

# Try to receive a notification without blocking.
# Returns a NotifyMessage ptr, or 0 if no message available — or if the one
# taken was empty or truncated (dropped, never half-parsed).
# Deprecated at 1.16.2: no sender check, so any local process that can reach
# the socket can claim READY=1 / WATCHDOG=1 / MAINPID= for a service.
#deprecated("use notify_try_recv_authenticated: this skips sender authentication; removal planned for 1.17.0")
fn notify_try_recv(fd) {
    return _notify_recv_unauth(fd);
}

# Drain pending notifications, up to limit.
# Returns vec of NotifyMessage ptrs. A dropped (empty or truncated) datagram
# counts toward `limit` but does not end the drain; only an empty queue does.
#deprecated("use notify_try_recv_authenticated in a loop: this skips sender authentication; removal planned for 1.17.0")
fn notify_drain(fd, limit) {
    var messages = vec_new();
    var draining = 1;
    var i = 0;
    while (draining == 1 && i < limit) {
        var msg = _notify_recv_unauth(fd);
        if (msg != 0) {
            vec_push(messages, msg);
        } elif (_notify_unauth_consumed == 0) {
            draining = 0;
        }
        i = i + 1;
    }
    return messages;
}

# Send an sd_notify message to a socket path (client side).
fn send_notify(socket_path, message) {
    var fd = sys_socket(1, 2, 0);  # AF_UNIX, SOCK_DGRAM
    if (fd < 0) { return 0 - 1; }

    var addr[110];
    memset(&addr, 0, 110);
    store16(&addr, 1);  # AF_UNIX
    var path_data = str_data(socket_path);
    var path_len = str_len(socket_path);
    # Refused, not truncated: a shortened path is another socket (1.16.1 audit).
    if (path_len > 107) {
        sys_close(fd);
        return 0 - 1;
    }
    memcpy(&addr + 2, path_data, path_len);

    var msg_data = str_data(message);
    var msg_len = str_len(message);

    # sendto(fd, msg, len, 0, &addr, addrlen)
    var ret = sys_sendto(fd, msg_data, msg_len, 0, &addr, 2 + path_len + 1);
    sys_close(fd);

    if (ret < 0) { return 0 - 1; }
    return 0;
}
