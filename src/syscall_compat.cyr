# syscall_compat.cyr — arch-dispatched wrappers for the syscalls the cyrius
# stdlib does not wrap (1.13.1).
#
# WHY THIS FILE EXISTS
# --------------------
# A literal `syscall(N, ...)` with an x86_64 number is a portability defect:
# argonaut is cross-built for aarch64 and linked into kybernet's aarch64 PID-1
# binary, where the same N names a completely different syscall. Before 1.13.1
# argonaut carried nine such numbers; measured under qemu-user, they landed on:
#
#     x86 35  nanosleep   -> aarch64 unlinkat      (service stop/poll loops)
#     x86 44  sendto      -> aarch64 fstatfs       (sd_notify client send)
#     x86 47  recvmsg     -> aarch64 fallocate     (sd_notify server recv)
#     x86 53  socketpair  -> aarch64 fchmodat      (test harness)
#     x86 87  unlink      -> aarch64 timerfd_gettime
#     x86 90  chmod       -> aarch64 capget        (test harness)
#     x86 112 setsid      -> aarch64 clock_settime (per-service session)
#     x86 124 getsid      -> aarch64 sched_yield   (test harness)
#     x86 157 prctl       -> aarch64 setsid        (PR_SET_CHILD_SUBREAPER)
#
# Prefer a stdlib `sys_*` wrapper wherever one exists — it is already
# arch-dispatched through lib/syscalls.cyr. This file covers only the gaps.
#
# ⚠ THE ESYSXLAT TRAP — read before adding an entry here.
# The aarch64 backend emits an inline x86-compat translation ladder at every
# `syscall` site, rewriting a set of x86 source numbers to their aarch64
# equivalents (including argument fixups). Two consequences:
#
#   (a) Some raw x86 numbers already work on aarch64 (0/1 read/write, 7 poll,
#       41 socket, 42 connect, 49 bind, 54 setsockopt, 55 getsockopt, 72 fcntl,
#       228 clock_gettime). They are still spelled out explicitly below or
#       routed through a `sys_*` wrapper — relying on an undocumented compat
#       ladder is exactly the fragility audit rule 1 exists to remove.
#
#   (b) An aarch64-NATIVE number can be CLAIMED by that ladder as an x86 source
#       number and rewritten out from under you. `73` is the live example:
#       aarch64 ppoll is 73, but the ladder reads 73 as x86 `flock` and rewrites
#       it to 32. Verified: `syscall(73, ...)` on aarch64 issues flock(2), not
#       ppoll(2). That is why `ag_sys_poll` below routes through the x86 number
#       on BOTH arches rather than using the native one.
#
# Every number in this file was verified by cross-building a probe and reading
# the actual kernel entry under `qemu-aarch64 -strace`. Re-verify that way
# before changing one; a wrong number here is silent on x86 and fatal on ARM.
#
# sendto and fcntl are not gaps. argonaut calls the stdlib's `sys_sendto` and
# `sys_fcntl`, which dispatch through `SYS_SENDTO` (x86 44 / aarch64 206) and
# `SYS_FCNTL` (x86 72 / aarch64 25).

# getsockopt(fd, level, optname, optval, optlen) — SO_ERROR readback after a
# non-blocking connect. No stdlib wrapper: the stdlib has `sys_setsockopt` on
# every target but no `sys_getsockopt`.
# x86_64 55 (native) / aarch64 209 (native, ladder-safe).
fn ag_sys_getsockopt(fd, level, optname, optval, optlen): i64 {
    #ifdef CYRIUS_ARCH_X86
    return syscall(55, fd, level, optname, optval, optlen);
    #endif
    #ifdef CYRIUS_ARCH_AARCH64
    return syscall(209, fd, level, optname, optval, optlen);
    #endif
}

# poll(fds, nfds, timeout_ms) — readiness wait for the TCP/HTTP health checks,
# with poll(2)'s millisecond timeout, issued as the stdlib's `sys_ppoll`.
#
# aarch64 has no `poll`, only ppoll, which takes a `struct timespec`. Until
# 1.16.1 this issued x86 poll (7) on both arches and relied on the aarch64
# translation to rewrite it into ppoll with the conversion. `sys_ppoll`
# (cyrius 6.7.9+) reaches ppoll directly on every Linux target (x86_64 271,
# aarch64 73), so the conversion lives here: a negative timeout is a NULL
# timespec (no timeout), anything else is {ms / 1000, (ms % 1000) * 1e6}.
# No signal mask is passed. `ts` is static storage, written in full on every
# call (the kernel may write the remaining time back into it).
# `tests/tcyr/poll_ms.tcyr` pins the contract on both arches.
fn ag_sys_poll(fds, nfds, timeout_ms): i64 {
    if (timeout_ms < 0) { return sys_ppoll(fds, nfds, 0, 0, 8); }
    var ts[16];
    store64(&ts, timeout_ms / 1000);
    store64(&ts + 8, (timeout_ms % 1000) * 1000000);
    return sys_ppoll(fds, nfds, &ts, 0, 8);
}

# clock_gettime(clockid, timespec) — backs now_ms / monotonic_ms.
# x86_64 228 (native) / aarch64 113 (native, ladder-safe).
fn ag_sys_clock_gettime(clockid, ts): i64 {
    #ifdef CYRIUS_ARCH_X86
    return syscall(228, clockid, ts);
    #endif
    #ifdef CYRIUS_ARCH_AARCH64
    return syscall(113, clockid, ts);
    #endif
}

# setpgid(pid, pgid) — puts a timed child in its own process group, so a
# timeout can signal the whole group (1.16.1). No stdlib wrapper.
# x86_64 109 (native) / aarch64 154 (native, ladder-safe).
fn ag_sys_setpgid(pid, pgid): i64 {
    #ifdef CYRIUS_ARCH_X86
    return syscall(109, pid, pgid);
    #endif
    #ifdef CYRIUS_ARCH_AARCH64
    return syscall(154, pid, pgid);
    #endif
}

# getsid(pid) — test-harness assertion that fork_exec_service called setsid.
# x86_64 124 (native) / aarch64 156 (native, ladder-safe).
fn ag_sys_getsid(pid): i64 {
    #ifdef CYRIUS_ARCH_X86
    return syscall(124, pid);
    #endif
    #ifdef CYRIUS_ARCH_AARCH64
    return syscall(156, pid);
    #endif
}
