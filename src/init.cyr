# init.cyr — ArgonautInit orchestrator
# Main init system state and orchestration logic.
# Ported from rust-old/src/lib.rs

# =========================================================================
# ArgonautInit — the main init system struct
# =========================================================================

struct ArgonautInit {
    config;              # ptr to ArgonautConfig
    boot_sequence;       # vec of BootStep ptrs
    services;            # map of name (cstr) -> ManagedService ptr
    boot_started;        # epoch ms (0 = not started)
    boot_completed;      # epoch ms (0 = not completed)
    audit_log;           # libro AuditChain ptr (in-memory)
    notify_fd;           # M1 — sd_notify socket fd, -1 = not bound
    persistent_audit;    # 1.5.3 — PersistentAuditLog wrapper, 0 = in-memory only
}

fn argonaut_init_new(config) {
    sakshi_span_enter("init_new", 8);
    var init = alloc(sizeof(ArgonautInit));
    var mode = config_boot_mode(config);

    store64(init, config);
    store64(init + 8, build_boot_sequence(mode));

    # Register default services
    var svc_map = map_new();
    var defaults = default_services(mode);
    for (var i = 0; i < vec_len(defaults); i = i + 1) {
        var sd = vec_get(defaults, i);
        var ms = managed_svc_new(sd);
        map_set(svc_map, str_data(svc_def_name(sd)), ms);
    }

    # Also register extra services from config
    var cfg_svcs = config_services(config);
    for (var i = 0; i < vec_len(cfg_svcs); i = i + 1) {
        var sd = vec_get(cfg_svcs, i);
        var name = str_data(svc_def_name(sd));
        if (map_has(svc_map, name) == 0) {
            map_set(svc_map, name, managed_svc_new(sd));
        }
    }

    store64(init + 16, svc_map);
    store64(init + 24, 0);  # boot_started
    store64(init + 32, 0);  # boot_completed

    # Audit log: in-memory by default; opt-in PatraStore persistence
    # (1.5.3) when `config.audit_persist == 1`. `init + 40` is always
    # a usable AuditChain pointer (callers using `init_audit_log`
    # see chain semantics regardless of persistence); `init + 56` is
    # the wrapper ptr (0 if in-memory) used by the dispatch helpers
    # `init_audit_record` / `init_audit_flush`.
    if (config_audit_persist(config) == 1) {
        var pal = audit_log_open_persistent(config_audit_path(config));
        if (pal == 0) {
            # Persistence requested but failed (read-only fs, bad path);
            # fall back to in-memory so init still completes. Caller
            # checks `init_audit_log_persistent(init) == 0` to detect.
            store64(init + 40, argonaut_audit_log_new());
            store64(init + 56, 0);
        } else {
            store64(init + 40, pal_chain(pal));
            store64(init + 56, pal);
        }
    } else {
        store64(init + 40, argonaut_audit_log_new());
        store64(init + 56, 0);
    }
    store64(init + 48, 0 - 1);            # notify_fd (M1) — opt-in via init_notify_bind

    proc_table_init();

    # M3: enrol as a child subreaper so orphans whose original parents
    # exited get reparented to argonaut (rather than the literal PID 1
    # under a systemd-delegate consumer). Non-fatal — kernels predating
    # PR_SET_CHILD_SUBREAPER (Linux < 3.4) just return EINVAL and we
    # continue with tracked-PID reaping only.
    sys_prctl(36, 1, 0, 0, 0);   # PR_SET_CHILD_SUBREAPER=36

    sakshi_span_exit();
    return init;
}

fn init_audit_log(init) { return load64(init + 40); }

# The boot sequence for this init's mode — a vec of BootStep. Added 1.10.1
# so a consumer can inspect step status (COMPLETE / FAILED / SKIPPED)
# without reaching into the struct by offset.
fn init_boot_sequence(init) { return load64(init + 8); }
fn init_notify_fd(init) { return load64(init + 48); }

# 1.5.3 — opt-in persistent audit log accessors.
# `init_audit_log_persistent(init)` returns the PersistentAuditLog
# wrapper ptr (0 if config.audit_persist was off or open failed).
# Use `init_audit_record(init, ...)` to record events that should be
# write-through to disk; it dispatches to in-memory or PatraStore
# automatically. `init_audit_flush(init)` forces fsync if persistent
# (no-op otherwise) — call before shutdown so the chain reflects the
# final state.
fn init_audit_log_persistent(init) { return load64(init + 56); }

fn init_audit_record(init, service, event_type) {
    var pal = load64(init + 56);
    if (pal == 0) {
        return audit_log_record(load64(init + 40), service, event_type);
    }
    return audit_log_record_persistent(pal, service, event_type);
}

fn init_audit_flush(init) {
    var pal = load64(init + 56);
    if (pal == 0) { return 0; }
    return audit_log_flush_persistent(pal);
}

# init_notify_bind — opt-in sd_notify socket binding (M1).
# Consumers (kybernet, AGNOS PID-1 boot) call this to enable
# authenticated notify polling. Returns the fd or -1 on bind failure.
# notify_bind enables SO_PASSCRED so init_poll_health's drain loop
# can verify SCM_CREDENTIALS sender PIDs.
fn init_notify_bind(init, path) {
    var fd = notify_bind(path);
    store64(init + 48, fd);
    return fd;
}

# =========================================================================
# Boot step management
# =========================================================================

fn init_mark_step_complete(init, stage) {
    var steps = load64(init + 8);
    for (var i = 0; i < vec_len(steps); i = i + 1) {
        var step = vec_get(steps, i);
        if (load64(step) == stage) {
            if (load64(step + 40) == 0) {
                store64(step + 40, now_ms());
            }
            if (load64(init + 24) == 0) {
                store64(init + 24, load64(step + 40));
            }
            store64(step + 32, STEP_COMPLETE);
            store64(step + 48, now_ms());

            var sname = boot_stage_str(stage);
            sakshi_info(sname, strlen(sname));

            if (stage == STAGE_BOOT_COMPLETE) {
                store64(init + 32, now_ms());
                sakshi_info("boot complete", 13);
            }
            return 1;
        }
    }
    return 0;
}

fn init_mark_step_failed(init, stage, error_msg) {
    var steps = load64(init + 8);
    for (var i = 0; i < vec_len(steps); i = i + 1) {
        var step = vec_get(steps, i);
        if (load64(step) == stage) {
            if (load64(step + 40) == 0) {
                store64(step + 40, now_ms());
            }
            if (load64(init + 24) == 0) {
                store64(init + 24, load64(step + 40));
            }
            store64(step + 32, STEP_FAILED);
            store64(step + 48, now_ms());
            store64(step + 56, error_msg);

            var sname = boot_stage_str(stage);
            sakshi_error(sname, strlen(sname));

            return 1;
        }
    }
    return 0;
}

# Mark a step SKIPPED — the stage does not apply to this deployment, as
# distinct from COMPLETE (it ran and succeeded) or FAILED (it ran and did
# not).
#
# Added 1.10.1. STEP_SKIPPED has existed as a status since the enum was
# written, and init_is_boot_complete has always accepted it — but nothing
# could ever SET it, so a consumer with a stage it does not perform had
# only two options: mark it COMPLETE and lie, or mark it FAILED and abort
# a boot that is fine. kybernet took the first (its execute_boot_stage
# returned 1 for all eleven stages), which is why its whole boot-stage
# apparatus reported success it never earned.
fn init_mark_step_skipped(init, stage, reason) {
    var steps = load64(init + 8);
    for (var i = 0; i < vec_len(steps); i = i + 1) {
        var step = vec_get(steps, i);
        if (load64(step) == stage) {
            if (load64(step + 40) == 0) {
                store64(step + 40, now_ms());
            }
            store64(step + 32, STEP_SKIPPED);
            store64(step + 48, now_ms());
            store64(step + 56, reason);

            var sname = boot_stage_str(stage);
            sakshi_info(sname, strlen(sname));
            return 1;
        }
    }
    return 0;
}

# Is `name` (a cstr) in a state that counts as "up"?
#
# RUNNING for a long-lived service; for a SVC_ONESHOT, having actually run
# and exited cleanly (STATE_STOPPED with started_at set — a oneshot that
# never ran is also STOPPED, which is why started_at is the discriminator).
# This is the same predicate the dependency check uses, exposed because
# consumers verifying a boot stage need exactly it. Added 1.10.1.
fn init_service_ready(init, name) {
    return _dep_satisfied(init, name);
}

fn init_current_stage(init) {
    var steps = load64(init + 8);
    for (var i = 0; i < vec_len(steps); i = i + 1) {
        var step = vec_get(steps, i);
        var status = load64(step + 32);
        if (status != STEP_COMPLETE && status != STEP_FAILED && status != STEP_SKIPPED) {
            return step;
        }
    }
    return 0;
}

fn init_is_boot_complete(init) {
    var steps = load64(init + 8);
    for (var i = 0; i < vec_len(steps); i = i + 1) {
        var step = vec_get(steps, i);
        var status = load64(step + 32);
        var required = load64(step + 16);
        # Use if/elif/else — multi-continue in one loop body is buggy in cc3
        if (status == STEP_COMPLETE || status == STEP_SKIPPED) {
            # ok
        } elif (required == 0 && status == STEP_FAILED) {
            # ok
        } else {
            return 0;
        }
    }
    return 1;
}

fn init_boot_duration_ms(init) {
    var started = load64(init + 24);
    var completed = load64(init + 32);
    if (started == 0 || completed == 0) { return 0; }
    var dur = completed - started;
    if (dur < 0) { dur = 0; }
    return dur;
}

fn init_failed_steps(init) {
    var failed = vec_new();
    var steps = load64(init + 8);
    for (var i = 0; i < vec_len(steps); i = i + 1) {
        var step = vec_get(steps, i);
        if (load64(step + 32) == STEP_FAILED) {
            vec_push(failed, step);
        }
    }
    return failed;
}

# =========================================================================
# Service state management
# =========================================================================

# ⚠ `name` here is a **cstr**, not a boxed Str. The service map is keyed by
# `str_data(svc_def_name(sd))` (see argonaut_init_new), and every init_*
# function that takes a service name inherits that: init_get_service,
# init_start_service, init_restart_service, init_stop_service,
# init_set_service_state.
#
# This matters because `resolve_service_waves` returns waves of **boxed
# Str** (it pushes `str_from(key)`), so a consumer walking waves into
# init_start_service MUST call `str_data()` on the way. Passing the Str box
# straight through makes `map_get` miss silently and every start returns -1
# — kybernet shipped exactly that latent bug until its 1.5.0. argonaut's own
# call sites convert (see resolve_service_waves' own `str_data(vec_get(...))`).
fn init_get_service(init, name) {
    return map_get(load64(init + 16), name);
}

# Every ServiceDefinition argonaut has registered — defaults for the boot
# mode PLUS anything the config added — in registration order.
#
# Added 1.10.0. Without it a consumer could only see `config_services(cfg)`,
# i.e. the config half, so resolving startup waves over that vec silently
# omitted every default service. kybernet did exactly that: its
# start_services called `resolve_service_waves(config_services(config))`,
# which meant the defaults argonaut had just registered were never started.
fn init_service_defs(init) {
    var out = vec_new();
    var svc_map = load64(init + 16);
    if (svc_map == 0) { return out; }
    var keys = map_keys(svc_map);
    for (var i = 0; i < vec_len(keys); i = i + 1) {
        var ms = map_get(svc_map, vec_get(keys, i));
        if (ms != 0) { vec_push(out, managed_svc_def(ms)); }
    }
    return out;
}

# The registered service names, as **cstrs** — safe to hand straight to
# init_start_service and friends.
fn init_service_names(init) {
    var svc_map = load64(init + 16);
    if (svc_map == 0) { return vec_new(); }
    return map_keys(svc_map);
}

fn init_get_service_state(init, name) {
    var ms = init_get_service(init, name);
    if (ms == 0) { return 0 - 1; }
    return managed_svc_state(ms);
}

# Is dependency `dep_name` (a cstr) satisfied?
#
# A long-lived service satisfies a dependency by RUNNING. A **oneshot**
# never will: init_start_oneshot waits for the process, then sets
# STATE_STOPPED on exit 0 (STATE_FAILED otherwise). So before 1.10.0 the
# check `dep_state != STATE_RUNNING` meant **nothing could ever depend on a
# oneshot** — the dependent's transition to STARTING was refused forever
# and init_start_service returned -1 with no diagnostic. Oneshots are the
# natural way to express "run this migration//setup step before X", so this
# made the whole depends_on feature unusable for the case it exists for.
#
# A oneshot counts as satisfied when it has actually run and exited
# cleanly: STATE_STOPPED *and* started_at != 0. The started_at test is what
# separates "completed successfully" from "never started" — both sit in
# STATE_STOPPED. A failed oneshot lands in STATE_FAILED and is correctly
# not satisfying. This matches systemd's RemainAfterExit semantics for
# ordering.
fn _dep_satisfied(init, dep_name) {
    var dep_ms = init_get_service(init, dep_name);
    if (dep_ms == 0) { return 0; }

    var dep_state = managed_svc_state(dep_ms);
    if (dep_state == STATE_RUNNING) { return 1; }

    if (dep_state == STATE_STOPPED) {
        var dep_sd = managed_svc_def(dep_ms);
        if (svc_def_service_type(dep_sd) == SVC_ONESHOT) {
            if (managed_svc_started(dep_ms) != 0) { return 1; }
        }
    }
    return 0;
}

fn init_set_service_state(init, name, state) {
    var ms = init_get_service(init, name);
    if (ms == 0) { return 0; }

    var current = managed_svc_state(ms);
    if (valid_transition(current, state) == 0) { return 0; }

    # Check dependencies when transitioning to Starting
    if (state == STATE_STARTING) {
        var sd = managed_svc_def(ms);
        var deps = svc_def_deps(sd);
        for (var i = 0; i < vec_len(deps); i = i + 1) {
            var dep_name = str_data(vec_get(deps, i));
            if (_dep_satisfied(init, dep_name) == 0) { return 0; }
        }
    }

    managed_svc_set_state(ms, state);

    # Trace state transition
    var sb = str_builder_new();
    str_builder_add_cstr(sb, name);
    str_builder_add_cstr(sb, " -> ");
    str_builder_add_cstr(sb, service_state_str(state));
    var tmsg = str_builder_build(sb);
    if (state == STATE_FAILED) {
        sakshi_warn(str_data(tmsg), str_len(tmsg));
    } else {
        sakshi_info(str_data(tmsg), str_len(tmsg));
    }

    return 1;
}

# =========================================================================
# Service lifecycle — start, stop, restart
# =========================================================================

fn init_start_service(init, name) {
    sakshi_span_enter(name, strlen(name));
    var ms = init_get_service(init, name);
    if (ms == 0) { sakshi_span_exit(); return 0 - 1; }

    var sd = managed_svc_def(ms);
    if (svc_def_enabled(sd) == 0) { sakshi_span_exit(); return 0 - 1; }

    audit_log_record(load64(init + 40), name, EVT_STARTING);

    if (init_set_service_state(init, name, STATE_STARTING) == 0) {
        return 0 - 1;
    }

    var svc_type = svc_def_service_type(sd);

    var result = 0 - 1;
    # ⚠ SVC_NOTIFY ROUTES HERE TOO. It is spawned exactly like SVC_SIMPLE —
    # fork+exec, no waiting — and differs only in the state it is LEFT in:
    # init_start_simple leaves a notify service STATE_STARTING rather than
    # STATE_RUNNING, so its own authenticated READY=1 is what promotes it.
    #
    # Adding the enum value at 1.13.6 without adding this arm made every
    # `"type": "notify"` service fall to the `else` below and be marked
    # STATE_FAILED with "unknown svc type" — the feature was unreachable from a
    # config file. It was not caught because the test SIMULATED the start by
    # setting the state directly instead of driving this dispatcher. 1.13.7.
    if (svc_type == SVC_SIMPLE || svc_type == SVC_NOTIFY) {
        result = init_start_simple(init, name, ms, sd);
    } elif (svc_type == SVC_ONESHOT) {
        result = init_start_oneshot(init, name, ms, sd);
    } elif (svc_type == SVC_FORKING) {
        result = init_start_forking(init, name, ms, sd);
    } else {
        managed_svc_set_state(ms, STATE_FAILED);
        sakshi_error("unknown svc type", 16);
    }

    sakshi_span_exit();
    return result;
}

fn init_start_simple(init, name, ms, sd) {
    var pid = fork_exec_service(sd);
    if (pid < 0) {
        managed_svc_set_state(ms, STATE_FAILED);
        audit_log_record(load64(init + 40), name, EVT_STOPPED_FAIL);
        return 0 - 1;
    }

    proc_table_insert(svc_def_name(sd), pid);
    managed_svc_set_pid(ms, pid);
    managed_svc_set_started(ms, now_ms());

    # Run ready check if configured
    var rc = svc_def_ready_check(sd);
    if (rc != 0) {
        var result = execute_ready_check(svc_def_name(sd), rc, pid);
        if (load64(result + 16) == 0) {  # not passed
            managed_svc_set_state(ms, STATE_FAILED);
            process_kill(pid);
            # Reap the killed child to avoid zombie leak (PID 1 responsibility)
            var _wb[8];
            sys_waitpid(pid, &_wb, 0);
            proc_table_remove(svc_def_name(sd));
            audit_log_record(load64(init + 40), name, EVT_READY_FAILED);
            return 0 - 1;
        }
        audit_log_record(load64(init + 40), name, EVT_READY_PASSED);
    }

    # ⚠ A SVC_NOTIFY SERVICE IS LEFT STARTING UNTIL IT REPORTS IN.
    # Every other type is RUNNING the instant fork+exec succeeds, which is why
    # sd_notify READY had nowhere to land: no service was ever awaiting a
    # notification. Under SVC_NOTIFY the transition is owned by
    # `init_notify_ready`, driven by an authenticated READY=1 from the service's
    # own pid — systemd's Type=notify contract.
    #
    # `last_notify` is seeded at start so a notify watchdog measures from the
    # spawn, not from epoch 0 (which would fire immediately on the first tick).
    if (svc_def_service_type(sd) == SVC_NOTIFY) {
        managed_svc_set_state(ms, STATE_STARTING);
        managed_svc_set_last_notify(ms, now_ms());
        audit_log_record(load64(init + 40), name, EVT_STARTED);
        return pid;
    }

    managed_svc_set_state(ms, STATE_RUNNING);
    managed_svc_set_last_hc(ms, now_ms());
    managed_svc_set_last_notify(ms, now_ms());
    audit_log_record(load64(init + 40), name, EVT_STARTED);
    return pid;
}

# Mark a SVC_NOTIFY service ready, from an AUTHENTICATED READY=1.
#
# The caller is responsible for having proved the datagram came from this
# service's own pid (SO_PASSCRED + SCM_CREDENTIALS); this function does not and
# cannot re-check that. Returns 1 if the service transitioned, 0 otherwise.
#
# Idempotent and one-way: a second READY on an already-RUNNING service is a
# no-op rather than an error, and READY never moves a service BACKWARDS out of
# RUNNING — a compromised service must not be able to make itself un-ready and
# trigger dependent restarts.
fn init_notify_ready(init, name) {
    var ms = init_get_service(init, name);
    if (ms == 0) { return 0; }
    if (managed_svc_state(ms) != STATE_STARTING) { return 0; }
    managed_svc_set_state(ms, STATE_RUNNING);
    managed_svc_set_last_notify(ms, now_ms());
    audit_log_record(load64(init + 40), name, EVT_READY_PASSED);
    return 1;
}

# Refresh the notify watchdog deadline from an AUTHENTICATED WATCHDOG=1.
#
# ⚠ TOUCHES last_notify ONLY, NEVER last_health_check. Those mean different
# things — "the service said it was alive" versus "a probe argonaut ran and
# observed passing" — and letting a self-report satisfy the health deadline
# would let a wedged service silence a failure argonaut actually saw.
fn init_notify_watchdog(init, name) {
    var ms = init_get_service(init, name);
    if (ms == 0) { return 0; }
    managed_svc_set_last_notify(ms, now_ms());
    return 1;
}

fn init_start_oneshot(init, name, ms, sd) {
    var pid = fork_exec_service(sd);
    if (pid < 0) {
        managed_svc_set_state(ms, STATE_FAILED);
        audit_log_record(load64(init + 40), name, EVT_STOPPED_FAIL);
        return 0 - 1;
    }

    managed_svc_set_pid(ms, pid);
    managed_svc_set_started(ms, now_ms());

    # Wait for completion
    var status_buf[8];
    var ret = sys_waitpid(pid, &status_buf, 0);
    var code = 0 - 1;
    if (ret > 0) {
        var status = load64(&status_buf);
        if (WIFEXITED(status)) { code = WEXITSTATUS(status); }
    }

    managed_svc_set_pid(ms, 0);
    if (code == 0) {
        managed_svc_set_state(ms, STATE_STOPPED);
        audit_log_record(load64(init + 40), name, EVT_STOPPED_OK);
        return 0;
    } else {
        managed_svc_set_state(ms, STATE_FAILED);
        audit_log_record(load64(init + 40), name, EVT_STOPPED_FAIL);
        return 0 - 1;
    }
}

fn init_start_forking(init, name, ms, sd) {
    var pid = fork_exec_service(sd);
    if (pid < 0) {
        managed_svc_set_state(ms, STATE_FAILED);
        audit_log_record(load64(init + 40), name, EVT_STOPPED_FAIL);
        return 0 - 1;
    }

    # Wait for parent to exit
    var status_buf[8];
    var ret = sys_waitpid(pid, &status_buf, 0);
    var code = 0 - 1;
    if (ret > 0) {
        var status = load64(&status_buf);
        if (WIFEXITED(status)) { code = WEXITSTATUS(status); }
    }

    if (code != 0) {
        managed_svc_set_state(ms, STATE_FAILED);
        audit_log_record(load64(init + 40), name, EVT_STOPPED_FAIL);
        return 0 - 1;
    }

    # Read child PID from PID file
    var pid_file = svc_def_pid_file(sd);
    if (pid_file == 0) {
        managed_svc_set_state(ms, STATE_FAILED);
        audit_log_record(load64(init + 40), name, EVT_STOPPED_FAIL);
        return 0 - 1;
    }

    var child_pid = read_pid_file(pid_file);
    if (child_pid < 0) {
        managed_svc_set_state(ms, STATE_FAILED);
        audit_log_record(load64(init + 40), name, EVT_STOPPED_FAIL);
        return 0 - 1;
    }

    proc_table_insert(svc_def_name(sd), child_pid);
    managed_svc_set_pid(ms, child_pid);
    managed_svc_set_started(ms, now_ms());
    managed_svc_set_state(ms, STATE_RUNNING);
    managed_svc_set_last_hc(ms, now_ms());
    audit_log_record(load64(init + 40), name, EVT_STARTED);

    return child_pid;
}

fn init_stop_service(init, name, timeout_ms) {
    sakshi_info(name, strlen(name));
    audit_log_record(load64(init + 40), name, EVT_STOPPING);
    if (init_set_service_state(init, name, STATE_STOPPING) == 0) {
        return 0 - 1;
    }

    var ms = init_get_service(init, name);
    var svc_name = svc_def_name(managed_svc_def(ms));
    var pid = proc_table_pid(svc_name);
    var code = 0;
    if (pid > 0) {
        code = process_stop(pid, timeout_ms);
        proc_table_remove(svc_name);
    }

    managed_svc_set_pid(ms, 0);
    managed_svc_set_state(ms, STATE_STOPPED);

    if (code == 0) {
        audit_log_record(load64(init + 40), name, EVT_STOPPED_OK);
    } else {
        audit_log_record(load64(init + 40), name, EVT_STOPPED_FAIL);
    }

    return code;
}

fn init_restart_service(init, name, stop_timeout_ms) {
    var ms = init_get_service(init, name);
    if (ms == 0) { return 0 - 1; }

    var sd = managed_svc_def(ms);
    var rc = svc_def_restart_config(sd);
    var restarts = managed_svc_restarts(ms);

    if (restart_limit_exceeded(rc, restarts)) {
        sakshi_warn(name, strlen(name));
        return 0 - 1;
    }

    audit_log_record(load64(init + 40), name, EVT_RESTARTING);

    var state = managed_svc_state(ms);
    if (state == STATE_RUNNING || state == STATE_STARTING) {
        init_stop_service(init, name, stop_timeout_ms);
    }

    managed_svc_set_restarts(ms, restarts + 1);
    return init_start_service(init, name);
}

# =========================================================================
# Service reaping
# =========================================================================

# Clear any managed service whose pid appears in a reaped-orphan list.
#
# Walks the service map in place (entries stride 24: key, value, occupied) —
# no map_keys, no allocation; see init_check_watchdog for the same treatment.
# The entry is moved to STATE_STOPPED rather than STATE_FAILED: the exit status
# went to the orphan sweep, so there is no code to judge it by, and inventing
# a failure would restart services that exited cleanly.
fn _init_clear_reaped_pids(init, pids, n) {
    var svc_map = load64(init + 16);
    if (svc_map == 0) { return 0; }
    var entries = map_entries(svc_map);
    var cap = map_cap(svc_map);
    var cleared = 0;

    for (var i = 0; i < cap; i = i + 1) {
        var ep = entries + i * 24;
        if (load64(ep + 16) != 1) { continue; }
        var ms = load64(ep + 8);
        if (ms == 0) { continue; }
        var pid = managed_svc_pid(ms);
        if (pid <= 0) { continue; }

        for (var j = 0; j < n; j = j + 1) {
            if (load64(pids + j * 8) == pid) {
                managed_svc_set_pid(ms, 0);
                managed_svc_set_state(ms, STATE_STOPPED);
                cleared = cleared + 1;
                break;
            }
        }
    }
    return cleared;
}

fn init_reap_services(init) {
    var exited = proc_table_reap();
    # M3: drain orphans whose original parents exited (services that
    # re-fork, daemons whose parents exit). Tracked PIDs handled above;
    # this catches anything reparented to us via PR_SET_CHILD_SUBREAPER
    # (or our PID-1 status, when graduated).
    # ⚠ RECORD THE ORPHAN PIDS AND RECONCILE THE SERVICE TABLE AGAINST THEM.
    # A tracked service that exits in the window between proc_table_reap's probe
    # of its pid and this sweep is collected HERE, not there — and until 1.13.5
    # its pid was discarded, so its entry was never cleared. The next probe
    # returns -ECHILD (not > 0), the entry stays STATE_RUNNING holding a freed
    # pid forever, and any process that recycles that pid is then attributed to
    # that service. Static buffer: this runs on the supervisor tick and must not
    # allocate (the 1.13.4 leak class).
    var orphans[2048];                       # 2048 BYTES == 256 i64 slots (rule 2)
    var on = proc_table_reap_orphans_into(&orphans, 256);
    if (on > 0) { _init_clear_reaped_pids(init, &orphans, on); }

    # 2026-08-24 audit HIGH-2: allocate the results vec LAZILY. The PID-1
    # supervisor loop calls this every 100 ms and discards the return, so an
    # unconditional vec_new() here was pure bump-arena growth in a process
    # that never exits. Idle ticks now allocate nothing.
    var results = 0;

    for (var i = 0; i < vec_len(exited); i = i + 1) {
        var pair = vec_get(exited, i);
        var name = str_data(load64(pair));
        var code = load64(pair + 8);

        var ms = init_get_service(init, name);
        if (ms != 0) {
            managed_svc_set_pid(ms, 0);
            if (code == 0) {
                managed_svc_set_state(ms, STATE_STOPPED);
                audit_log_record(load64(init + 40), name, EVT_STOPPED_OK);
            } else {
                managed_svc_set_state(ms, STATE_FAILED);
                audit_log_record(load64(init + 40), name, EVT_CRASH_DETECTED);
                sakshi_warn(name, strlen(name));
            }

            var action = on_service_crash(ms, code);
            var result = alloc(sizeof(ReapResult));
            store64(result, load64(pair));
            store64(result + 8, code);
            store64(result + 16, action);
            if (results == 0) { results = vec_new(); }
            vec_push(results, result);
        }
    }

    if (results == 0) { return _reap_empty_vec(); }
    return results;
}

# =========================================================================
# Stop all services
# =========================================================================

fn init_stop_all(init, timeout_ms) {
    return proc_table_stop_all(timeout_ms);
}

# =========================================================================
# Statistics
# =========================================================================

fn init_stats(init) {
    var svc_map = load64(init + 16);
    var keys = map_keys(svc_map);
    var running = 0;
    var failed = 0;
    var total_restarts = 0;

    for (var i = 0; i < vec_len(keys); i = i + 1) {
        var ms = map_get(svc_map, vec_get(keys, i));
        var state = managed_svc_state(ms);
        if (state == STATE_RUNNING) { running = running + 1; }
        if (state == STATE_FAILED)  { failed = failed + 1; }
        total_restarts = total_restarts + managed_svc_restarts(ms);
    }

    var stats = alloc(sizeof(ArgonautStats));
    store64(stats, config_boot_mode(load64(init)));
    store64(stats + 8, init_boot_duration_ms(init));
    store64(stats + 16, running);
    store64(stats + 24, failed);
    store64(stats + 32, total_restarts);
    store64(stats + 40, init_is_boot_complete(init));
    return stats;
}

# =========================================================================
# Emergency shell
# =========================================================================

fn init_should_drop_to_emergency(init) {
    var failed = init_failed_steps(init);
    for (var i = 0; i < vec_len(failed); i = i + 1) {
        var step = vec_get(failed, i);
        if (load64(step + 16)) {  # required
            return 1;
        }
    }
    return 0;
}

# =========================================================================
# Watchdog
# =========================================================================

# Memoized empty vec for the idle path — the same treatment proc_table_reap
# already carries. Never mutated; callers only read it.
var _wd_empty = 0;

fn _wd_empty_vec() {
    if (_wd_empty == 0) { _wd_empty = vec_new(); }
    return _wd_empty;
}

# ⚠ ALLOCATES NOTHING ON THE IDLE PATH, AND THAT IS A LEAK FIX.
# This ran on kybernet's watchdog timer — every 10 s in production — and
# allocated TWO vecs per tick unconditionally: `vec_new()` for `timed_out`
# before anything could time out, plus `proc_table_keys()`, which is
# `map_keys` (a fresh vec plus a push per entry). Measured at **304 bytes per
# tick**, i.e. 2.63 MB/day on a completely idle board, in a bump-allocated
# arena PID 1 never resets. The first 256 MB chunk went in ~97 days.
#
# Two changes, both mirroring proc_table_reap (process_mgmt.cyr:643):
#   - iterate the proc table IN PLACE (entries stride 24: key, value,
#     occupied) instead of materialising a key vec;
#   - allocate `timed_out` lazily, only once something has actually timed out.
fn init_check_watchdog(init) {
    var timed_out = 0;
    var entries = map_entries(g_proc_table);
    var cap = map_cap(g_proc_table);

    for (var ki = 0; ki < cap; ki = ki + 1) {
        var ep = entries + ki * 24;
        if (load64(ep + 16) != 1) { continue; }
        var name = load64(ep);
        var ms = init_get_service(init, name);
        if (ms == 0) { continue; }

        var sd = managed_svc_def(ms);
        var state = managed_svc_state(ms);
        var uptime = proc_table_uptime_ms(svc_def_name(sd));

        # Check startup timeout
        if (state == STATE_STARTING) {
            var rc = svc_def_ready_check(sd);
            if (rc != 0) {
                var max_startup = load64(rc + 24);  # timeout_ms
                if (uptime > max_startup) {
                    if (timed_out == 0) { timed_out = vec_new(); }
                    vec_push(timed_out, str_from(name));
                }
            }
        }

        # ⚠ NOTIFY WATCHDOG — INDEPENDENT OF health_check, AND CHECKED FIRST.
        # Until 1.13.6 the only runtime watchdog arm was gated on
        # `svc_def_health_check(sd) != 0`, so a service without a health check
        # had NO watchdog at all and `WATCHDOG=1` had nothing to refresh. This
        # deadline is driven by `last_notify` — what the service SAID — and is
        # deliberately kept apart from the health deadline below, which is
        # driven by `last_hc`, what argonaut OBSERVED. A ping can satisfy the
        # first and must never satisfy the second.
        if (state == STATE_RUNNING || state == STATE_STARTING) {
            var wms = svc_def_watchdog_ms(sd);
            if (wms > 0) {
                var last_n = managed_svc_last_notify(ms);
                var elapsed_n = uptime;
                if (last_n != 0) { elapsed_n = now_ms() - last_n; }
                if (elapsed_n > wms) {
                    if (timed_out == 0) { timed_out = vec_new(); }
                    vec_push(timed_out, str_from(name));
                }
            }
        }

        # Check runtime watchdog
        if (state == STATE_RUNNING) {
            var hc = svc_def_health_check(sd);
            if (hc != 0) {
                var interval = load64(hc + 24);
                var retries = load64(hc + 40);
                var timeout = load64(hc + 32);
                var watchdog_ms = interval * retries + timeout;

                var last_hc = managed_svc_last_hc(ms);
                var elapsed = 0;
                if (last_hc == 0) {
                    elapsed = uptime;
                } else {
                    elapsed = now_ms() - last_hc;
                }

                if (elapsed > watchdog_ms) {
                    if (timed_out == 0) { timed_out = vec_new(); }
                    vec_push(timed_out, str_from(name));
                }
            }
        }
    }

    if (timed_out == 0) { return _wd_empty_vec(); }
    return timed_out;
}

fn init_enforce_watchdog(init) {
    var timed_out = init_check_watchdog(init);

    for (var i = 0; i < vec_len(timed_out); i = i + 1) {
        # `timed_out` holds boxed Str (init_check_watchdog pushes
        # `str_from(name)`); `name` below is the CSTR view of it. Keep both,
        # because this loop calls into two different conventions.
        var name_s = vec_get(timed_out, i);
        var name = str_data(name_s);

        sakshi_error(name, strlen(name));
        audit_log_record(load64(init + 40), name, EVT_TIMEOUT_KILLED);

        # ⚠ proc_table_* TAKE A BOXED Str, NOT A CSTR — every one of them
        # does `str_data(name)` internally (process_mgmt.cyr:480-500). This
        # line passed the cstr, so `str_data("kyb-health")` loaded the first
        # eight characters AS A POINTER and handed that to map_get: a wild
        # dereference, and in a PID-1 consumer a SIGSEGV that panics the
        # kernel with "Attempted to kill init".
        #
        # It survived because nothing had ever reached it. The watchdog's
        # only runtime arm is health-check-driven, and no consumer fixture
        # had ever configured a health_check — kybernet's harness gained one
        # at 1.6.1 and hit this on the first tick that recorded a failure.
        var pid = proc_table_pid(name_s);
        if (pid > 0) {
            process_kill(pid);
            proc_table_remove(name_s);
        }
        var ms = init_get_service(init, name);
        if (ms != 0) {
            managed_svc_set_pid(ms, 0);
            managed_svc_set_state(ms, STATE_FAILED);
        }
    }

    return timed_out;
}

# =========================================================================
# Health polling
# =========================================================================

# Memoized empty vec — see _wd_empty_vec above for the rationale.
var _ph_empty = 0;

fn _ph_empty_vec() {
    if (_ph_empty == 0) { _ph_empty = vec_new(); }
    return _ph_empty;
}

# ⚠ IDLE PATH ALLOCATES NOTHING. This runs on kybernet's health timer (every
# 30 s in production) and used to allocate `results` plus a `map_keys` vec on
# every tick whether or not a single service had a health_check configured —
# and most do not, so the common case was pure waste in an arena PID 1 never
# resets. Same fix as init_check_watchdog: iterate the service map in place,
# allocate `results` only once a check has actually produced one.
fn init_poll_health(init, tracker) {
    var results = 0;
    var svc_map = load64(init + 16);
    var entries = map_entries(svc_map);
    var cap = map_cap(svc_map);

    for (var i = 0; i < cap; i = i + 1) {
        var ep = entries + i * 24;
        if (load64(ep + 16) != 1) { continue; }
        var name = load64(ep);
        var ms = load64(ep + 8);
        if (managed_svc_state(ms) == STATE_RUNNING) {
            var sd = managed_svc_def(ms);
            var hc = svc_def_health_check(sd);
            if (hc != 0) {
                var pid = managed_svc_pid(ms);
                var result = execute_health_check(svc_def_name(sd), hc, pid);
                var threshold = load64(hc + 40);
                var hc_passed = load64(result + 16);
                health_tracker_record(tracker, name, hc_passed, threshold);
                if (hc_passed) {
                    managed_svc_set_last_hc(ms, now_ms());
                    audit_log_record(load64(init + 40), name, EVT_HEALTH_PASSED);
                } else {
                    sakshi_warn(name, strlen(name));
                    audit_log_record(load64(init + 40), name, EVT_HEALTH_FAILED);
                }
                if (results == 0) { results = vec_new(); }
                vec_push(results, result);
            }
        }
    }

    # M1: drain authenticated sd_notify messages for running services.
    # SO_PEERCRED check via SCM_CREDENTIALS drops any datagram whose
    # sender PID isn't in the running-services set, blocking the spoof
    # vector once /run/argonaut is reachable. For 1.5.0 we consume +
    # discard the verified messages; full READY/WATCHDOG/MAINPID
    # propagation into managed state ships with the QEMU PID-1 harness.
    var nfd = load64(init + 48);
    if (nfd > 0) {
        var expected = vec_new();
        for (var j = 0; j < cap; j = j + 1) {
            var epj = entries + j * 24;
            if (load64(epj + 16) != 1) { continue; }
            var msj = load64(epj + 8);
            var pidj = managed_svc_pid(msj);
            if (pidj > 0 && managed_svc_state(msj) == STATE_RUNNING) {
                vec_push(expected, pidj);
            }
        }
        # ⚠ ONLY AN EMPTY QUEUE ENDS THE DRAIN. This loop used to `break` on a
        # bare 0, which the receive returned for rejection as well as for
        # emptiness — so one forged datagram per tick truncated the drain and
        # starved every legitimate message behind it. Now that the outcome is
        # distinguishable (1.13.5), a rejected datagram is counted and the loop
        # continues; it has already been consumed by the recvmsg either way.
        for (var dg = 0; dg < 32; dg = dg + 1) {
            var nm = notify_try_recv_authenticated(nfd, expected);
            if (nm == 0 && notify_recv_outcome() == NOTIFY_RECV_EMPTY) { break; }
        }
    }

    if (results == 0) { return _ph_empty_vec(); }
    return results;
}

# =========================================================================
# Shutdown planning
# =========================================================================

fn init_plan_shutdown(init, shutdown_type) {
    sakshi_span_enter("shutdown", 8);
    var steps = vec_new();
    var config = load64(init);

    # Wall message
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "AGNOS system ");
    str_builder_add_cstr(sb, shutdown_type_str(shutdown_type));
    str_builder_add_cstr(sb, " in ");
    str_builder_add_int(sb, config_shutdown_timeout(config) / 1000);
    str_builder_add_cstr(sb, " seconds");
    var wall_msg = str_builder_build(sb);

    vec_push(steps, shutdown_step_new(str_from("Broadcast shutdown warning"), SA_WALL_MESSAGE, wall_msg, 0, 1000));
    vec_push(steps, shutdown_step_new(str_from("Notify agents to save state"), SA_NOTIFY_AGENTS, 0, 0, 5000));

    # Stop services in reverse dependency order
    var svc_map = load64(init + 16);
    var defs = vec_new();
    var keys = map_keys(svc_map);
    for (var i = 0; i < vec_len(keys); i = i + 1) {
        var ms = map_get(svc_map, vec_get(keys, i));
        vec_push(defs, managed_svc_def(ms));
    }
    var order = resolve_service_order(defs);
    if (order != 0) {
        # Reverse order for shutdown
        for (var i = vec_len(order) - 1; i >= 0; i = i - 1) {
            var name = vec_get(order, i);
            var ms = map_get(svc_map, str_data(name));
            if (ms != 0) {
                var state = managed_svc_state(ms);
                if (state == STATE_RUNNING || state == STATE_STARTING) {
                    var desc = str_cat(str_from("Stop service: "), name);
                    vec_push(steps, shutdown_step_new(desc, SA_STOP_SERVICE, name, 15, 5000));
                }
            }
        }
    }

    vec_push(steps, shutdown_step_new(str_from("Sync filesystem buffers"), SA_SYNC_FS, 0, 0, 3000));
    vec_push(steps, shutdown_step_new(str_from("Unmount filesystems"), SA_UNMOUNT_FS, 0, 0, 5000));
    vec_push(steps, shutdown_step_new(str_from("Deactivate swap"), SA_SWAP_OFF, 0, 0, 2000));
    vec_push(steps, shutdown_step_new(str_from("Close encrypted volumes"), SA_CLOSE_LUKS, 0, 0, 3000));

    var sb2 = str_builder_new();
    str_builder_add_cstr(sb2, "Execute ");
    str_builder_add_cstr(sb2, shutdown_type_str(shutdown_type));
    vec_push(steps, shutdown_step_new(str_builder_build(sb2), SA_KERNEL_ACTION, shutdown_type, 0, 1000));

    # Build ShutdownPlan
    var plan = alloc(sizeof(ShutdownPlan));
    store64(plan, shutdown_type);
    store64(plan + 8, steps);
    store64(plan + 16, config_shutdown_timeout(config));
    store64(plan + 24, wall_msg);

    sakshi_span_exit();
    return plan;
}

