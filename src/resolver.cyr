# resolver.cyr — IPv4 host resolution for health checks (HIGH-1, 1.5.2)
#
# Closes the 1.4.0 / 1.5.0 deferral: the reject-non-loopback gate in
# `check_tcp_connect` / HTTP_GET was a temporary safety property
# preserving "the supervisor never sees a misleading green badge".
# This module replaces it with actual host resolution so external
# health checks against real services work as configured.
#
# Resolution order:
#   1. IPv4 dotted-quad parse (no allocation, no syscalls)
#   2. /etc/hosts scan (one read, line-based; IPv6 lines skipped)
#
# Full DNS via `gethostbyname` / `getaddrinfo` is deliberately out
# of scope for 1.5.2 — it requires libc linkage, and no consumer is
# currently configured against a name argonaut can't resolve via
# the static file. Future work; pin lands when a real consumer
# justifies the libc dep weight.

# =========================================================================
# Packed IPv4 representation
# =========================================================================
# Internal representation: 32-bit integer with octets stored
# big-endian (b0 << 24 | b1 << 16 | b2 << 8 | b3). Returned values
# are >= 0 on success; -1 sentinel signals "unresolvable" (-1 as
# i64 doesn't collide with any valid 32-bit IP under this packing).

# parse_ipv4(host) — strict dotted-quad parser.
#
# Accepts exactly four decimal octets in [0, 255] separated by '.'.
# Rejects leading zeros on multi-digit octets (e.g. "127.0.0.01") to
# avoid the inet_aton-style decimal/octal ambiguity that CVE-2021-29923
# documented across multiple language stdlibs. Returns the packed
# big-endian IP on success, -1 on any parse failure.
fn parse_ipv4(host) {
    return parse_ipv4_span(str_data(host), str_len(host));
}

# parse_ipv4_span(data, len) — `parse_ipv4` over a raw byte span, so the
# /etc/hosts scan can parse a token in place without boxing it in a Str
# (1.16.1 audit A-3). Same rules, same result.
fn parse_ipv4_span(data, len) {
    # "0.0.0.0" = 7 chars min; "255.255.255.255" = 15 chars max.
    if (len < 7) { return 0 - 1; }
    if (len > 15) { return 0 - 1; }

    var ip = 0;
    var octet = 0;
    var digits = 0;
    var dots = 0;
    var leading_zero = 0;

    for (var i = 0; i < len; i = i + 1) {
        var c = load8(data + i);
        if (c == 46) {                          # '.'
            if (digits == 0) { return 0 - 1; }
            if (dots >= 3)   { return 0 - 1; }
            ip = (ip << 8) | octet;
            octet = 0;
            digits = 0;
            dots = dots + 1;
            leading_zero = 0;
        } elif (c >= 48) {
            if (c > 57) { return 0 - 1; }       # not a digit
            # Leading-zero check: first digit '0' with more digits to
            # follow inside this octet → ambiguous (CVE-2021-29923).
            if (digits == 1) {
                if (leading_zero == 1) { return 0 - 1; }
            }
            if (digits == 0 && c == 48) { leading_zero = 1; }
            octet = octet * 10 + (c - 48);
            digits = digits + 1;
            if (digits > 3) { return 0 - 1; }
            if (octet > 255) { return 0 - 1; }
        } else {
            return 0 - 1;
        }
    }

    if (dots != 3) { return 0 - 1; }
    if (digits == 0) { return 0 - 1; }
    ip = (ip << 8) | octet;
    return ip;
}

# write_ipv4_octets(dst, ip) — write the 4 octets of `ip` to dst[0..3].
# Pairs with `sockaddr_in.sin_addr` (4-byte big-endian field at offset 4
# of the 16-byte AF_INET sockaddr).
fn write_ipv4_octets(dst, ip) {
    store8(dst,     (ip >> 24) & 255);
    store8(dst + 1, (ip >> 16) & 255);
    store8(dst + 2, (ip >> 8)  & 255);
    store8(dst + 3,  ip        & 255);
    return 0;
}

# =========================================================================
# /etc/hosts lookup
# =========================================================================

# lookup_etc_hosts(host) — scan /etc/hosts for a name match, return the
# packed IPv4 address or -1 if not present / file unreadable.
#
# Line format (RFC 952 / hosts(5)): `IP HOSTNAME [ALIAS...]`. Leading
# whitespace, blank lines, comments (`#`), and inline comments
# (trailing `#`) are all stripped. IPv6 lines (whose first token
# isn't a v4 dotted quad) get skipped — IPv6 transport is a separate
# initiative; the resolver returns -1 for v6-only names today.
#
# 8 KB cap on the file. /etc/hosts is conventionally small (<1 KB
# on stock distros, <2 KB on machines with explicit fleet pinning);
# 8 KB is comfortable headroom without putting an arbitrary heap
# buffer into the health-check hot path.
#
# **1.5.5 audit MEDIUM-1:** the buffer is hoisted to module-scope
# static so consumers calling `resolve_host_ipv4` on the health-check
# hot path don't grow the bump arena by 8 KB / call. /etc/hosts is
# re-read on every call (still picks up fleet-management updates);
# only the destination buffer is reused.

var _etc_hosts_buf = 0;

fn _etc_hosts_buf_ptr() {
    return _etc_hosts_buf;
}

# ⚠ THE SCAN ALLOCATES NOTHING. 1.16.1 audit A-3.
#
# It used to box every IP token and every name token it looked at in a fresh
# `str_new` just to hand them to `parse_ipv4` and `str_eq` — 16 bytes per
# token: 32-48 bytes per call on a stock two-line file, 6,400-9,600 on a
# 200-line one. This runs on every TCP/HTTP health tick whose target is a
# hostname, on PID 1's reactor path, in an arena init never resets. Tokens are
# now parsed and compared where they lie in the buffer (`parse_ipv4_span`,
# length + `memeq`).
#
# The rules are unchanged, byte for byte: a line is split on space and tab; the
# first token must be a dotted quad (no '#' ends it, so `1.2.3.4#x` is not an
# address); every later token up to a '#' is a name; a line whose first token
# is not an IPv4 address (IPv6, junk) is skipped; the first matching line wins.

# Blank on a hosts line: space or tab.
fn _hosts_blank(c) {
    if (c == 32) { return 1; }
    if (c == 9) { return 1; }
    return 0;
}

# First index in [i, le) that is not blank, or le.
fn _hosts_skip_blank(buf, i, le) {
    var j = i;
    while (j < le && _hosts_blank(load8(buf + j)) == 1) { j = j + 1; }
    return j;
}

# End of the token starting at i: the first blank in [i, le), or le. With
# `hash_ends` set a '#' also ends it (names); the address token runs over one.
fn _hosts_token_end(buf, i, le, hash_ends) {
    var j = i;
    var going = 1;
    while (going == 1) {
        if (j >= le) { going = 0; }
        elif (_hosts_blank(load8(buf + j)) == 1) { going = 0; }
        elif (hash_ends == 1 && load8(buf + j) == 35) { going = 0; }
        else { j = j + 1; }
    }
    return j;
}

# The packed IPv4 of the line [ls, le) if it names the `hlen` bytes at
# `hdata`, otherwise -1.
fn _hosts_line_match(buf, ls, le, hdata, hlen) {
    var j = _hosts_skip_blank(buf, ls, le);
    if (j >= le) { return 0 - 1; }                     # blank line
    if (load8(buf + j) == 35) { return 0 - 1; }        # comment line
    var ip_start = j;
    j = _hosts_token_end(buf, j, le, 0);
    var ip = parse_ipv4_span(buf + ip_start, j - ip_start);
    if (ip < 0) { return 0 - 1; }                      # IPv6 or malformed
    var hit = 0;
    var scanning = 1;
    while (scanning == 1) {
        j = _hosts_skip_blank(buf, j, le);
        if (j >= le) { scanning = 0; }
        elif (load8(buf + j) == 35) { scanning = 0; }  # inline comment
        else {
            var name_start = j;
            j = _hosts_token_end(buf, j, le, 1);
            if (j - name_start == hlen) {
                if (memeq(buf + name_start, hdata, hlen) == 1) {
                    hit = 1;
                    scanning = 0;
                }
            }
        }
    }
    if (hit == 1) { return ip; }
    return 0 - 1;
}

# hosts_scan(buf, n, host) — the /etc/hosts scan over `n` bytes already in
# memory: the packed IPv4 of the first line naming `host`, or -1. Split from
# `lookup_etc_hosts` so the parsing rules can be tested against crafted input.
fn hosts_scan(buf, n, host) {
    var hdata = str_data(host);
    var hlen = str_len(host);
    var found = 0 - 1;
    var ls = 0;
    while (ls < n) {
        var le = ls;
        while (le < n && load8(buf + le) != 10) { le = le + 1; }
        var ip = _hosts_line_match(buf, ls, le, hdata, hlen);
        if (ip >= 0) {
            found = ip;
            ls = n;
        } else {
            ls = le + 1;
        }
    }
    return found;
}

fn lookup_etc_hosts(host) {
    if (_etc_hosts_buf == 0) {
        _etc_hosts_buf = alloc(8193);
    }
    var buf = _etc_hosts_buf;
    # 2026-08-24 audit MEDIUM-4: `file_read_all` fills the buffer and returns
    # the byte count with NO truncation signal — a caller passing 8192 cannot
    # tell "the file is exactly 8192 bytes" from "the file is larger and I
    # only got the first 8192". A silently clipped /etc/hosts made every
    # entry past the cap unresolvable, and a health check against such a host
    # reports the service DOWN — which under PID 1 restarts a service that
    # was fine.
    #
    # Read one byte past the cap so the overflow is detectable, then clip the
    # scan back to the last complete LINE so a record severed mid-token is
    # never parsed as though it were whole.
    var n = file_read_all("/etc/hosts", buf, 8193);
    if (n <= 0) { return 0 - 1; }
    if (n > 8192) {
        # 1.16.1 audit: the length is measured, not a hand count (it said 78
        # for an 80-byte message, so the log line lost its last two bytes).
        var warn = "resolver: /etc/hosts exceeds the 8 KB scan cap — entries past it are invisible";
        sakshi_warn(warn, strlen(warn));
        n = 8192;
        var cut = n;
        while (cut > 0 && load8(buf + cut - 1) != 10) { cut = cut - 1; }
        # No newline at all in 8 KB: nothing complete to scan.
        n = cut;
        if (n == 0) { return 0 - 1; }
    }
    return hosts_scan(buf, n, host);
}

# =========================================================================
# Public resolver
# =========================================================================

# resolve_host_ipv4(host) — single entry point used by health checks.
# Returns a packed BE IPv4 address (>= 0) on success, -1 otherwise.
fn resolve_host_ipv4(host) {
    if (str_len(host) == 0) { return 0 - 1; }
    var ip = parse_ipv4(host);
    if (ip >= 0) { return ip; }
    return lookup_etc_hosts(host);
}
