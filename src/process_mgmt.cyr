# process_mgmt.cyr — Process execution and management
# Spawn, track, signal, and reap service processes.
# Ported from rust-old/src/process.rs
#
# Uses lib/process.cyr for low-level spawn and lib/syscalls.cyr for signals.

# =========================================================================
# Environment file loading
# =========================================================================

# Open an env file (a NUL-terminated path) for reading. Returns the fd, or -1
# when it cannot be opened or is not a regular file; its st_size goes to
# `size_out`.
#
# ⚠ 1.17.0, THE B-1 CLASS: A PLAIN open(O_RDONLY) OF A FIFO BLOCKS UNTIL A
# WRITER APPEARS. fork_exec_service's preflight runs this in PID 1 on every
# start, and kybernet calls load_env_file in PID 1 at config load, so an env
# file swapped for a FIFO (by anyone who can write its directory) parked PID 1
# in open(2) for good. O_NONBLOCK makes that open return at once, and the
# S_ISREG check refuses it, a device or a directory. O_NOCTTY keeps a tty
# node from becoming init's controlling terminal; O_CLOEXEC. A symlink IS
# followed, as systemd's EnvironmentFile= follows one: an env file is
# configuration. STAT_MODE / STAT_SIZE are the stdlib's per-arch offsets.
fn _env_file_open(cpath, size_out) {
    var fd = sys_open(cpath, O_RDONLY | O_NONBLOCK | ARG_O_NOCTTY | O_CLOEXEC, 0);
    if (fd < 0) { return -1; }
    var st[STAT_BUFSZ];
    if (syscall(SYS_FSTAT, fd, &st) < 0) {
        sys_close(fd);
        return -1;
    }
    if ((load32(&st + STAT_MODE) & 0xF000) != 0x8000) {   # S_IFREG
        sys_close(fd);
        return -1;
    }
    store64(size_out, load64(&st + STAT_SIZE));
    return fd;
}

# Load KEY=VALUE pairs from a file into a map (cstr key -> Str value). A key
# already in the map is overwritten. Lines starting with # are comments.
# Empty lines ignored. Values optionally quoted with " or '.
# Returns 0, -1 when the file cannot be read (or is not a regular file), -2
# when it is over 8 KiB. kybernet calls this for its own `env_files` config
# key; fork_exec_service calls it through _service_env_map (1.17.0).
fn load_env_file(path, env_map) {
    # L4: reject silently-truncated env files: over 8 KiB would lose the tail.
    # 1.17.0: the size comes from fstat on the one fd that is then read, so
    # the file checked is the file read (it used to be reopened by path, so a
    # swap in between went unseen).
    var szb[8];
    var fd = _env_file_open(str_data(path), &szb);
    if (fd < 0) { return -1; }
    var sz = load64(&szb);
    if (sz > 8191) {   # distinct error: file too large
        sys_close(fd);
        return -2;
    }
    # 1.17.0: an empty file is an empty environment, not a read failure.
    # kybernet skips empty files before calling, so this changes nothing there.
    if (sz == 0) {
        sys_close(fd);
        return 0;
    }
    var buf = alloc(8192);
    var n = 0;
    var reading = 1;
    while (reading == 1) {
        var got = sys_read(fd, buf + n, 8192 - n);
        if (got < 0) {
            sys_close(fd);
            return -1;
        }
        if (got == 0) {
            reading = 0;
        } else {
            n = n + got;
            if (n >= 8192) { reading = 0; }
        }
    }
    sys_close(fd);
    if (n > 8191) { return -2; }   # it grew past the cap since the fstat
    if (n == 0) { return 0; }

    var line_start = 0;
    for (var i = 0; i <= n; i = i + 1) {
        var c = 0;
        if (i < n) { c = load8(buf + i); }

        if (c == 10 || i == n) {  # newline or EOF
            var line_len = i - line_start;
            if (line_len > 0) {
                var first = load8(buf + line_start);
                if (first != 35) {  # not '#'
                    # Find '=' separator (first one; flag-style, no break)
                    var eq_pos = -1;
                    var j = line_start;
                    while (eq_pos < 0 && j < i) {
                        if (load8(buf + j) == 61) { eq_pos = j; }   # '='
                        j = j + 1;
                    }
                    if (eq_pos > line_start) {
                        # Null-terminate key in-place for map lookup
                        var saved = load8(buf + eq_pos);
                        store8(buf + eq_pos, 0);
                        var val_start = eq_pos + 1;
                        var val_len = i - val_start;
                        # Strip optional quotes: the same quote at both ends.
                        # Nested, not `(a && b) || (c && d)`: CLAUDE.md bars
                        # mixing && and || in one expression.
                        if (val_len >= 2) {
                            var first_q = load8(buf + val_start);
                            var last_q = load8(buf + val_start + val_len - 1);
                            var quoted = 0;
                            if (first_q == last_q) {
                                if (first_q == 34) { quoted = 1; }   # "
                                if (first_q == 39) { quoted = 1; }   # '
                            }
                            if (quoted == 1) {
                                val_start = val_start + 1;
                                val_len = val_len - 2;
                            }
                        }
                        # Copy key and value to heap
                        var key_len = eq_pos - line_start;
                        var key_copy = alloc(key_len + 1);
                        memcpy(key_copy, buf + line_start, key_len);
                        store8(key_copy + key_len, 0);
                        var val_copy = alloc(val_len + 1);
                        memcpy(val_copy, buf + val_start, val_len);
                        store8(val_copy + val_len, 0);
                        var val = str_new(val_copy, val_len);
                        map_set(env_map, key_copy, val);
                        store8(buf + eq_pos, saved);
                    }
                }
            }
            line_start = i + 1;
        }
    }
    return 0;
}

# Load and merge env vars from multiple file paths (vec of Str), in order, a
# later file overriding an earlier one. Returns the merged map, or 0 when any
# file fails to load or names an invalid variable.
#
# ⚠ 1.17.0: FAILS CLOSED. It used to ignore every load error and hand back
# whatever it had, so a missing file meant a service started without part of
# its configured environment and nobody was told.
fn load_env_files(paths) {
    var merged = map_new();
    if (_env_files_merge(paths, merged) != 0) { return 0; }
    return merged;
}

# 1 if `k` (a cstr) is a valid environment variable name: [A-Za-z_][A-Za-z0-9_]*.
# A file line such as `export FOO=1` or ` FOO=1` gives the key "export FOO" or
# " FOO", which no program can read back, so it is refused, not passed on.
fn env_name_is_valid(k) {
    if (k == 0) { return 0; }
    var c = load8(k);
    if (c == 0) { return 0; }
    if (c >= 48) { if (c <= 57) { return 0; } }      # a leading digit
    var i = 0;
    var ok = 1;
    while (ok == 1) {
        c = load8(k + i);
        if (c == 0) {
            ok = 2;
        } else {
            var good = 0;
            if (c >= 48) { if (c <= 57) { good = 1; } }    # 0-9
            if (c >= 65) { if (c <= 90) { good = 1; } }    # A-Z
            if (c >= 97) { if (c <= 122) { good = 1; } }   # a-z
            if (c == 95) { good = 1; }                     # _
            if (good == 0) { ok = 0; }
            i = i + 1;
        }
    }
    if (ok == 2) { return 1; }
    return 0;
}

# 1 if Str value `v` holds a NUL. execve stops at the first one, so the child would
# get part of the value it was configured with, and nothing would say so (1.19.0).
fn _env_value_has_nul(v) {
    var d = str_data(v);
    var n = str_len(v);
    for (var i = 0; i < n; i = i + 1) {
        if (load8(d + i) == 0) { return 1; }
    }
    return 0;
}

# Load each file in `paths` (vec of Str) into `into`, in order. Each file is
# read into its own map first and its names and values checked, so a bad file
# leaves `into` without any of its entries. Returns 0, or the first error: -1 / -2
# as load_env_file, -3 for an invalid variable name or a value holding a NUL.
fn _env_files_merge(paths, into) {
    if (paths == 0) { return 0; }
    for (var i = 0; i < vec_len(paths); i = i + 1) {
        var p = vec_get(paths, i);
        if (p == 0) { return -1; }
        var one = map_new();
        # A NUL-terminated copy: open() reads str_data to the first NUL.
        var rc = load_env_file(str_from_buf(str_data(p), str_len(p)), one);
        if (rc != 0) { return rc; }
        var keys = map_keys(one);
        for (var j = 0; j < vec_len(keys); j = j + 1) {
            var k = vec_get(keys, j);
            if (env_name_is_valid(k) == 0) { return -3; }
            var v = map_get(one, k);
            if (_env_value_has_nul(v) == 1) { return -3; }
            map_set(into, k, v);
        }
    }
    return 0;
}

# Parent-side check, before fork, that every env file of a service can be
# loaded: each path absolute, a regular file, at most 8 KiB. It allocates
# nothing, since PID 1 runs it on every start and `alloc` never frees; the
# child does the real read (and still fails closed if a file changed in
# between). Returns 0, or -1 with a sakshi warning naming the problem.
var _ENVF_PATH[512];   # GLOBAL scope: 512 slots = 4,096 bytes
var _ENVF_SIZE = 0;

fn _env_files_preflight(paths) {
    if (paths == 0) { return 0; }
    for (var i = 0; i < vec_len(paths); i = i + 1) {
        var p = vec_get(paths, i);
        if (p == 0) {
            sakshi_warn("env file path missing - service REFUSED", 39);
            return -1;
        }
        var plen = str_len(p);
        if (plen < 2) {
            sakshi_warn("env file path too short - service REFUSED", 41);
            return -1;
        }
        if (plen > 4095) {
            sakshi_warn("env file path too long - service REFUSED", 40);
            return -1;
        }
        if (load8(str_data(p)) != 47) {
            sakshi_warn("env file path not absolute - service REFUSED", 44);
            return -1;
        }
        memcpy(&_ENVF_PATH, str_data(p), plen);
        store8(&_ENVF_PATH + plen, 0);
        var fd = _env_file_open(&_ENVF_PATH, &_ENVF_SIZE);
        if (fd < 0) {
            sakshi_warn("env file missing, unreadable or not a regular file - service REFUSED", 68);
            return -1;
        }
        sys_close(fd);
        if (_ENVF_SIZE > 8191) {
            sakshi_warn("env file over 8 KiB - service REFUSED", 37);
            return -1;
        }
    }
    return 0;
}

# =========================================================================
# SafeCommand execution
# =========================================================================

# POSIX access(2) mode bits. The cyrius stdlib exposes sys_access but not
# these constants.
enum ArgAccessMode { ARG_F_OK = 0; ARG_X_OK = 1; }

# Resolve a SafeCommand binary to an ABSOLUTE path, or 0 if not found.
#
# ⚠ THIS IS LOAD-BEARING, NOT A CONVENIENCE. run_safe_cmd ultimately calls
# the stdlib's exec_vec_str, which does a bare `sys_execve(cmd, argv, envp)`
# — and **execve(2) does not search $PATH**. A pathname containing no slash
# is resolved relative to the CWD, so `execve("veritysetup", ...)` fails
# ENOENT and the forked child dies on exec_vec_str's `sys_exit(127)`.
#
# Every SafeCommand in src/edge_boot.cyr was built with a bare name —
# "mount", "veritysetup", "cryptsetup" — so the entire edge-boot execution
# path returned 127 on every command and could never have succeeded. It went
# unnoticed because no consumer imported that module. Verified against
# cyrius 6.5.35: exec_vec_str(["true"]) -> 127, exec_vec_str(["/bin/true"])
# -> 0. Fixed 1.13.2, found by kybernet's v1.5.7 edge-boot work.
#
# The envp exec_vec_str passes is empty, so a PATH inherited from the parent
# would not help even if execve honoured it. Resolution has to happen here.
#
# ⚠ STATIC RESULT. 1.16.1 audit B-8. This built a vec and a fresh Str per
# candidate directory on every call — 272 bytes for a bare `true`, once per
# health poll per service, in an arena PID 1 never resets. The candidate is
# now composed in `_RSB_PATH` and returned through the static Str `_RSB_STR`,
# so a resolved name is valid only until the next call. That is all
# `run_safe_cmd_timeout` needs: it reads the result, forks, and the child
# execs its own copy. The result for an explicit path is the caller's Str,
# unchanged. Global scope, so `[34]` is 34 SLOTS = 272 bytes: the longest
# directory (10) + NAME_MAX (255) + NUL. A longer name cannot be a file name
# and resolves to nothing.
var _RSB_PATH[34];
var _RSB_STR[2];

# sbin first: these are admin tools. On a merged-usr system the first two
# resolve through the symlink anyway; on a split-usr one they do not, which is
# exactly why all four are tried.
fn _rsb_dir(i) {
    if (i == 0) { return "/usr/sbin/"; }
    if (i == 1) { return "/sbin/"; }
    if (i == 2) { return "/usr/bin/"; }
    return "/bin/";
}

fn _resolve_safe_binary(name) {
    # Already an explicit path — caller's choice, use it verbatim.
    if (str_index_of(name, 47) >= 0) { return name; }
    var nlen = str_len(name);
    if (nlen == 0) { return 0; }
    if (nlen > 255) { return 0; }

    var buf = &_RSB_PATH;
    var found = 0;
    var i = 0;
    while (found == 0 && i < 4) {
        var dir = _rsb_dir(i);
        var dlen = strlen(dir);
        memcpy(buf, dir, dlen);
        memcpy(buf + dlen, str_data(name), nlen);
        store8(buf + dlen + nlen, 0);
        if (sys_access(buf, ARG_X_OK) == 0) {
            var res = &_RSB_STR;
            store64(res, buf);
            store64(res + 8, dlen + nlen);
            found = 1;
        }
        i = i + 1;
    }
    if (found == 0) { return 0; }
    return &_RSB_STR;
}

# Default wall-clock bound for a SafeCommand. Generous: these are
# veritysetup / cryptsetup / mount against real block devices.
enum SafeCmdLimits { SAFE_CMD_DEFAULT_TIMEOUT_MS = 30000; }

# Run a SafeCommand under a wall-clock bound. Returns the child's exit code,
# 127 when the binary cannot be found, or -1 on spawn failure, wait failure,
# or timeout.
#
# ⚠ THIS DELIBERATELY DOES NOT USE THE STDLIB'S exec_vec_str. 1.13.2.
# That function has two properties that are merely untidy in a CLI and
# unacceptable on a PID-1 trust path:
#
#   1. UNBOUNDED, UNINTERRUPTIBLE WAIT. `sys_waitpid(pid, &stbuf, 0)` — no
#      WNOHANG, no deadline. A consumer that blocks SIGCHLD/SIGTERM for a
#      signalfd (kybernet does) cannot even break it with EINTR. A
#      cryptsetup stalled on a wedged block device hangs init forever.
#   2. FAIL-OPEN. It discards waitpid's return value and reads the status
#      buffer unconditionally — and `var stbuf[4]` is STATIC storage in
#      cyrius, not stack (verified on 6.5.35: same address across calls,
#      contents persist). So a failed wait reports whatever the PREVIOUS
#      command exited with, or 0 on the first call. Zero means WIFEXITED
#      true, WEXITSTATUS 0 — SUCCESS. On `veritysetup open` that is a
#      verification that never ran reported as verified.
#
# Neither is fixable from here (lib/process.cyr is the toolchain's), so the
# exec is done directly with a bounded, status-checked wait modelled on
# process_stop. The child also gets reset_child_signal_mask() — exec_vec_str
# omits it, so an inherited PID-1 mask would leave cryptsetup unkillable by
# SIGTERM.
# ⚠ STATIC argv AND envp. 1.14.0.
#
# These were `alloc((argc + 2) * 8)` and `alloc(16)` per invocation — 32 bytes a
# call, which is nothing for the edge-boot callers that run once per boot and is
# a slow leak for `check_command`, which runs once per health poll per service on
# PID 1's reactor path in an arena that is never reset.
#
# Static is safe here and the reason is specific: the buffers are consumed
# synchronously — filled, handed to `execve` in the child, and dead in the parent
# the moment `fork` returns. `fork` gives the child its own copy, so the parent
# reusing the buffer on the next call cannot affect a running child. PID 1's
# reactor is single-threaded and this function does not recurse.
#
# ⚠ GLOBAL SCOPE, so `[18]` is 18 SLOTS = 144 bytes — 16 argv entries plus argv[0]
# plus the NULL terminator. An argv longer than that is REFUSED rather than
# truncated: a silently shortened argv is a different command.
var _RSC_ARGV[18];
var _RSC_ENVP[2];

fn run_safe_cmd_timeout(cmd, timeout_ms) {
    var resolved = _resolve_safe_binary(safe_cmd_binary(cmd));
    if (resolved == 0) { return 127; }
    var cmd_args = safe_cmd_args(cmd);
    var argc = vec_len(cmd_args);
    if (argc > 16) { return 127; }

    # argv[0] is the RESOLVED path. Caller-side argv elements are Str
    # throughout argonaut, so each needs str_data for the execve array.
    var argv_buf = &_RSC_ARGV;
    store64(argv_buf, str_data(resolved));
    for (var i = 0; i < argc; i = i + 1) {
        store64(argv_buf + (i + 1) * 8, str_data(vec_get(cmd_args, i)));
    }
    store64(argv_buf + (argc + 1) * 8, 0);

    var envp = &_RSC_ENVP;
    store64(envp, "PATH=/usr/sbin:/sbin:/usr/bin:/bin");
    store64(envp + 8, 0);

    var pid = sys_fork();
    if (pid < 0) { return -1; }
    if (pid == 0) {
        # 1.16.1 audit A-2: lead a process group of its own, so a timeout
        # can kill everything this command started — a health check's hung
        # curl/psql grandchild survived the old direct-child SIGKILL, and one
        # more accumulated under PID 1 on every probe.
        ag_sys_setpgid(0, 0);
        reset_child_signal_mask();
        sys_execve(str_data(resolved), argv_buf, envp);
        sys_exit(127);
    }
    # The parent sets the group too, so it exists before any timeout can
    # signal it whichever side runs first (the job-control race). EACCES
    # once the child has exec'd is expected and harmless.
    ag_sys_setpgid(pid, pid);
    return _wait_cmd_bounded(pid, timeout_ms);
}

# Wait for command child `pid`, which leads its own process group, for up to
# `timeout_ms`. Returns its exit code, 128+signal, or -1 on a wait failure or a
# timeout (then the group is SIGKILLed and the child reaped, bounded). Shared by
# run_safe_cmd_timeout and run_check_as.
fn _wait_cmd_bounded(pid, timeout_ms) {
    var deadline = monotonic_ms() + timeout_ms;
    while (monotonic_ms() < deadline) {
        var status_buf[8];
        store64(&status_buf, 0);
        var ret = sys_waitpid(pid, &status_buf, WNOHANG);
        if (ret > 0) {
            var status = load32(&status_buf);
            if (WIFEXITED(status)) { return WEXITSTATUS(status); }
            if (WIFSIGNALED(status)) { return 128 + WTERMSIG(status); }
            return -1;
        }
        # ret < 0 is a real wait failure (ECHILD, EINVAL). Report it as
        # failure — never fall through to a status read, which is exactly
        # the fail-open this function exists to avoid.
        if (ret < 0) { return -1; }
        sleep_ms(20);
    }

    # Over budget. Kill it and reap, so PID 1 is not left with a stray
    # child and the caller gets a failure rather than a hang.
    # 1.16.1 audit A-2: SIGKILL the whole group (pid is its leader), then the
    # direct child as a fallback should the group not exist. Orphaned
    # descendants are reaped by the subreaper sweep (proc_table_reap_orphans).
    if (pid > 1) {
        if (sys_kill(-pid, SIGKILL) < 0) { process_kill(pid); }
    }
    var kill_deadline = monotonic_ms() + 500;
    var kdone = 0;
    while (kdone == 0 && monotonic_ms() < kill_deadline) {
        var kbuf[8];
        store64(&kbuf, 0);
        if (sys_waitpid(pid, &kbuf, WNOHANG) != 0) { kdone = 1; }
        else { sleep_ms(20); }
    }
    return -1;
}

# Run a SafeCommand under the default bound and return its exit code.
fn run_safe_cmd(cmd) {
    return run_safe_cmd_timeout(cmd, SAFE_CMD_DEFAULT_TIMEOUT_MS);
}

# Run a sequence of SafeCommands, stopping on first failure.
fn run_safe_cmd_sequence(cmds) {
    for (var i = 0; i < vec_len(cmds); i = i + 1) {
        var code = run_safe_cmd(vec_get(cmds, i));
        if (code != 0) { return code; }
    }
    return 0;
}

# =========================================================================
# Process spawning for services
# =========================================================================

# reset_child_signal_mask: clear the inherited signal mask
# (1.6.3 audit MEDIUM-1). The PID-1 supervisor loop in
# `src/main.cyr` blocks SIGTERM/SIGINT/SIGCHLD so the signalfd
# read path can drain them; fork inherits that block, and
# execve preserves it. Services started without their default
# disposition can't handle SIGTERM (the kernel queues it against
# the masked process indefinitely). Reset to empty before exec.
fn reset_child_signal_mask() {
    var empty = sigset_new();
    return sys_sigprocmask(SIG_SETMASK, empty, 0);
}

# Extra environment entries a supervisor wants every service to inherit,
# as `KEY=value` cstrs. Appended after PATH by build_default_envp.
#
# Added 1.12.0. argonaut builds the child's envp itself (it must — the exec
# happens inside fork_exec_service), so a consumer had no way to put
# anything in a service's environment. The concrete case: kybernet binds an
# sd_notify socket, registers it with epoll and has a handler for it, but no
# service could ever find it, because discovery is by $NOTIFY_SOCKET and
# nothing set it. The whole readiness/watchdog-ping path was unreachable
# from the service side. Found by kybernet's rust-old port review — the
# Rust implementation did `env::set_var("NOTIFY_SOCKET", ...)` right after
# binding.
#
# Entries are cstrs, not Str: they go straight into the execve envp array.
# The caller owns their lifetime, which must outlive every spawn — string
# literals or arena-allocated buffers, not stack.
var _extra_envp = 0;

fn argonaut_set_extra_env(v) {
    var prev = _extra_envp;
    _extra_envp = v;
    return prev;
}

fn argonaut_extra_env() { return _extra_envp; }

# build_default_envp: minimal PATH-only environment vec for services spawned
# without an explicit env (1.6.3 audit MEDIUM-2). The pre-1.6.3 empty envp
# dropped PATH entirely; this gives every service a usable PATH without
# needing per-service config. Since 1.12.0 it also appends whatever
# argonaut_set_extra_env registered. A service's own map is merged by
# build_service_envp below.
fn build_default_envp() {
    return build_service_envp(0);
}

# 1 if `env` (a cstr-keyed map, or 0) defines the key of the "KEY=value"
# cstr `entry`; `keys` is map_keys(env), or 0 for none.
fn _env_keys_define(keys, entry) {
    if (keys == 0) { return 0; }
    var klen = 0;
    var c = load8(entry);
    while (c != 0 && c != 61) {     # up to '='
        klen = klen + 1;
        c = load8(entry + klen);
    }
    var hit = 0;
    var i = 0;
    while (hit == 0 && i < vec_len(keys)) {
        var k = vec_get(keys, i);
        if (strlen(k) == klen) {
            if (memeq(k, entry, klen) == 1) { hit = 1; }
        }
        i = i + 1;
    }
    return hit;
}

# The envp for a service: the defaults (PATH, then the extra-env seam), then
# the service's own `environment` map. `svc_def` may be 0 (defaults only).
#
# ⚠ 1.16.1 audit B-10: A DEFAULT THE SERVICE DEFINES IS LEFT OUT. The service's
# entries used to be appended after the defaults on the theory that the last
# duplicate wins. It does not: glibc's and musl's getenv return the FIRST
# match, so a service that set its own PATH still got argonaut's.
#
# 1.17.0: the service's env files are part of its own map (_service_env_map),
# so a file entry also replaces a default of the same name. Returns 0 when an
# env file cannot be loaded or names an invalid variable; fork_exec_service's
# child then exits 126 rather than start without part of its environment.
fn build_service_envp(svc_def) {
    var skeys = 0;
    var senv = 0;
    if (svc_def != 0) {
        senv = _service_env_map(svc_def);
        if (senv < 0) { return 0; }
        if (senv != 0) { skeys = map_keys(senv); }
    }
    var v = vec_new();
    var dpath = "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin";
    if (_env_keys_define(skeys, dpath) == 0) { vec_push(v, dpath); }
    if (_extra_envp != 0) {
        for (var i = 0; i < vec_len(_extra_envp); i = i + 1) {
            var xe = vec_get(_extra_envp, i);
            if (_env_keys_define(skeys, xe) == 0) { vec_push(v, xe); }
        }
    }
    if (senv != 0) { _append_env_map(v, senv); }
    return v;
}

# The service's environment as one cstr-keyed map (Str values): its
# `environment` entries, then each of its `env_files` in order, a later entry
# overriding an earlier one. That is systemd's order (an EnvironmentFile=
# overrides Environment=) and kybernet's for its own `env_files` key.
# Returns the `environment` map itself when there are no env files, a new map
# when there are, and -1 when a file cannot be loaded or names an invalid
# variable. 1.17.0: `env_files` existed since the beginning and nothing read it.
fn _service_env_map(svc_def) {
    var env = svc_def_env(svc_def);
    var files = svc_def_env_files(svc_def);
    if (files == 0) { return env; }
    if (vec_len(files) == 0) { return env; }
    var merged = map_new();
    if (env != 0) {
        var ekeys = map_keys(env);
        for (var i = 0; i < vec_len(ekeys); i = i + 1) {
            var ek = vec_get(ekeys, i);
            map_set(merged, ek, map_get(env, ek));
        }
    }
    if (_env_files_merge(files, merged) != 0) { return -1; }
    return merged;
}

# ⚠ THE SERVICE'S OWN `environment` MAP, FLATTENED TO "KEY=VALUE" cstrs. 1.15.0.
#
# `ServiceDefinition.environment` has existed since the beginning and
# `fork_exec_service` never read it: envp came from `build_default_envp()`
# alone. The comment there said "full map -> flat-cstrs lands when a service
# surfaces a need for custom env beyond PATH" — a service has, so it lands.
#
# The consequence of not having it was worse than an absent feature. Consumers
# CAN populate the map — argonaut's own `default_services` does, setting PGDATA
# and XDG_SESSION_TYPE (services.cyr:21, :221) — and none of it ever reached a
# child. Those two have been silently ineffective for the life of the field.
#
# Called in the CHILD after fork, so the allocations here are copy-on-write and
# die with the exec. A service may deliberately override PATH or an extra-env
# entry: build_service_envp leaves out every default whose key the service's
# map defines, because getenv returns the FIRST match, not the last (1.16.1
# audit B-10).
fn _append_service_env(v, svc_def) {
    return _append_env_map(v, svc_def_env(svc_def));
}

# Flatten a cstr-keyed map of Str values into "KEY=VALUE" cstrs on `v`.
# build_service_envp passes _service_env_map's result (1.17.0).
fn _append_env_map(v, env) {
    if (env == 0) { return 0; }
    var keys = map_keys(env);
    if (keys == 0) { return 0; }
    for (var i = 0; i < vec_len(keys); i = i + 1) {
        var k = vec_get(keys, i);
        var val = map_get(env, k);
        if (val == 0) { continue; }
        var sb = str_builder_new();
        str_builder_add_cstr(sb, k);
        str_builder_add_cstr(sb, "=");
        str_builder_add_str(sb, val);
        vec_push(v, str_data(str_builder_build(sb)));
    }
    return 0;
}

# =========================================================================
# Pre-exec hook (1.9.0)
# =========================================================================
#
# A consumer-supplied callback run in the CHILD, after fork and after the
# signal-mask reset, immediately before execve. It receives the service's
# ServiceDefinition and returns 0 to proceed with exec or non-zero to abort
# the child.
#
# This exists because seccomp, Landlock and capability drops can ONLY be
# installed between fork and exec, and argonaut owns that window. Without a
# seam here a supervisor built on argonaut cannot sandbox its services at
# all, no matter how much policy code it has — which is exactly the state
# kybernet was in when its 2026-08-24 audit filed HIGH-1 against 686 lines
# of seccomp/Landlock/privdrop that were reachable from nothing.
#
# argonaut deliberately does NOT interpret the policy. It supplies the
# window and the ServiceDefinition (whose seccomp / landlock / capabilities
# fields the consumer can read via the accessors in types.cyr); the
# consumer owns the meaning. That keeps the security model out of the
# service manager and in the thing that has an opinion about it.
#
# CONTRACT for hook implementors — this runs in a forked child of PID 1:
#   * It must not allocate unboundedly, block, or fork.
#   * A non-zero return aborts the child with exit 126 rather than execing,
#     so a policy that cannot be applied FAILS CLOSED. Never return 0 on a
#     failed restriction.
#   * Ordering is the caller's problem, but the workable order is
#     no_new_privs -> capability/uid/gid drop -> Landlock -> seccomp, since
#     an installed seccomp filter will otherwise kill the drop syscalls.
#   * Since 1.18.0 it also runs for the service's command health and ready
#     checks (run_check_as, ADR-015), with the same definition, so a check is
#     confined as its service is. `argonaut_exec_kind()` tells the hook which
#     image is about to exec: EXEC_SERVICE or EXEC_HEALTH_CHECK.
var _pre_exec_hook = 0;

# Register the pre-exec callback. Pass 0 to clear. Returns the previous
# hook so a caller can chain or restore.
fn argonaut_set_pre_exec_hook(fp) {
    var prev = _pre_exec_hook;
    _pre_exec_hook = fp;
    return prev;
}

fn argonaut_pre_exec_hook() { return _pre_exec_hook; }

# What a spawn child is about to exec, for the pre-exec hook. EXEC_NONE outside
# a spawn child: it is set in the child, after fork, so the parent never sees
# another value.
enum ExecKind {
    EXEC_NONE = 0;
    EXEC_SERVICE = 1;            # fork_exec_service: the service itself
    EXEC_HEALTH_CHECK = 2;       # run_check_as: a command health or ready check
}

var _exec_kind = 0;

fn argonaut_exec_kind() { return _exec_kind; }

# One limit as both soft and hard, for the calling process. 0, or -1.
fn _set_rlimit(resource, value) {
    var lim[16];
    store64(&lim, value);        # rlim_cur
    store64(&lim + 8, value);    # rlim_max
    if (ag_sys_prlimit64(0, resource, &lim, 0) < 0) { return -1; }
    return 0;
}

# Apply a ResourceLimits (or 0) to the calling process: fork_exec_service's
# child (1.17.0). A field that is set becomes both the soft and the hard
# limit, as `prlimit --nofile=N` does: nofile, address_space and nproc when
# > 0, core when >= 0. Returns 0, or -1 at the first limit the kernel refuses
# (EPERM to raise a hard limit without CAP_SYS_RESOURCE, or nofile above
# fs.nr_open).
#
# ⚠ BEFORE 1.17.0 NOTHING APPLIED THESE. `svc_def_rlimits` had a field and a
# getter, `to_prlimit_commands` and `resource_limits_secure` built values for
# it, and no code path ever set a limit on a service.
fn _apply_rlimits(rl) {
    if (rl == 0) { return 0; }
    var nofile = load64(rl);
    var aspace = load64(rl + 8);
    var nproc = load64(rl + 16);
    var core = load64(rl + 24);
    if (nofile > 0) {
        if (_set_rlimit(AG_RLIMIT_NOFILE, nofile) != 0) { return -1; }
    }
    if (aspace > 0) {
        if (_set_rlimit(AG_RLIMIT_AS, aspace) != 0) { return -1; }
    }
    if (nproc > 0) {
        if (_set_rlimit(AG_RLIMIT_NPROC, nproc) != 0) { return -1; }
    }
    if (core >= 0) {
        if (_set_rlimit(AG_RLIMIT_CORE, core) != 0) { return -1; }
    }
    return 0;
}

# In a spawn child: stdin, stdout and stderr on /dev/null, so a service's (or a
# check's) output stops mixing into argonaut's stdio. Production wiring should
# swap /dev/null for the journal fd.
#
# ⚠ open() CAN RETURN 0, 1 OR 2 ITSELF: PID 1 starts with no fds when the
# initramfs has no /dev/console. Such an fd is already one of the three, so it
# is never dup'd onto itself and never closed. Closing it after dup2(fd, fd)
# left the service with stdin or stdout closed, and its next open() landed
# there (1.16.3).
fn _child_stdio_devnull() {
    var devnull_r = sys_open("/dev/null", 0, 0);   # O_RDONLY
    if (devnull_r >= 0) {
        if (devnull_r != 0) { sys_dup2(devnull_r, 0); }
        if (devnull_r > 2) { sys_close(devnull_r); }
    }
    var devnull_w = sys_open("/dev/null", 1, 0);   # O_WRONLY
    if (devnull_w >= 0) {
        if (devnull_w != 1) { sys_dup2(devnull_w, 1); }
        if (devnull_w != 2) { sys_dup2(devnull_w, 2); }
        if (devnull_w > 2) { sys_close(devnull_w); }
    }
    return 0;
}

# In a spawn child: exec cstr `path` with `argv_buf` as an image of service
# `svc_def`: its environment and env files, its resource limits, and the
# pre-exec hook, which reads `kind` through argonaut_exec_kind(). Never
# returns: 126 when the environment, a limit or the hook refuses (fails
# CLOSED), 127 when the exec fails. fork_exec_service and run_check_as both end
# here, so a service and its command checks are confined alike (ADR-015).
fn _exec_service_image(svc_def, path, argv_buf, kind) {
    # Environment (1.6.3 audit MEDIUM-2): pass a minimal
    # default envp containing PATH. Pre-1.6.3 passed empty
    # envp; services lost PATH silently. The service's own
    # map is merged in, overriding any default it defines
    # (1.15.0; 1.16.1 audit B-10).
    var env_vec = build_service_envp(svc_def);
    # 1.17.0: an env file that cannot be loaded (changed since the
    # preflight, or names an invalid variable) fails the start CLOSED,
    # with the hook's 126: a service started without part of its
    # configured environment is one nobody configured.
    if (env_vec == 0) { sys_exit(126); }
    var envc = vec_len(env_vec);
    var envp_buf = alloc((envc + 1) * 8);
    var enpi = 0;
    while (enpi < envc) {
        store64(envp_buf + enpi * 8, vec_get(env_vec, enpi));
        enpi = enpi + 1;
    }
    store64(envp_buf + envc * 8, 0);

    # Reset signal mask (1.6.3 audit MEDIUM-1) — drop the
    # PID-1 supervisor loop's SIGTERM/SIGINT/SIGCHLD block
    # before exec so the service can install its own handlers
    # and receive shutdown signals.
    reset_child_signal_mask();

    # Resource limits (1.17.0). After argv / envp are built, so an
    # address-space limit cannot starve those allocations; before the
    # hook, which may drop CAP_SYS_RESOURCE (needed to raise a hard
    # limit). Fails CLOSED with the hook's 126: a limit the kernel
    # refuses is a service started outside the bounds it was given.
    if (_apply_rlimits(svc_def_rlimits(svc_def)) != 0) { sys_exit(126); }

    # Pre-exec hook (1.9.0) — LAST thing before execve, so anything it
    # installs (seccomp, Landlock, dropped capabilities) is in force for
    # the exec'd image. Deliberately after the signal reset: a hook that
    # installs a seccomp filter would otherwise have to allowlist
    # rt_sigprocmask purely to let the reset run.
    #
    # Fails CLOSED. A hook that reports failure means the sandbox could
    # not be established, and running the service unsandboxed is the one
    # outcome worse than not running it — exit 126 (distinct from 127,
    # "exec failed") so the supervisor can tell the two apart.
    _exec_kind = kind;
    if (_pre_exec_hook != 0) {
        if (fncall1(_pre_exec_hook, svc_def) != 0) {
            sys_exit(126);
        }
    }

    sys_execve(path, argv_buf, envp_buf);
    sys_exit(127);  # exec failed
    return 0;
}

# Fork + exec a service, returning the child's pid, or -1.
# Parent returns immediately; child execs the binary.
fn fork_exec_service(svc_def) {
    var sn = svc_def_name(svc_def);
    sakshi_debug(str_data(sn), str_len(sn));

    # Env files (1.17.0): refuse the start here, where the caller sees -1 and
    # audits the failure, when a file is plainly missing or too large. The
    # child reads them for real.
    if (_env_files_preflight(svc_def_env_files(svc_def)) != 0) { return -1; }

    var pid = sys_fork();
    if (pid < 0) { return -1; }

    if (pid == 0) {
        # Child process
        # L3: detach from argonaut's controlling TTY so signals on the
        # parent terminal (e.g. ^C when argonaut is foregrounded for
        # testing) don't reach service children, and so each service
        # gets its own session. Non-fatal — already-session-leader
        # callers return EPERM and we proceed.
        sys_setsid();
        _child_stdio_devnull();

        # Exec the binary directly via sys_execve — we're already
        # in the forked child; calling `exec_env_str` here would
        # fork AGAIN and the grandchild's session would be the
        # intermediate's (since setsid above applied to the
        # intermediate). L3 then fails: the exec'd process inherits
        # the intermediate's session id rather than becoming its
        # own session leader. Build argv + envp in-place and
        # execve directly. (Audit caught this at the 1.6.2 PID-1
        # harness — pre-1.6.2 fork_exec_service path was
        # double-forked.)
        var binary = svc_def_binary(svc_def);
        var args = svc_def_args(svc_def);

        var argc = vec_len(args) + 1;
        var argv_buf = alloc((argc + 1) * 8);
        store64(argv_buf, str_data(binary));
        var ai = 0;
        while (ai < vec_len(args)) {
            store64(argv_buf + (ai + 1) * 8, str_data(vec_get(args, ai)));
            ai = ai + 1;
        }
        store64(argv_buf + argc * 8, 0);

        _exec_service_image(svc_def, str_data(binary), argv_buf, EXEC_SERVICE);
    }

    return pid;  # Parent returns child PID
}

# Run SafeCommand `cmd` as a command health or ready check of service
# `svc_def`, under `timeout_ms`, spawned the way the service is (1.18.0,
# ADR-015): its environment and env files, its resource limits, and the
# pre-exec hook, which sees argonaut_exec_kind() == EXEC_HEALTH_CHECK. stdio
# is /dev/null. The binary resolution, the process group, the bounded wait and
# the timeout kill are run_safe_cmd_timeout's.
#
# Returns the exit code, 127 when the binary cannot be found, or -1 (a spawn
# or wait failure, a timeout). A hook, limit or environment (an env file that
# cannot be loaded) that refuses is 126: the check fails CLOSED and never runs
# unconfined. There is no parent-side env-file preflight, unlike
# fork_exec_service's: a check has no start to refuse early, and the child's
# refusal is the same failed check.
#
# svc_def == 0 is run_safe_cmd_timeout: with no service there is no service
# policy to run under.
#
# Allocation-free in the parent, as run_safe_cmd_timeout is (it runs every
# health poll): argv is its static buffer, and the environment is built in the
# child.
fn run_check_as(svc_def, cmd, timeout_ms) {
    if (svc_def == 0) { return run_safe_cmd_timeout(cmd, timeout_ms); }
    var resolved = _resolve_safe_binary(safe_cmd_binary(cmd));
    if (resolved == 0) { return 127; }
    var cmd_args = safe_cmd_args(cmd);
    var argc = vec_len(cmd_args);
    if (argc > 16) { return 127; }

    var argv_buf = &_RSC_ARGV;
    store64(argv_buf, str_data(resolved));
    for (var i = 0; i < argc; i = i + 1) {
        store64(argv_buf + (i + 1) * 8, str_data(vec_get(cmd_args, i)));
    }
    store64(argv_buf + (argc + 1) * 8, 0);

    var pid = sys_fork();
    if (pid < 0) { return -1; }
    if (pid == 0) {
        # Its own process group, as run_safe_cmd_timeout's child (1.16.1
        # audit A-2): a timeout kills everything the check started.
        ag_sys_setpgid(0, 0);
        _child_stdio_devnull();
        _exec_service_image(svc_def, str_data(resolved), argv_buf, EXEC_HEALTH_CHECK);
    }
    ag_sys_setpgid(pid, pid);
    return _wait_cmd_bounded(pid, timeout_ms);
}

# =========================================================================
# Process table — tracks running service processes
# =========================================================================

# Process table is a map: service_name -> pid
# Started-at times: separate map: service_name -> monotonic_ms
# Process identity: separate map: service_name -> pidfd + 1 (0 = none)
var g_proc_table = 0;
var g_proc_times = 0;
var g_proc_pidfds = 0;

# =========================================================================
# Process identity — a pidfd per tracked process (1.18.0)
# =========================================================================
#
# ⚠ A PID IS A NUMBER, AND THE KERNEL REUSES IT ONCE THE PROCESS IS REAPED. The
# proc table holds numbers. If anything reaps a tracked process behind
# argonaut's back (a consumer's own waitpid(-1), or a caller of the proc_table_*
# API), the entry keeps a number that may already name another process,
# possibly another child of argonaut's, which a waitpid probe (B-7) cannot tell
# apart. So each entry also holds a pidfd, opened when the entry is inserted:
#
#   * While a pidfd's process exists (alive, or a zombie), its number cannot be
#     reused. `proc_pidfd_gone` asks the pidfd first; when it answers "exists",
#     the number-based waitpid probe and the process-group kill are safe.
#   * Every signal to a tracked process goes through its pidfd
#     (`proc_send_signal`), and reaches that process or nothing.
#
# FALLBACK (the maintainer's 1.18.0 decision): with no pidfd (Linux < 5.3,
# pidfd_open failing, or pidfds disabled), argonaut signals by number after the
# B-7 probe, as before. That is still exact for argonaut's own children while
# argonaut is their only reaper; it is not exact for a number reaped elsewhere.
#
# pidfd_open sets O_CLOEXEC, so no service inherits one. The single-threaded
# supervisor is what makes "check the pidfd, then use the number" atomic:
# nothing in argonaut reaps between the two.
enum PidfdErrno {
    AG_ESRCH = 3;            # no such process: a pidfd's process has been reaped
    AG_ENOSYS = 38;          # the kernel has no pidfd_open (Linux < 5.3)
}

var _pidfd_enabled = 1;
var _pidfd_absent = 0;       # 1 once pidfd_open returned ENOSYS

# Turn pidfds on (1) or off (0) for entries inserted from now on. Off is the
# probe-then-signal fallback. Returns the previous setting.
fn argonaut_set_pidfd_enabled(on) {
    var prev = _pidfd_enabled;
    _pidfd_enabled = on;
    return prev;
}

fn argonaut_pidfd_enabled() { return _pidfd_enabled; }

# A pidfd for `pid`, or -1: pid <= 0, pidfds disabled, the kernel has none
# (warned once), or pidfd_open refused (ESRCH: already gone; EMFILE).
fn _pidfd_for(pid) {
    if (pid <= 0) { return -1; }
    if (_pidfd_enabled == 0) { return -1; }
    if (_pidfd_absent == 1) { return -1; }
    var fd = sys_pidfd_open(pid, 0);
    if (fd == -AG_ENOSYS) {
        _pidfd_absent = 1;
        sakshi_warn("pidfd_open: ENOSYS; signalling by pid after a probe", 51);
        return -1;
    }
    if (fd < 0) { return -1; }
    return fd;
}

# 1 when `pidfd`'s process has been reaped: its pid number may now belong to
# anyone, so nothing may be signalled or waited on by number. 0 while it exists
# (alive or a zombie, so its number is still its own), or when pidfd < 0.
fn proc_pidfd_gone(pidfd) {
    if (pidfd < 0) { return 0; }
    if (ag_sys_pidfd_send_signal(pidfd, 0, 0, 0) == -AG_ESRCH) { return 1; }
    return 0;
}

# Send `sig` to a tracked process through `pidfd`, or, with no pidfd, to `pid`
# (the caller has probed that `pid` is its running child). 0 or -errno. Never
# kill(-1), kill(0) or init: pid <= 1 is -ESRCH.
fn proc_send_signal(pidfd, pid, sig) {
    if (pidfd >= 0) { return ag_sys_pidfd_send_signal(pidfd, sig, 0, 0); }
    if (pid <= 1) { return -AG_ESRCH; }
    return sys_kill(pid, sig);
}

# The pidfd stored under cstr key `key`, or -1.
#
# The pidfd map is allocated on the first insert that opens one, not by
# proc_table_init: argonaut_init_new calls that, and an eager map_new cost every
# init_new_* bench 0.6-0.7 µs (measured at 1.18.0) for a map most inits only
# need once a service is spawned.
fn _proc_pidfd_get(key) {
    if (g_proc_pidfds == 0) { return -1; }
    return map_get(g_proc_pidfds, key) - 1;
}

# Close and forget the pidfd stored under cstr key `key`, if any.
fn _proc_pidfd_drop(key) {
    if (g_proc_pidfds == 0) { return 0; }
    var e = map_get(g_proc_pidfds, key);
    if (e > 0) { sys_close(e - 1); }
    map_delete(g_proc_pidfds, key);
    return 0;
}

# Close every stored pidfd (the table is being replaced).
fn _proc_pidfd_drop_all() {
    if (g_proc_pidfds == 0) { return 0; }
    var entries = map_entries(g_proc_pidfds);
    var cap = map_cap(g_proc_pidfds);
    for (var i = 0; i < cap; i = i + 1) {
        var ep = entries + i * 24;
        if (load64(ep + 16) == 1) {
            var e = load64(ep + 8);
            if (e > 0) { sys_close(e - 1); }
        }
    }
    return 0;
}

fn proc_table_init() {
    _proc_pidfd_drop_all();
    g_proc_table = map_new();
    g_proc_times = map_new();
    g_proc_pidfds = 0;
}

# Track `pid` as service `name`, and open its pidfd. A pidfd already held for
# the name (a previous run) is closed first.
fn proc_table_insert(name, pid) {
    var key = str_data(name);
    _proc_pidfd_drop(key);
    map_set(g_proc_table, key, pid);
    map_set(g_proc_times, key, monotonic_ms());
    var fd = _pidfd_for(pid);
    if (fd >= 0) {
        if (g_proc_pidfds == 0) { g_proc_pidfds = map_new(); }
        map_set(g_proc_pidfds, key, fd + 1);
    }
}

fn proc_table_remove(name) {
    var key = str_data(name);
    _proc_pidfd_drop(key);
    map_delete(g_proc_table, key);
    map_delete(g_proc_times, key);
}

fn proc_table_pid(name) {
    return map_get(g_proc_table, str_data(name));
}

# The pidfd tracking service `name`, or -1 when it has none (the fallback, or
# no proc table yet).
fn proc_table_pidfd(name) {
    return _proc_pidfd_get(str_data(name));
}

fn proc_table_has(name) {
    return map_has(g_proc_table, str_data(name));
}

fn proc_table_uptime_ms(name) {
    var started = map_get(g_proc_times, str_data(name));
    if (started == 0) { return 0; }
    return monotonic_ms() - started;
}

fn proc_table_count() {
    return map_count(g_proc_table);
}

fn proc_table_keys() {
    return map_keys(g_proc_table);
}

# Check if a process is alive via kill(pid, 0)
fn process_alive(pid) {
    if (pid <= 0) { return 0; }
    var ret = sys_kill(pid, 0);
    return ret == 0;
}

# Send SIGTERM to a process
fn process_terminate(pid) {
    return sys_kill(pid, SIGTERM);
}

# Send SIGKILL to a process
fn process_kill(pid) {
    return sys_kill(pid, SIGKILL);
}

# Exit code for a waitpid status: the exit status, 128+signal, or -1.
fn _wait_status_code(status) {
    if (WIFEXITED(status)) { return WEXITSTATUS(status); }
    if (WIFSIGNALED(status)) { return 128 + WTERMSIG(status); }
    return -1;
}

# Graceful stop: SIGTERM, wait up to timeout_ms, then SIGKILL.
# Returns exit code or -1.
#
# ⚠ 1.16.1 audit B-7: ONLY OUR OWN CHILD IS SIGNALLED. waitpid failing (ECHILD)
# means `pid` is not — or is no longer — our child: something else reaped it,
# and the number may already belong to an unrelated process. This used to treat
# that as "still running": it SIGTERMed first, waited out the whole timeout,
# then SIGKILLed whatever held the pid by then. A probe now runs before the
# first signal and every wait failure ends the stop without signalling.
#
# 1.18.0: `pidfd` (or -1) is the process's identity. Its process reaped
# elsewhere means the number may name someone else: the stop ends at once,
# without a probe that could reap, or a signal that could reach, that someone.
# Every signal goes through the pidfd.
fn process_stop_fd(pid, pidfd, timeout_ms) {
    if (pid <= 0) { return -1; }
    if (proc_pidfd_gone(pidfd) == 1) { return -1; }
    var status_buf[8];
    store64(&status_buf, 0);
    var probe = sys_waitpid(pid, &status_buf, WNOHANG);
    if (probe > 0) { return _wait_status_code(load32(&status_buf)); }
    if (probe < 0) { return -1; }

    proc_send_signal(pidfd, pid, SIGTERM);

    var deadline = monotonic_ms() + timeout_ms;
    while (monotonic_ms() < deadline) {
        store64(&status_buf, 0);
        var ret = sys_waitpid(pid, &status_buf, WNOHANG);
        if (ret > 0) { return _wait_status_code(load32(&status_buf)); }
        if (ret < 0) { return -1; }
        sleep_ms(50);
    }

    # Timed out — SIGKILL
    sakshi_warn("SIGKILL", 7);
    proc_send_signal(pidfd, pid, SIGKILL);

    # Wait up to 500ms for SIGKILL
    var kill_deadline = monotonic_ms() + 500;
    while (monotonic_ms() < kill_deadline) {
        store64(&status_buf, 0);
        var kret = sys_waitpid(pid, &status_buf, WNOHANG);
        if (kret > 0) { return _wait_status_code(load32(&status_buf)); }
        if (kret < 0) { return -1; }
        sleep_ms(10);
    }

    return -1;
}

# process_stop_fd with no pidfd: the B-7 probe-then-signal alone.
fn process_stop(pid, timeout_ms) {
    return process_stop_fd(pid, -1, timeout_ms);
}

# (name, code) result pair for proc_table_stop_all.
fn _stop_result(name, code) {
    var pair = alloc(16);
    store64(pair, str_from(name));
    store64(pair + 8, code);
    return pair;
}

# Stop all tracked processes
#
# 1.16.1 audit B-7: as process_stop — a pid whose waitpid fails is not our
# child, so it is reported (-1) and never signalled: not SIGTERMed up front,
# and not SIGKILLed after a wait it could never satisfy.
fn proc_table_stop_all(timeout_ms) {
    var results = vec_new();
    var keys = proc_table_keys();
    var remaining = vec_new();

    # Probe, then send SIGTERM to every pid that is still our running child.
    # 1.18.0: a pidfd whose process was reaped elsewhere is reported (-1) and
    # its number is neither probed nor signalled (see process_stop_fd).
    for (var i = 0; i < vec_len(keys); i = i + 1) {
        var name = vec_get(keys, i);
        var pid = map_get(g_proc_table, name);
        var pfd = _proc_pidfd_get(name);
        if (pid > 0) {
            var pbuf[8];
            store64(&pbuf, 0);
            var probe = -1;
            if (proc_pidfd_gone(pfd) == 0) { probe = sys_waitpid(pid, &pbuf, WNOHANG); }
            if (probe > 0) {
                var pcode = -1;
                if (WIFEXITED(load32(&pbuf))) { pcode = WEXITSTATUS(load32(&pbuf)); }
                vec_push(results, _stop_result(name, pcode));
            } elif (probe < 0) {
                vec_push(results, _stop_result(name, -1));
            } else {
                proc_send_signal(pfd, pid, SIGTERM);
                vec_push(remaining, name);
            }
        }
    }

    # Wait with timeout
    var deadline = monotonic_ms() + timeout_ms;

    while (vec_len(remaining) > 0 && monotonic_ms() < deadline) {
        var still_alive = vec_new();
        for (var i = 0; i < vec_len(remaining); i = i + 1) {
            var name = vec_get(remaining, i);
            var pid = map_get(g_proc_table, name);
            if (pid > 0) {
                var status_buf[8];
                store64(&status_buf, 0);
                var ret = sys_waitpid(pid, &status_buf, WNOHANG);
                if (ret > 0) {
                    var status = load64(&status_buf);
                    var code = -1;
                    if (WIFEXITED(status)) { code = WEXITSTATUS(status); }
                    vec_push(results, _stop_result(name, code));
                } elif (ret < 0) {
                    vec_push(results, _stop_result(name, -1));
                } else {
                    vec_push(still_alive, name);
                }
            }
        }
        remaining = still_alive;
        if (vec_len(remaining) > 0) {
            sleep_ms(50);
        }
    }

    # SIGKILL anything still alive
    for (var i = 0; i < vec_len(remaining); i = i + 1) {
        var name = vec_get(remaining, i);
        var pid = map_get(g_proc_table, name);
        if (pid > 0) { proc_send_signal(_proc_pidfd_get(name), pid, SIGKILL); }
        vec_push(results, _stop_result(name, -1));
    }

    # Clear the table, closing every pidfd
    _proc_pidfd_drop_all();
    g_proc_table = map_new();
    g_proc_times = map_new();
    g_proc_pidfds = 0;

    return results;
}

# Reap any processes that have exited.
# Returns vec of (name, exit_code) pairs.
# 2026-08-24 audit HIGH-2 — shared empty result.
#
# The PID-1 supervisor loop reaps every 100 ms forever, and the bump
# allocator never reclaims. Returning a fresh vec per tick grew the arena by
# a measured 456 bytes/tick (~375 MB/day, ~11 GB/month) on an idle system;
# PID 1 cannot be restarted, so that ends in an allocation failure and a
# kernel panic. The idle path now allocates nothing.
#
# ⚠ A REAP THAT FINDS AN EXIT ALLOCATES NOTHING EITHER (1.19.0). The idle path was
# fixed first. An exit still cost 184 bytes here and 200 more in
# init_reap_services, forever, so a service that crashes and is restarted paid
# 384 bytes per cycle in an arena PID 1 never resets.
#
# ⚠ CONTRACT: the returned vec and its pairs are valid until the NEXT call, the
# same rule as init_poll_health. A pair is 32 bytes: { name Str, exit code }, then
# the Str itself ({ data, len }, str.cyr), which views the proc table's key. One
# record per exit in a sweep, kept for the life of the process.
var _reap_out = 0;
var _reap_pool = 0;

fn _reap_out_vec() {
    if (_reap_out == 0) { _reap_out = vec_new(); }
    vec_truncate(_reap_out, 0);
    return _reap_out;
}

# Make room in `v` for `n` entries, so pushing them later cannot allocate, and leave
# it empty.
fn _vec_room(v, n) {
    if (vec_cap(v) >= n) { return 0; }
    for (var i = 0; i < n; i = i + 1) { vec_push(v, 0); }
    vec_truncate(v, 0);
    return 0;
}

# Room for `n` exits in one sweep, from argonaut_init_new (`_reactor_reserve`).
fn _reap_reserve(n) {
    if (_reap_pool == 0) { _reap_pool = vec_new(); }
    while (vec_len(_reap_pool) < n) { vec_push(_reap_pool, alloc(32)); }
    _vec_room(_reap_out_vec(), n);
    return 0;
}

fn _reap_pair(out, name, code) {
    if (_reap_pool == 0) { _reap_pool = vec_new(); }
    var i = vec_len(out);
    if (i == vec_len(_reap_pool)) { vec_push(_reap_pool, alloc(32)); }
    var pair = vec_get(_reap_pool, i);
    store64(pair, pair + 16);
    store64(pair + 8, code);
    store64(pair + 16, name);
    store64(pair + 24, strlen(name));
    vec_push(out, pair);
    return pair;
}

fn proc_table_reap() {
    # Iterate the proc table IN PLACE (entries stride 24: key, value,
    # occupied) rather than via map_keys(), which allocated a fresh vec on
    # every tick.
    var exited = _reap_out_vec();
    var entries = map_entries(g_proc_table);
    var cap = map_cap(g_proc_table);

    for (var ki = 0; ki < cap; ki = ki + 1) {
        var ep = entries + ki * 24;
        if (load64(ep + 16) == 1) {
            var name = load64(ep);
            var pid = load64(ep + 8);
            if (pid > 0) {
                var status_buf[8];
                store64(&status_buf, 0);
                # 1.18.0: a pidfd whose process was reaped elsewhere ends the
                # entry with its status lost (-1). Probing its number could
                # reap a different child of ours that was given the number.
                var gone = proc_pidfd_gone(_proc_pidfd_get(name));
                var ret = 0;
                if (gone == 1) {
                    ret = pid;
                } else {
                    ret = sys_waitpid(pid, &status_buf, WNOHANG);
                }
                if (ret > 0) {
                    var status = load64(&status_buf);
                    var code = -1;
                    if (gone == 0) {
                        if (WIFEXITED(status)) { code = WEXITSTATUS(status); }
                    }
                    _reap_pair(exited, name, code);
                }
            }
        }
    }

    # Remove reaped processes, closing their pidfds
    for (var i = 0; i < vec_len(exited); i = i + 1) {
        var pair = vec_get(exited, i);
        var name = str_data(load64(pair));
        _proc_pidfd_drop(name);
        map_delete(g_proc_table, name);
        map_delete(g_proc_times, name);
    }

    return exited;
}

# proc_table_reap_orphans — M3 (PID-1 reaper).
# When argonaut runs as PID 1 (or as a subreaper enrolled via
# `prctl(PR_SET_CHILD_SUBREAPER, 1)`), it inherits orphans whose original
# parents exited (services that re-fork, daemons whose parents exit, etc.).
# These never appear in `g_proc_table`, so `proc_table_reap` skips them
# and they accumulate as zombies. This loop drains *any* exited child
# via `waitpid(-1, ..., WNOHANG)` until ESRCH (-10) or 0 (no waitable).
# Returns the count of orphans reaped.
# Reap reparented orphans, RECORDING the pids into a caller-provided buffer.
#
# ⚠ THE PIDS MATTER, AND DISCARDING THEM CAUSED A REAL DEFECT. `proc_table_reap`
# probes each TRACKED pid first and clears that service's entry when the probe
# reaps it. This sweep runs afterwards and takes everything else — including a
# tracked service that happened to exit in the window between its own probe and
# this call. When that happens the service's entry is never cleared: the next
# tick's `waitpid(pid, WNOHANG)` returns -ECHILD, which is not `> 0`, so
# `managed_svc_set_pid(ms, 0)` never runs and the entry stays STATE_RUNNING with
# a dead pid indefinitely (with no health_check there is no watchdog to notice).
#
# A stale RUNNING entry holding a freed pid is not merely untidy — any process
# that later recycles that pid is attributed to that service, which is exactly
# what sd_notify credential attribution relies on being true.
#
# `out` is a buffer of `cap` i64 slots, or 0 to only count. Allocation-free by
# construction: the caller owns the storage.
fn proc_table_reap_orphans_into(out, cap) {
    var n = 0;
    var draining = 1;
    var guard = 0;
    while (draining == 1 && guard < 256) {
        var status_buf[8];
        var ret = sys_waitpid(-1, &status_buf, WNOHANG);
        if (ret <= 0) { draining = 0; }   # 0 = no exited child; <0 = ECHILD/ESRCH
        else {
            if (out != 0 && n < cap) { store64(out + n * 8, ret); }
            n = n + 1;
        }
        guard = guard + 1;
    }
    return n;
}

# Count-only form. Kept so existing callers are unaffected.
fn proc_table_reap_orphans() {
    return proc_table_reap_orphans_into(0, 0);
}

# =========================================================================
# PID file reading
# =========================================================================

# 2026-08-24 audit MEDIUM-6 (CVE-2018-16888 class): WIRE the ownership
# check. This used to pass -1, which skips it — so the M4 hardening existed
# but the one production call site (src/init.cyr, adopting a forking
# service's PID file) opted out of it. A service whose PID file sits in an
# attacker-writable location could hand argonaut an arbitrary PID to track
# and later signal. systemd's fix for the identical bug is "trust a PID file
# only when it is root-owned"; argonaut generalises that to the uid it is
# itself running as — 0 under PID 1.
#
# Pass an explicit expected uid to read_pid_file_safe when a service is
# known to drop privileges; -1 there still skips the check for a caller that
# genuinely needs the legacy behaviour.
fn read_pid_file(path) {
    return read_pid_file_safe(path, sys_getuid());
}

# open(2) O_NOCTTY: 0x100 on x86_64 and aarch64 alike; the stdlib defines none.
enum ArgOpenFlag { ARG_O_NOCTTY = 256; }

# A pid file's content as a pid: decimal digits only, optionally one trailing
# '\n', value 2..2147483647 — otherwise -1. 1.16.1 audit B-1: `str_to_int`
# joined every digit in the buffer ("12 junk 34" -> 1234) and had no pid_t
# bound, so "4294967295" became kill(-1) once the kernel truncated it.
fn _parse_pid_strict(p, n) {
    if (n <= 0) { return -1; }
    if (load8(p + n - 1) == 10) { n = n - 1; }
    if (n == 0) { return -1; }
    if (n > 10) { return -1; }   # 2147483647 is ten digits
    var v = 0;
    var ok = 1;
    var i = 0;
    while (ok == 1 && i < n) {
        var c = load8(p + i);
        if (c < 48) { ok = 0; }
        if (c > 57) { ok = 0; }
        if (ok == 1) { v = v * 10 + (c - 48); }
        i = i + 1;
    }
    if (ok == 0) { return -1; }
    if (v < 2) { return -1; }
    if (v > 2147483647) { return -1; }
    return v;
}

# read_pid_file_safe — M4 (CVE-2025-4598 class).
# Reads the pid integer from `path` AND verifies the file is owned
# by `expected_uid` and is not group/other-writable. Pass -1 as
# `expected_uid` to skip the ownership check (legacy callers).
# Pass 0 to require root ownership; the production wiring should
# pass the service's expected runtime uid.
#
# ⚠ 1.16.1 audit B-1: THE CHECKS ABOVE VET THE OPENED FILE, SO WHAT GETS OPENED
# MATTERS. A plain open(O_RDONLY) followed a symlink, so the owner/mode checks
# fstat'ed its TARGET: a link to another daemon's root-owned 0644 pid file
# passed, and argonaut adopted — and later SIGKILLed — that daemon. A FIFO
# with no writer parked PID 1 in open(2) for good. So: O_NOFOLLOW (a symlink
# is ELOOP), O_NONBLOCK (a FIFO opens at once and fails S_ISREG below),
# O_NOCTTY (a tty node cannot become init's controlling terminal), O_CLOEXEC.
# O_NOFOLLOW / O_NONBLOCK / O_CLOEXEC are the stdlib's per-arch values (arm64
# O_NOFOLLOW is not x86's). The content is parsed by _parse_pid_strict.
fn read_pid_file_safe(path, expected_uid) {
    var oflags = O_RDONLY | O_NOFOLLOW | O_NONBLOCK | ARG_O_NOCTTY | O_CLOEXEC;
    var fd = sys_open(str_data(path), oflags, 0);
    if (fd < 0) { return -1; }

    # fstat(fd, &stat_buf) — offsets via the arch-dispatched Stat enum.
    #
    # ⚠ These MUST NOT be spelled as literals. `struct stat` is a different
    # shape per arch: x86_64 puts st_mode at +24 / st_uid at +28, while the
    # aarch64 asm-generic layout puts them at +16 / +24. Hardcoding the
    # x86_64 offsets (as this did before 1.13.1) made the aarch64 build read
    # st_uid into `st_mode` and st_gid into `st_uid` — so for a root-owned
    # file both came back 0, `(0 & 18) == 0` passed, and this
    # CVE-2025-4598-class check FAILED OPEN on every world-writable pid file.
    # STAT_MODE / STAT_UID / STAT_BUFSZ come from lib/syscalls.cyr's per-arch
    # peer and resolve correctly on both targets.
    var stat_buf[STAT_BUFSZ];
    var st_ret = syscall(SYS_FSTAT, fd, &stat_buf);
    if (st_ret < 0) {
        sys_close(fd);
        return -1;
    }
    var st_mode = load32(&stat_buf + STAT_MODE);
    var st_uid  = load32(&stat_buf + STAT_UID);

    # 1.16.1 audit B-1: a regular file only (S_IFMT 0xF000, S_IFREG 0x8000) —
    # never a FIFO, socket, device or directory.
    if ((st_mode & 0xF000) != 0x8000) {
        sys_close(fd);
        return -1;
    }

    # Reject group- or other-writable pid files (mode & 0o022 = 18 dec).
    if ((st_mode & 18) != 0) {
        sys_close(fd);
        return -1;
    }
    # Reject ownership mismatch when caller specified an expected uid.
    if (expected_uid >= 0 && st_uid != expected_uid) {
        sys_close(fd);
        return -1;
    }

    # Read pid integer.
    var buf[64];
    var n = sys_read(fd, &buf, 63);
    sys_close(fd);

    var pid = _parse_pid_strict(&buf, n);
    if (pid < 0) { return -1; }
    if (process_alive(pid) == 0) { return -1; }
    return pid;
}
