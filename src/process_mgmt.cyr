# process_mgmt.cyr — Process execution and management
# Spawn, track, signal, and reap service processes.
# Ported from rust-old/src/process.rs
#
# Uses lib/process.cyr for low-level spawn and lib/syscalls.cyr for signals.

# =========================================================================
# Environment file loading
# =========================================================================

# Load KEY=VALUE pairs from a file into a map.
# Lines starting with # are comments. Empty lines ignored.
# Values optionally quoted with " or '.
fn load_env_file(path, env_map) {
    # L4: reject silently-truncated env files. file_read_all caps the
    # read at the buffer size; >8 KB env files would silently lose
    # the tail. Probe the file size first via lseek and fail loud.
    var probe_fd = sys_open(str_data(path), 0, 0);
    if (probe_fd < 0) { return 0 - 1; }
    var sz = syscall(SYS_LSEEK, probe_fd, 0, 2);   # SEEK_END
    sys_close(probe_fd);
    if (sz > 8191) { return 0 - 2; }   # distinct error: file too large
    var buf = alloc(8192);
    var n = file_read_all(str_data(path), buf, 8192);
    if (n <= 0) { return 0 - 1; }

    var line_start = 0;
    for (var i = 0; i <= n; i = i + 1) {
        var c = 0;
        if (i < n) { c = load8(buf + i); }

        if (c == 10 || i == n) {  # newline or EOF
            var line_len = i - line_start;
            if (line_len > 0) {
                var first = load8(buf + line_start);
                if (first != 35) {  # not '#'
                    # Find '=' separator
                    var eq_pos = 0 - 1;
                    for (var j = line_start; j < i; j = j + 1) {
                        if (load8(buf + j) == 61) {  # '='
                            eq_pos = j;
                            break;
                        }
                    }
                    if (eq_pos > line_start) {
                        # Null-terminate key in-place for map lookup
                        var saved = load8(buf + eq_pos);
                        store8(buf + eq_pos, 0);
                        var val_start = eq_pos + 1;
                        var val_len = i - val_start;
                        # Strip optional quotes
                        if (val_len >= 2) {
                            var first_q = load8(buf + val_start);
                            var last_q = load8(buf + val_start + val_len - 1);
                            if ((first_q == 34 && last_q == 34) || (first_q == 39 && last_q == 39)) {
                                val_start = val_start + 1;
                                val_len = val_len - 2;
                            }
                        }
                        # Copy key and value to heap
                        var key_len = eq_pos - line_start;
                        var key_copy = alloc(key_len + 1);
                        memcpy(key_copy, buf + line_start, key_len);
                        store8(key_copy + key_len, 0);
                        var val_copy = alloc(val_len + 1);
                        memcpy(val_copy, buf + val_start, val_len);
                        store8(val_copy + val_len, 0);
                        var val = str_new(val_copy, val_len);
                        map_set(env_map, key_copy, val);
                        store8(buf + eq_pos, saved);
                    }
                }
            }
            line_start = i + 1;
        }
    }
    return 0;
}

# Load and merge env vars from multiple file paths (vec of Str).
fn load_env_files(paths) {
    var merged = map_new();
    for (var i = 0; i < vec_len(paths); i = i + 1) {
        load_env_file(vec_get(paths, i), merged);
    }
    return merged;
}

# =========================================================================
# SafeCommand execution
# =========================================================================

# POSIX access(2) mode bits. The cyrius stdlib exposes sys_access but not
# these constants.
enum ArgAccessMode { ARG_F_OK = 0; ARG_X_OK = 1; }

# Resolve a SafeCommand binary to an ABSOLUTE path, or 0 if not found.
#
# ⚠ THIS IS LOAD-BEARING, NOT A CONVENIENCE. run_safe_cmd ultimately calls
# the stdlib's exec_vec_str, which does a bare `sys_execve(cmd, argv, envp)`
# — and **execve(2) does not search $PATH**. A pathname containing no slash
# is resolved relative to the CWD, so `execve("veritysetup", ...)` fails
# ENOENT and the forked child dies on exec_vec_str's `sys_exit(127)`.
#
# Every SafeCommand in src/edge_boot.cyr was built with a bare name —
# "mount", "veritysetup", "cryptsetup" — so the entire edge-boot execution
# path returned 127 on every command and could never have succeeded. It went
# unnoticed because no consumer imported that module. Verified against
# cyrius 6.5.35: exec_vec_str(["true"]) -> 127, exec_vec_str(["/bin/true"])
# -> 0. Fixed 1.13.2, found by kybernet's v1.5.7 edge-boot work.
#
# The envp exec_vec_str passes is empty, so a PATH inherited from the parent
# would not help even if execve honoured it. Resolution has to happen here.
fn _resolve_safe_binary(name) {
    # Already an explicit path — caller's choice, use it verbatim.
    if (str_index_of(name, 47) >= 0) { return name; }

    # sbin first: these are admin tools. On a merged-usr system the first
    # two resolve through the symlink anyway; on a split-usr one they do not,
    # which is exactly why all four are tried.
    var dirs = vec_new();
    vec_push(dirs, "/usr/sbin/");
    vec_push(dirs, "/sbin/");
    vec_push(dirs, "/usr/bin/");
    vec_push(dirs, "/bin/");

    for (var i = 0; i < vec_len(dirs); i = i + 1) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, vec_get(dirs, i));
        str_builder_add_str(sb, name);
        var cand = str_builder_build(sb);
        if (sys_access(str_data(cand), ARG_X_OK) == 0) { return cand; }
    }
    return 0;
}

# Default wall-clock bound for a SafeCommand. Generous: these are
# veritysetup / cryptsetup / mount against real block devices.
enum SafeCmdLimits { SAFE_CMD_DEFAULT_TIMEOUT_MS = 30000; }

# Run a SafeCommand under a wall-clock bound. Returns the child's exit code,
# 127 when the binary cannot be found, or -1 on spawn failure, wait failure,
# or timeout.
#
# ⚠ THIS DELIBERATELY DOES NOT USE THE STDLIB'S exec_vec_str. 1.13.2.
# That function has two properties that are merely untidy in a CLI and
# unacceptable on a PID-1 trust path:
#
#   1. UNBOUNDED, UNINTERRUPTIBLE WAIT. `sys_waitpid(pid, &stbuf, 0)` — no
#      WNOHANG, no deadline. A consumer that blocks SIGCHLD/SIGTERM for a
#      signalfd (kybernet does) cannot even break it with EINTR. A
#      cryptsetup stalled on a wedged block device hangs init forever.
#   2. FAIL-OPEN. It discards waitpid's return value and reads the status
#      buffer unconditionally — and `var stbuf[4]` is STATIC storage in
#      cyrius, not stack (verified on 6.5.35: same address across calls,
#      contents persist). So a failed wait reports whatever the PREVIOUS
#      command exited with, or 0 on the first call. Zero means WIFEXITED
#      true, WEXITSTATUS 0 — SUCCESS. On `veritysetup open` that is a
#      verification that never ran reported as verified.
#
# Neither is fixable from here (lib/process.cyr is the toolchain's), so the
# exec is done directly with a bounded, status-checked wait modelled on
# process_stop. The child also gets reset_child_signal_mask() — exec_vec_str
# omits it, so an inherited PID-1 mask would leave cryptsetup unkillable by
# SIGTERM.
# ⚠ STATIC argv AND envp. 1.14.0.
#
# These were `alloc((argc + 2) * 8)` and `alloc(16)` per invocation — 32 bytes a
# call, which is nothing for the edge-boot callers that run once per boot and is
# a slow leak for `check_command`, which runs once per health poll per service on
# PID 1's reactor path in an arena that is never reset.
#
# Static is safe here and the reason is specific: the buffers are consumed
# synchronously — filled, handed to `execve` in the child, and dead in the parent
# the moment `fork` returns. `fork` gives the child its own copy, so the parent
# reusing the buffer on the next call cannot affect a running child. PID 1's
# reactor is single-threaded and this function does not recurse.
#
# ⚠ GLOBAL SCOPE, so `[18]` is 18 SLOTS = 144 bytes — 16 argv entries plus argv[0]
# plus the NULL terminator. An argv longer than that is REFUSED rather than
# truncated: a silently shortened argv is a different command.
var _RSC_ARGV[18];
var _RSC_ENVP[2];

fn run_safe_cmd_timeout(cmd, timeout_ms) {
    var resolved = _resolve_safe_binary(safe_cmd_binary(cmd));
    if (resolved == 0) { return 127; }
    var cmd_args = safe_cmd_args(cmd);
    var argc = vec_len(cmd_args);
    if (argc > 16) { return 127; }

    # argv[0] is the RESOLVED path. Caller-side argv elements are Str
    # throughout argonaut, so each needs str_data for the execve array.
    var argv_buf = &_RSC_ARGV;
    store64(argv_buf, str_data(resolved));
    for (var i = 0; i < argc; i = i + 1) {
        store64(argv_buf + (i + 1) * 8, str_data(vec_get(cmd_args, i)));
    }
    store64(argv_buf + (argc + 1) * 8, 0);

    var envp = &_RSC_ENVP;
    store64(envp, "PATH=/usr/sbin:/sbin:/usr/bin:/bin");
    store64(envp + 8, 0);

    var pid = sys_fork();
    if (pid < 0) { return 0 - 1; }
    if (pid == 0) {
        reset_child_signal_mask();
        sys_execve(str_data(resolved), argv_buf, envp);
        sys_exit(127);
    }

    var deadline = monotonic_ms() + timeout_ms;
    while (monotonic_ms() < deadline) {
        var status_buf[8];
        store64(&status_buf, 0);
        var ret = sys_waitpid(pid, &status_buf, WNOHANG);
        if (ret > 0) {
            var status = load32(&status_buf);
            if (WIFEXITED(status)) { return WEXITSTATUS(status); }
            if (WIFSIGNALED(status)) { return 128 + WTERMSIG(status); }
            return 0 - 1;
        }
        # ret < 0 is a real wait failure (ECHILD, EINVAL). Report it as
        # failure — never fall through to a status read, which is exactly
        # the fail-open this function exists to avoid.
        if (ret < 0) { return 0 - 1; }
        sleep_ms(20);
    }

    # Over budget. Kill it and reap, so PID 1 is not left with a stray
    # child and the caller gets a failure rather than a hang.
    process_kill(pid);
    var kill_deadline = monotonic_ms() + 500;
    while (monotonic_ms() < kill_deadline) {
        var kbuf[8];
        store64(&kbuf, 0);
        if (sys_waitpid(pid, &kbuf, WNOHANG) != 0) { break; }
        sleep_ms(20);
    }
    return 0 - 1;
}

# Run a SafeCommand under the default bound and return its exit code.
fn run_safe_cmd(cmd) {
    return run_safe_cmd_timeout(cmd, SAFE_CMD_DEFAULT_TIMEOUT_MS);
}

# Run a sequence of SafeCommands, stopping on first failure.
fn run_safe_cmd_sequence(cmds) {
    for (var i = 0; i < vec_len(cmds); i = i + 1) {
        var code = run_safe_cmd(vec_get(cmds, i));
        if (code != 0) { return code; }
    }
    return 0;
}

# =========================================================================
# Process spawning for services
# =========================================================================

# Spawn a service process. Returns child PID or -1 on error.
# 1.6.1 — exec_env_str (Str-shape argv) — see run_safe_cmd note.
fn spawn_service(svc_def) {
    var binary = svc_def_binary(svc_def);
    var args = svc_def_args(svc_def);

    var argv = vec_new();
    vec_push(argv, binary);
    for (var i = 0; i < vec_len(args); i = i + 1) {
        vec_push(argv, vec_get(args, i));
    }

    var env = svc_def_env(svc_def);

    return exec_env_str(argv, env);
}

# reset_child_signal_mask: clear the inherited signal mask
# (1.6.3 audit MEDIUM-1). The PID-1 supervisor loop in
# `src/main.cyr` blocks SIGTERM/SIGINT/SIGCHLD so the signalfd
# read path can drain them; fork inherits that block, and
# execve preserves it. Services started without their default
# disposition can't handle SIGTERM (the kernel queues it against
# the masked process indefinitely). Reset to empty before exec.
fn reset_child_signal_mask() {
    var empty = sigset_new();
    return sys_sigprocmask(SIG_SETMASK, empty, 0);
}

# Extra environment entries a supervisor wants every service to inherit,
# as `KEY=value` cstrs. Appended after PATH by build_default_envp.
#
# Added 1.12.0. argonaut builds the child's envp itself (it must — the exec
# happens inside fork_exec_service), so a consumer had no way to put
# anything in a service's environment. The concrete case: kybernet binds an
# sd_notify socket, registers it with epoll and has a handler for it, but no
# service could ever find it, because discovery is by $NOTIFY_SOCKET and
# nothing set it. The whole readiness/watchdog-ping path was unreachable
# from the service side. Found by kybernet's rust-old port review — the
# Rust implementation did `env::set_var("NOTIFY_SOCKET", ...)` right after
# binding.
#
# Entries are cstrs, not Str: they go straight into the execve envp array.
# The caller owns their lifetime, which must outlive every spawn — string
# literals or arena-allocated buffers, not stack.
var _extra_envp = 0;

fn argonaut_set_extra_env(v) {
    var prev = _extra_envp;
    _extra_envp = v;
    return prev;
}

fn argonaut_extra_env() { return _extra_envp; }

# build_default_envp: minimal PATH-only environment vec for services spawned
# without an explicit env (1.6.3 audit MEDIUM-2). The pre-1.6.3 empty envp
# dropped PATH entirely; this gives every service a usable PATH without
# needing per-service config. Full `svc_def_env` map → flat-cstrs conversion
# lands when a service legitimately needs custom env. Since 1.12.0 it also
# appends whatever argonaut_set_extra_env registered.
fn build_default_envp() {
    var v = vec_new();
    vec_push(v, "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin");
    if (_extra_envp != 0) {
        for (var i = 0; i < vec_len(_extra_envp); i = i + 1) {
            vec_push(v, vec_get(_extra_envp, i));
        }
    }
    return v;
}

# ⚠ THE SERVICE'S OWN `environment` MAP, FLATTENED TO "KEY=VALUE" cstrs. 1.16.0.
#
# `ServiceDefinition.environment` has existed since the beginning and
# `fork_exec_service` never read it: envp came from `build_default_envp()`
# alone. The comment there said "full map -> flat-cstrs lands when a service
# surfaces a need for custom env beyond PATH" — a service has, so it lands.
#
# The consequence of not having it was worse than an absent feature. Consumers
# CAN populate the map — argonaut's own `default_services` does, setting PGDATA
# and XDG_SESSION_TYPE (services.cyr:21, :221) — and none of it ever reached a
# child. Those two have been silently ineffective for the life of the field.
#
# Called in the CHILD after fork, so the allocations here are copy-on-write and
# die with the exec. Service entries come AFTER the defaults, so a service may
# deliberately override PATH; the last duplicate wins in every libc's getenv.
fn _append_service_env(v, svc_def) {
    var env = svc_def_env(svc_def);
    if (env == 0) { return 0; }
    var keys = map_keys(env);
    if (keys == 0) { return 0; }
    for (var i = 0; i < vec_len(keys); i = i + 1) {
        var k = vec_get(keys, i);
        var val = map_get(env, k);
        if (val == 0) { continue; }
        var sb = str_builder_new();
        str_builder_add_cstr(sb, k);
        str_builder_add_cstr(sb, "=");
        str_builder_add_str(sb, val);
        vec_push(v, str_data(str_builder_build(sb)));
    }
    return 0;
}

# =========================================================================
# Pre-exec hook (1.9.0)
# =========================================================================
#
# A consumer-supplied callback run in the CHILD, after fork and after the
# signal-mask reset, immediately before execve. It receives the service's
# ServiceDefinition and returns 0 to proceed with exec or non-zero to abort
# the child.
#
# This exists because seccomp, Landlock and capability drops can ONLY be
# installed between fork and exec, and argonaut owns that window. Without a
# seam here a supervisor built on argonaut cannot sandbox its services at
# all, no matter how much policy code it has — which is exactly the state
# kybernet was in when its 2026-08-24 audit filed HIGH-1 against 686 lines
# of seccomp/Landlock/privdrop that were reachable from nothing.
#
# argonaut deliberately does NOT interpret the policy. It supplies the
# window and the ServiceDefinition (whose seccomp / landlock / capabilities
# fields the consumer can read via the accessors in types.cyr); the
# consumer owns the meaning. That keeps the security model out of the
# service manager and in the thing that has an opinion about it.
#
# CONTRACT for hook implementors — this runs in a forked child of PID 1:
#   * It must not allocate unboundedly, block, or fork.
#   * A non-zero return aborts the child with exit 126 rather than execing,
#     so a policy that cannot be applied FAILS CLOSED. Never return 0 on a
#     failed restriction.
#   * Ordering is the caller's problem, but the workable order is
#     no_new_privs -> capability/uid/gid drop -> Landlock -> seccomp, since
#     an installed seccomp filter will otherwise kill the drop syscalls.
var _pre_exec_hook = 0;

# Register the pre-exec callback. Pass 0 to clear. Returns the previous
# hook so a caller can chain or restore.
fn argonaut_set_pre_exec_hook(fp) {
    var prev = _pre_exec_hook;
    _pre_exec_hook = fp;
    return prev;
}

fn argonaut_pre_exec_hook() { return _pre_exec_hook; }

# Fork + exec a service, returning child PID.
# Parent returns immediately; child execs the binary.
fn fork_exec_service(svc_def) {
    var sn = svc_def_name(svc_def);
    sakshi_debug(str_data(sn), str_len(sn));

    var pid = sys_fork();
    if (pid < 0) { return 0 - 1; }

    if (pid == 0) {
        # Child process
        # L3: detach from argonaut's controlling TTY so signals on the
        # parent terminal (e.g. ^C when argonaut is foregrounded for
        # testing) don't reach service children, and so each service
        # gets its own session. Non-fatal — already-session-leader
        # callers return EPERM and we proceed.
        sys_setsid();

        # Redirect stdin to /dev/null and (L3) replace stdout / stderr
        # so service log output stops mixing into argonaut's stdio.
        # Production wiring should swap /dev/null for the journal fd.
        var devnull_r = sys_open("/dev/null", 0, 0);   # O_RDONLY
        if (devnull_r >= 0) {
            sys_dup2(devnull_r, 0);
            sys_close(devnull_r);
        }
        var devnull_w = sys_open("/dev/null", 1, 0);   # O_WRONLY
        if (devnull_w >= 0) {
            sys_dup2(devnull_w, 1);
            sys_dup2(devnull_w, 2);
            sys_close(devnull_w);
        }

        # Exec the binary directly via sys_execve — we're already
        # in the forked child; calling `exec_env_str` here would
        # fork AGAIN and the grandchild's session would be the
        # intermediate's (since setsid above applied to the
        # intermediate). L3 then fails: the exec'd process inherits
        # the intermediate's session id rather than becoming its
        # own session leader. Build argv + envp in-place and
        # execve directly. (Audit caught this at the 1.6.2 PID-1
        # harness — pre-1.6.2 fork_exec_service path was
        # double-forked.)
        var binary = svc_def_binary(svc_def);
        var args = svc_def_args(svc_def);

        var argc = vec_len(args) + 1;
        var argv_buf = alloc((argc + 1) * 8);
        store64(argv_buf, str_data(binary));
        var ai = 0;
        while (ai < vec_len(args)) {
            store64(argv_buf + (ai + 1) * 8, str_data(vec_get(args, ai)));
            ai = ai + 1;
        }
        store64(argv_buf + argc * 8, 0);

        # Environment (1.6.3 audit MEDIUM-2): pass a minimal
        # default envp containing PATH. Pre-1.6.3 passed empty
        # envp; services lost PATH silently. Full map →
        # flat-cstrs lands when a service surfaces a need for
        # custom env beyond PATH.
        var env_vec = build_default_envp();
        _append_service_env(env_vec, svc_def);
        var envc = vec_len(env_vec);
        var envp_buf = alloc((envc + 1) * 8);
        var enpi = 0;
        while (enpi < envc) {
            store64(envp_buf + enpi * 8, vec_get(env_vec, enpi));
            enpi = enpi + 1;
        }
        store64(envp_buf + envc * 8, 0);

        # Reset signal mask (1.6.3 audit MEDIUM-1) — drop the
        # PID-1 supervisor loop's SIGTERM/SIGINT/SIGCHLD block
        # before exec so the service can install its own handlers
        # and receive shutdown signals.
        reset_child_signal_mask();

        # Pre-exec hook (1.9.0) — LAST thing before execve, so anything it
        # installs (seccomp, Landlock, dropped capabilities) is in force for
        # the exec'd image. Deliberately after the signal reset: a hook that
        # installs a seccomp filter would otherwise have to allowlist
        # rt_sigprocmask purely to let the reset run.
        #
        # Fails CLOSED. A hook that reports failure means the sandbox could
        # not be established, and running the service unsandboxed is the one
        # outcome worse than not running it — exit 126 (distinct from 127,
        # "exec failed") so the supervisor can tell the two apart.
        if (_pre_exec_hook != 0) {
            if (fncall1(_pre_exec_hook, svc_def) != 0) {
                sys_exit(126);
            }
        }

        sys_execve(str_data(binary), argv_buf, envp_buf);
        sys_exit(127);  # exec failed
    }

    return pid;  # Parent returns child PID
}

# =========================================================================
# Process table — tracks running service processes
# =========================================================================

# Process table is a map: service_name -> pid
# Started-at times: separate map: service_name -> monotonic_ms
var g_proc_table = 0;
var g_proc_times = 0;

fn proc_table_init() {
    g_proc_table = map_new();
    g_proc_times = map_new();
}

fn proc_table_insert(name, pid) {
    map_set(g_proc_table, str_data(name), pid);
    map_set(g_proc_times, str_data(name), monotonic_ms());
}

fn proc_table_remove(name) {
    map_delete(g_proc_table, str_data(name));
    map_delete(g_proc_times, str_data(name));
}

fn proc_table_pid(name) {
    return map_get(g_proc_table, str_data(name));
}

fn proc_table_has(name) {
    return map_has(g_proc_table, str_data(name));
}

fn proc_table_uptime_ms(name) {
    var started = map_get(g_proc_times, str_data(name));
    if (started == 0) { return 0; }
    return monotonic_ms() - started;
}

fn proc_table_count() {
    return map_count(g_proc_table);
}

fn proc_table_keys() {
    return map_keys(g_proc_table);
}

# Check if a process is alive via kill(pid, 0)
fn process_alive(pid) {
    if (pid <= 0) { return 0; }
    var ret = sys_kill(pid, 0);
    return ret == 0;
}

# Send SIGTERM to a process
fn process_terminate(pid) {
    return sys_kill(pid, SIGTERM);
}

# Send SIGKILL to a process
fn process_kill(pid) {
    return sys_kill(pid, SIGKILL);
}

# Graceful stop: SIGTERM, wait up to timeout_ms, then SIGKILL.
# Returns exit code or -1.
fn process_stop(pid, timeout_ms) {
    process_terminate(pid);

    var deadline = monotonic_ms() + timeout_ms;
    while (monotonic_ms() < deadline) {
        var status_buf[8];
        var ret = sys_waitpid(pid, &status_buf, WNOHANG);
        if (ret > 0) {
            var status = load64(&status_buf);
            if (WIFEXITED(status)) { return WEXITSTATUS(status); }
            if (WIFSIGNALED(status)) { return 128 + WTERMSIG(status); }
            return 0 - 1;
        }
        sleep_ms(50);
    }

    # Timed out — SIGKILL
    sakshi_warn("SIGKILL", 7);
    process_kill(pid);

    # Wait up to 500ms for SIGKILL
    var kill_deadline = monotonic_ms() + 500;
    while (monotonic_ms() < kill_deadline) {
        var status_buf[8];
        var ret = sys_waitpid(pid, &status_buf, WNOHANG);
        if (ret > 0) {
            var status = load64(&status_buf);
            if (WIFEXITED(status)) { return WEXITSTATUS(status); }
            if (WIFSIGNALED(status)) { return 128 + WTERMSIG(status); }
            return 0 - 1;
        }
        sleep_ms(10);
    }

    return 0 - 1;
}

# Stop all tracked processes
fn proc_table_stop_all(timeout_ms) {
    var results = vec_new();
    var keys = proc_table_keys();

    # Send SIGTERM to all
    for (var i = 0; i < vec_len(keys); i = i + 1) {
        var name = vec_get(keys, i);
        var pid = map_get(g_proc_table, name);
        if (pid > 0) { process_terminate(pid); }
    }

    # Wait with timeout
    var deadline = monotonic_ms() + timeout_ms;
    var remaining = vec_new();
    for (var i = 0; i < vec_len(keys); i = i + 1) {
        vec_push(remaining, vec_get(keys, i));
    }

    while (vec_len(remaining) > 0 && monotonic_ms() < deadline) {
        var still_alive = vec_new();
        for (var i = 0; i < vec_len(remaining); i = i + 1) {
            var name = vec_get(remaining, i);
            var pid = map_get(g_proc_table, name);
            if (pid > 0) {
                var status_buf[8];
                var ret = sys_waitpid(pid, &status_buf, WNOHANG);
                if (ret > 0) {
                    var status = load64(&status_buf);
                    var code = 0 - 1;
                    if (WIFEXITED(status)) { code = WEXITSTATUS(status); }
                    # Pack name + code into result
                    var pair = alloc(16);
                    store64(pair, str_from(name));
                    store64(pair + 8, code);
                    vec_push(results, pair);
                } else {
                    vec_push(still_alive, name);
                }
            }
        }
        remaining = still_alive;
        if (vec_len(remaining) > 0) {
            sleep_ms(50);
        }
    }

    # SIGKILL anything still alive
    for (var i = 0; i < vec_len(remaining); i = i + 1) {
        var name = vec_get(remaining, i);
        var pid = map_get(g_proc_table, name);
        if (pid > 0) { process_kill(pid); }
        var pair = alloc(16);
        store64(pair, str_from(name));
        store64(pair + 8, 0 - 1);
        vec_push(results, pair);
    }

    # Clear the table
    g_proc_table = map_new();
    g_proc_times = map_new();

    return results;
}

# Reap any processes that have exited.
# Returns vec of (name, exit_code) pairs.
# 2026-08-24 audit HIGH-2 — shared empty result.
#
# The PID-1 supervisor loop reaps every 100 ms forever, and the bump
# allocator never reclaims. Returning a fresh vec per tick grew the arena by
# a measured 456 bytes/tick (~375 MB/day, ~11 GB/month) on an idle system;
# PID 1 cannot be restarted, so that ends in an allocation failure and a
# kernel panic. The idle path now allocates nothing.
#
# This vec is handed to callers as an empty result and is NEVER mutated —
# `proc_table_reap` swaps to a freshly allocated vec the moment there is an
# actual exit to report. Do not push into it.
var _reap_empty = 0;

fn _reap_empty_vec() {
    if (_reap_empty == 0) { _reap_empty = vec_new(); }
    return _reap_empty;
}

fn proc_table_reap() {
    # Iterate the proc table IN PLACE (entries stride 24: key, value,
    # occupied) rather than via map_keys(), which allocated a fresh vec on
    # every tick. `exited` is allocated lazily, only once something has
    # actually exited.
    var exited = 0;
    var entries = map_entries(g_proc_table);
    var cap = map_cap(g_proc_table);

    for (var ki = 0; ki < cap; ki = ki + 1) {
        var ep = entries + ki * 24;
        if (load64(ep + 16) == 1) {
            var name = load64(ep);
            var pid = load64(ep + 8);
            if (pid > 0) {
                var status_buf[8];
                var ret = sys_waitpid(pid, &status_buf, WNOHANG);
                if (ret > 0) {
                    var status = load64(&status_buf);
                    var code = 0 - 1;
                    if (WIFEXITED(status)) { code = WEXITSTATUS(status); }
                    if (exited == 0) { exited = vec_new(); }
                    var pair = alloc(16);
                    store64(pair, str_from(name));
                    store64(pair + 8, code);
                    vec_push(exited, pair);
                }
            }
        }
    }

    if (exited == 0) { return _reap_empty_vec(); }

    # Remove reaped processes
    for (var i = 0; i < vec_len(exited); i = i + 1) {
        var pair = vec_get(exited, i);
        var name = str_data(load64(pair));
        map_delete(g_proc_table, name);
        map_delete(g_proc_times, name);
    }

    return exited;
}

# proc_table_reap_orphans — M3 (PID-1 reaper).
# When argonaut runs as PID 1 (or as a subreaper enrolled via
# `prctl(PR_SET_CHILD_SUBREAPER, 1)`), it inherits orphans whose original
# parents exited (services that re-fork, daemons whose parents exit, etc.).
# These never appear in `g_proc_table`, so `proc_table_reap` skips them
# and they accumulate as zombies. This loop drains *any* exited child
# via `waitpid(-1, ..., WNOHANG)` until ESRCH (-10) or 0 (no waitable).
# Returns the count of orphans reaped.
# Reap reparented orphans, RECORDING the pids into a caller-provided buffer.
#
# ⚠ THE PIDS MATTER, AND DISCARDING THEM CAUSED A REAL DEFECT. `proc_table_reap`
# probes each TRACKED pid first and clears that service's entry when the probe
# reaps it. This sweep runs afterwards and takes everything else — including a
# tracked service that happened to exit in the window between its own probe and
# this call. When that happens the service's entry is never cleared: the next
# tick's `waitpid(pid, WNOHANG)` returns -ECHILD, which is not `> 0`, so
# `managed_svc_set_pid(ms, 0)` never runs and the entry stays STATE_RUNNING with
# a dead pid indefinitely (with no health_check there is no watchdog to notice).
#
# A stale RUNNING entry holding a freed pid is not merely untidy — any process
# that later recycles that pid is attributed to that service, which is exactly
# what sd_notify credential attribution relies on being true.
#
# `out` is a buffer of `cap` i64 slots, or 0 to only count. Allocation-free by
# construction: the caller owns the storage.
fn proc_table_reap_orphans_into(out, cap) {
    var n = 0;
    for (var guard = 0; guard < 256; guard = guard + 1) {
        var status_buf[8];
        var ret = sys_waitpid(0 - 1, &status_buf, WNOHANG);
        if (ret <= 0) { break; }   # 0 = no exited child; <0 = ECHILD/ESRCH
        if (out != 0 && n < cap) { store64(out + n * 8, ret); }
        n = n + 1;
    }
    return n;
}

# Count-only form. Kept so existing callers are unaffected.
fn proc_table_reap_orphans() {
    return proc_table_reap_orphans_into(0, 0);
}

# =========================================================================
# PID file reading
# =========================================================================

# 2026-08-24 audit MEDIUM-6 (CVE-2018-16888 class): WIRE the ownership
# check. This used to pass -1, which skips it — so the M4 hardening existed
# but the one production call site (src/init.cyr, adopting a forking
# service's PID file) opted out of it. A service whose PID file sits in an
# attacker-writable location could hand argonaut an arbitrary PID to track
# and later signal. systemd's fix for the identical bug is "trust a PID file
# only when it is root-owned"; argonaut generalises that to the uid it is
# itself running as — 0 under PID 1.
#
# Pass an explicit expected uid to read_pid_file_safe when a service is
# known to drop privileges; -1 there still skips the check for a caller that
# genuinely needs the legacy behaviour.
fn read_pid_file(path) {
    return read_pid_file_safe(path, sys_getuid());
}

# read_pid_file_safe — M4 (CVE-2025-4598 class).
# Reads the pid integer from `path` AND verifies the file is owned
# by `expected_uid` and is not group/other-writable. Pass -1 as
# `expected_uid` to skip the ownership check (legacy callers).
# Pass 0 to require root ownership; the production wiring should
# pass the service's expected runtime uid.
fn read_pid_file_safe(path, expected_uid) {
    var fd = sys_open(str_data(path), 0, 0);   # O_RDONLY
    if (fd < 0) { return 0 - 1; }

    # fstat(fd, &stat_buf) — offsets via the arch-dispatched Stat enum.
    #
    # ⚠ These MUST NOT be spelled as literals. `struct stat` is a different
    # shape per arch: x86_64 puts st_mode at +24 / st_uid at +28, while the
    # aarch64 asm-generic layout puts them at +16 / +24. Hardcoding the
    # x86_64 offsets (as this did before 1.13.1) made the aarch64 build read
    # st_uid into `st_mode` and st_gid into `st_uid` — so for a root-owned
    # file both came back 0, `(0 & 18) == 0` passed, and this
    # CVE-2025-4598-class check FAILED OPEN on every world-writable pid file.
    # STAT_MODE / STAT_UID / STAT_BUFSZ come from lib/syscalls.cyr's per-arch
    # peer and resolve correctly on both targets.
    var stat_buf[STAT_BUFSZ];
    var st_ret = syscall(SYS_FSTAT, fd, &stat_buf);
    if (st_ret < 0) {
        sys_close(fd);
        return 0 - 1;
    }
    var st_mode = load32(&stat_buf + STAT_MODE);
    var st_uid  = load32(&stat_buf + STAT_UID);

    # Reject group- or other-writable pid files (mode & 0o022 = 18 dec).
    if ((st_mode & 18) != 0) {
        sys_close(fd);
        return 0 - 1;
    }
    # Reject ownership mismatch when caller specified an expected uid.
    if (expected_uid >= 0 && st_uid != expected_uid) {
        sys_close(fd);
        return 0 - 1;
    }

    # Read pid integer.
    var buf[64];
    var n = sys_read(fd, &buf, 63);
    sys_close(fd);
    if (n <= 0) { return 0 - 1; }
    store8(&buf + n, 0);

    var pid = str_to_int(str_new(&buf, n));
    if (pid <= 0) { return 0 - 1; }
    if (process_alive(pid) == 0) { return 0 - 1; }
    return pid;
}
