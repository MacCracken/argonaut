# types.cyr — Argonaut type definitions
# Enums, structs, and configuration types for the init system.
# Ported from rust-old/src/types.rs (1463 lines)

# =========================================================================
# Boot mode
# =========================================================================

enum BootMode {
    BOOT_SERVER;
    BOOT_DESKTOP;
    BOOT_MINIMAL;
    BOOT_EDGE;
    BOOT_RECOVERY;
}

fn boot_mode_str(mode) {
    if (mode == BOOT_SERVER)   { return "server"; }
    if (mode == BOOT_DESKTOP)  { return "desktop"; }
    if (mode == BOOT_MINIMAL)  { return "minimal"; }
    if (mode == BOOT_EDGE)     { return "edge"; }
    if (mode == BOOT_RECOVERY) { return "recovery"; }
    return "unknown";
}

# Inverse of boot_mode_str. See restart_policy_parse for the rationale.
fn boot_mode_parse(s) {
    if (str_eq_cstr(s, "server") == 1)   { return Ok(BOOT_SERVER); }
    if (str_eq_cstr(s, "desktop") == 1)  { return Ok(BOOT_DESKTOP); }
    if (str_eq_cstr(s, "minimal") == 1)  { return Ok(BOOT_MINIMAL); }
    if (str_eq_cstr(s, "edge") == 1)     { return Ok(BOOT_EDGE); }
    if (str_eq_cstr(s, "recovery") == 1) { return Ok(BOOT_RECOVERY); }
    return Err(EINVAL);
}

# =========================================================================
# Boot stages
# =========================================================================

enum BootStage {
    STAGE_MOUNT_FS;
    STAGE_DEVICE_MGR;
    STAGE_VERIFY_ROOTFS;
    STAGE_SECURITY;
    STAGE_DATABASE;
    STAGE_AGENT_RUNTIME;
    STAGE_LLM_GATEWAY;
    STAGE_MODEL_SERVICES;
    STAGE_COMPOSITOR;
    STAGE_SHELL;
    STAGE_BOOT_COMPLETE;
}

fn boot_stage_str(stage) {
    if (stage == STAGE_MOUNT_FS)        { return "mount-filesystems"; }
    if (stage == STAGE_DEVICE_MGR)      { return "start-device-manager"; }
    if (stage == STAGE_VERIFY_ROOTFS)   { return "verify-rootfs"; }
    if (stage == STAGE_SECURITY)        { return "start-security"; }
    if (stage == STAGE_DATABASE)        { return "start-database-services"; }
    if (stage == STAGE_AGENT_RUNTIME)   { return "start-agent-runtime"; }
    if (stage == STAGE_LLM_GATEWAY)     { return "start-llm-gateway"; }
    if (stage == STAGE_MODEL_SERVICES)  { return "start-model-services"; }
    if (stage == STAGE_COMPOSITOR)      { return "start-compositor"; }
    if (stage == STAGE_SHELL)           { return "start-shell"; }
    if (stage == STAGE_BOOT_COMPLETE)   { return "boot-complete"; }
    return "unknown";
}

# =========================================================================
# Boot step status
# =========================================================================

enum BootStepStatus {
    STEP_PENDING;
    STEP_RUNNING;
    STEP_COMPLETE;
    STEP_FAILED;
    STEP_SKIPPED;
}

fn step_status_str(s) {
    if (s == STEP_PENDING)  { return "pending"; }
    if (s == STEP_RUNNING)  { return "running"; }
    if (s == STEP_COMPLETE) { return "complete"; }
    if (s == STEP_FAILED)   { return "failed"; }
    if (s == STEP_SKIPPED)  { return "skipped"; }
    return "unknown";
}

# =========================================================================
# Boot step
# =========================================================================

struct BootStep {
    stage;          # BootStage enum
    description;    # Str ptr
    required;       # 1/0
    timeout_ms;     # i64
    status;         # BootStepStatus enum
    started_at;     # epoch ms (0 = not set)
    completed_at;   # epoch ms (0 = not set)
    error;          # Str ptr (0 = no error)
}

fn boot_step_new(stage, desc, required, timeout_ms) {
    var s = alloc(sizeof(BootStep));
    store64(s, stage);
    store64(s + 8, desc);
    store64(s + 16, required);
    store64(s + 24, timeout_ms);
    store64(s + 32, STEP_PENDING);
    store64(s + 40, 0);
    store64(s + 48, 0);
    store64(s + 56, 0);
    return s;
}

# =========================================================================
# Restart policy
# =========================================================================

enum RestartPolicy {
    RESTART_ALWAYS;
    RESTART_ON_FAILURE;
    RESTART_NEVER;
}

fn restart_policy_str(p) {
    if (p == RESTART_ALWAYS)     { return "always"; }
    if (p == RESTART_ON_FAILURE) { return "on-failure"; }
    if (p == RESTART_NEVER)      { return "never"; }
    return "unknown";
}

# Inverse of restart_policy_str. Takes a Str, returns Ok(policy) or
# Err(EINVAL).
#
# Every enum here had a `*_str` and no inverse, so each consumer that reads
# a service definition out of config had to hand-roll its own string ->
# enum mapping — which is how two components come to disagree about what
# "on-failure" means. Same reasoning agnostik applied at its 1.4.0 F-018.
#
# Exact match, no coercion: no case-folding, no trimming, no aliases. An
# unrecognised string is an error, not a silent fallback to a default
# policy, so a typo in config surfaces instead of quietly becoming
# RESTART_ALWAYS.
fn restart_policy_parse(s) {
    if (str_eq_cstr(s, "always") == 1)     { return Ok(RESTART_ALWAYS); }
    if (str_eq_cstr(s, "on-failure") == 1) { return Ok(RESTART_ON_FAILURE); }
    if (str_eq_cstr(s, "never") == 1)      { return Ok(RESTART_NEVER); }
    return Err(EINVAL);
}

# =========================================================================
# Restart config
# =========================================================================

#derive(Serialize)
struct RestartConfig {
    max_restarts;    # 0 = unlimited
    base_delay_ms;
    max_delay_ms;
}

fn restart_config_default() {
    var rc = alloc(sizeof(RestartConfig));
    store64(rc, 5);          # max_restarts
    store64(rc + 8, 1000);   # base_delay_ms
    store64(rc + 16, 30000); # max_delay_ms
    return rc;
}

# Exponential backoff delay. Minimum 100ms.
fn backoff_delay(rc, restart_count) {
    var base = load64(rc + 8);  # base_delay_ms
    var cap = load64(rc + 16);  # max_delay_ms
    if (base < 100) { base = 100; }
    if (cap < 100)  { cap = 100; }
    # 2^restart_count * base, saturating
    # 2026-08-24 audit LOW-2: clamp `base` to `cap` BEFORE multiplying.
    # `shift` saturates at 1e9, so an unvalidated base_delay_ms above
    # ~9.2e9 overflowed i64 in `base * shift` and produced a NEGATIVE
    # delay, which then sailed past the `delay > cap` clamp.
    if (base > cap) { base = cap; }
    var shift = 1;
    for (var i = 0; i < restart_count; i = i + 1) {
        if (shift > 1000000000) { shift = 1000000000; break; }
        shift = shift * 2;
    }
    var delay = base * shift;
    if (delay > cap) { delay = cap; }
    if (delay < 0)   { delay = cap; }
    return delay;
}

fn restart_limit_exceeded(rc, restart_count) {
    var max = load64(rc);  # max_restarts
    if (max == 0) { return 0; }
    return restart_count >= max;
}

# =========================================================================
# Health check types
# =========================================================================

enum HealthCheckType {
    HC_HTTP_GET;
    HC_TCP_CONNECT;
    HC_COMMAND;
    HC_PROCESS_ALIVE;
}

fn health_check_type_str(t) {
    if (t == HC_HTTP_GET) { return "http"; }
    if (t == HC_TCP_CONNECT) { return "tcp"; }
    if (t == HC_COMMAND) { return "command"; }
    if (t == HC_PROCESS_ALIVE) { return "process-alive"; }
    return "unknown";
}

# Inverse of health_check_type_str. See restart_policy_parse for rationale.
fn health_check_type_parse(s) {
    if (str_eq_cstr(s, "http") == 1)          { return Ok(HC_HTTP_GET); }
    if (str_eq_cstr(s, "tcp") == 1)           { return Ok(HC_TCP_CONNECT); }
    if (str_eq_cstr(s, "command") == 1)       { return Ok(HC_COMMAND); }
    if (str_eq_cstr(s, "process-alive") == 1) { return Ok(HC_PROCESS_ALIVE); }
    return Err(EINVAL);
}

# =========================================================================
# Health check
# =========================================================================

struct HealthCheck {
    check_type;     # HealthCheckType enum
    target;         # Str ptr (URL, host, or command)
    port;           # port for TCP (0 if not applicable)
    interval_ms;
    timeout_ms;
    retries;
}

fn health_check_new(check_type, target, port, interval_ms, timeout_ms, retries) {
    var hc = alloc(sizeof(HealthCheck));
    store64(hc, check_type);
    store64(hc + 8, target);
    store64(hc + 16, port);
    store64(hc + 24, interval_ms);
    store64(hc + 32, timeout_ms);
    store64(hc + 40, retries);
    return hc;
}

# HealthCheck accessors (1.10.0). argonaut read these fields by raw offset
# (src/health.cyr:181-184) and exposed nothing, so a consumer building or
# inspecting a health check had to hardcode the layout too. Same reasoning
# as the svc_def_set_* setters.
#
# ⚠ Prefixed `svc_hc_`, NOT `hc_`. agnostik already exports `hc_retries`,
# `hc_timeout`, `hc_interval` etc. for its OWN health_check struct, which
# has a different layout (its retries live at +24, argonaut's at +40).
# Every consumer that links both — kybernet does — would get whichever
# definition happened to come last in the include chain, silently reading
# the wrong field. Same collision class as agnostik's namespaced
# STIK_ERR_* errors.
fn svc_hc_type(hc)        { return load64(hc); }
fn svc_hc_target(hc)      { return load64(hc + 8); }
fn svc_hc_port(hc)        { return load64(hc + 16); }
fn svc_hc_interval_ms(hc) { return load64(hc + 24); }
fn svc_hc_timeout_ms(hc)  { return load64(hc + 32); }
fn svc_hc_retries(hc)     { return load64(hc + 40); }

# =========================================================================
# Ready check
# =========================================================================

struct ReadyCheck {
    check_type;     # HealthCheckType enum
    target;         # Str ptr
    port;           # port for TCP
    timeout_ms;
    retries;
    retry_delay_ms;
}

fn ready_check_new(check_type, target, port, timeout_ms, retries, retry_delay_ms) {
    var rc = alloc(sizeof(ReadyCheck));
    store64(rc, check_type);
    store64(rc + 8, target);
    store64(rc + 16, port);
    store64(rc + 24, timeout_ms);
    store64(rc + 32, retries);
    store64(rc + 40, retry_delay_ms);
    return rc;
}

# =========================================================================
# Service type
# =========================================================================

# ⚠ SVC_NOTIFY (1.13.6) is what makes READY=1 mean anything.
# `init_start_simple` sets STATE_RUNNING synchronously before returning, so
# under every other type a service is "running" the instant fork+exec succeeds
# and no service is ever left awaiting a notification — which is why sd_notify
# READY had nowhere to land. A SVC_NOTIFY service stays STATE_STARTING until it
# reports in, exactly like systemd's Type=notify.
#
# Appended, not inserted: these are stored raw in ServiceDefinition and
# renumbering the existing three would silently change the type of every
# service in a config written against an older argonaut.
enum ServiceType {
    SVC_SIMPLE;
    SVC_FORKING;
    SVC_ONESHOT;
    SVC_NOTIFY;
}

fn service_type_str(t) {
    if (t == SVC_SIMPLE)  { return "simple"; }
    if (t == SVC_FORKING) { return "forking"; }
    if (t == SVC_ONESHOT) { return "oneshot"; }
    if (t == SVC_NOTIFY)  { return "notify"; }
    return "unknown";
}

# Inverse of service_type_str. See restart_policy_parse for the rationale.
fn service_type_parse(s) {
    if (str_eq_cstr(s, "simple") == 1)  { return Ok(SVC_SIMPLE); }
    if (str_eq_cstr(s, "forking") == 1) { return Ok(SVC_FORKING); }
    if (str_eq_cstr(s, "oneshot") == 1) { return Ok(SVC_ONESHOT); }
    if (str_eq_cstr(s, "notify") == 1)  { return Ok(SVC_NOTIFY); }
    return Err(EINVAL);
}

# =========================================================================
# Service state
# =========================================================================

enum ServiceState {
    STATE_STOPPED;
    STATE_STARTING;
    STATE_RUNNING;
    STATE_STOPPING;
    STATE_FAILED;
}

fn service_state_str(s) {
    if (s == STATE_STOPPED)  { return "stopped"; }
    if (s == STATE_STARTING) { return "starting"; }
    if (s == STATE_RUNNING)  { return "running"; }
    if (s == STATE_STOPPING) { return "stopping"; }
    if (s == STATE_FAILED)   { return "failed"; }
    return "unknown";
}

# Valid state transitions
fn valid_transition(from, to) {
    if (from == to) { return 1; }
    if (from == STATE_STOPPED)  { return to == STATE_STARTING; }
    if (from == STATE_STARTING) { return (to == STATE_RUNNING) || (to == STATE_FAILED); }
    if (from == STATE_RUNNING)  { return (to == STATE_STOPPING) || (to == STATE_FAILED); }
    if (from == STATE_STOPPING) { return (to == STATE_STOPPED) || (to == STATE_FAILED); }
    if (from == STATE_FAILED)   { return (to == STATE_STARTING) || (to == STATE_STOPPED); }
    return 0;
}

# =========================================================================
# Resource limits
# =========================================================================

struct ResourceLimits {
    nofile;         # 0 = not set
    address_space;  # 0 = not set
    nproc;          # 0 = not set
    core;           # -1 = not set, 0 = disabled
}

fn resource_limits_empty() {
    var rl = alloc(sizeof(ResourceLimits));
    store64(rl, 0);
    store64(rl + 8, 0);
    store64(rl + 16, 0);
    store64(rl + 24, 0 - 1);  # core not set
    return rl;
}

# Generate prlimit(1) commands for a PID. Returns vec of SafeCommand ptrs.
fn to_prlimit_commands(rl, pid) {
    var cmds = vec_new();
    var pid_str = str_from_int(pid);

    var nofile = load64(rl);
    if (nofile > 0) {
        var cmd = safe_cmd_new(str_from("prlimit"));
        safe_cmd_add_arg(cmd, str_from("--pid"));
        safe_cmd_add_arg(cmd, pid_str);
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "--nofile=");
        str_builder_add_int(sb, nofile);
        safe_cmd_add_arg(cmd, str_builder_build(sb));
        vec_push(cmds, cmd);
    }

    var addr_space = load64(rl + 8);
    if (addr_space > 0) {
        var cmd = safe_cmd_new(str_from("prlimit"));
        safe_cmd_add_arg(cmd, str_from("--pid"));
        safe_cmd_add_arg(cmd, pid_str);
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "--as=");
        str_builder_add_int(sb, addr_space);
        safe_cmd_add_arg(cmd, str_builder_build(sb));
        vec_push(cmds, cmd);
    }

    var nproc = load64(rl + 16);
    if (nproc > 0) {
        var cmd = safe_cmd_new(str_from("prlimit"));
        safe_cmd_add_arg(cmd, str_from("--pid"));
        safe_cmd_add_arg(cmd, pid_str);
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "--nproc=");
        str_builder_add_int(sb, nproc);
        safe_cmd_add_arg(cmd, str_builder_build(sb));
        vec_push(cmds, cmd);
    }

    var core = load64(rl + 24);
    if (core >= 0) {
        var cmd = safe_cmd_new(str_from("prlimit"));
        safe_cmd_add_arg(cmd, str_from("--pid"));
        safe_cmd_add_arg(cmd, pid_str);
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "--core=");
        str_builder_add_int(sb, core);
        safe_cmd_add_arg(cmd, str_builder_build(sb));
        vec_push(cmds, cmd);
    }

    return cmds;
}

fn resource_limits_secure() {
    var rl = alloc(sizeof(ResourceLimits));
    store64(rl, 0);
    store64(rl + 8, 0);
    store64(rl + 16, 0);
    store64(rl + 24, 0);  # core dumps disabled
    return rl;
}

# =========================================================================
# Log config
# =========================================================================

struct LogConfig {
    max_size_bytes;
    max_files;
}

fn log_config_default() {
    var lc = alloc(sizeof(LogConfig));
    store64(lc, 10485760);  # 10 MB
    store64(lc + 8, 5);
    return lc;
}

# =========================================================================
# Socket types
# =========================================================================

# ⚠ EXPLICIT KERNEL VALUES. This enum was UNVALUED until 1.13.5, so cyrius
# numbered it from 0 — SOCK_STREAM=0, SOCK_DGRAM=1 — while the kernel and the
# stdlib's net.cyr use 1 and 2. That produced a `duplicate symbol 'SOCK_STREAM'
# redefined with conflicting value` warning on EVERY build of argonaut and of
# every consumer, and CLAUDE.md's own capability rule says a `conflicting value`
# warning means two definitions have genuinely diverged.
#
# It was harmless only by accident: every call site in this repo and in kybernet
# passes the literals (`sys_socket(1, 2, 0)`) with the value written in a
# comment, so the enum was decorative. Anyone who used the NAMES would have
# opened a STREAM socket for a datagram protocol. kybernet had to define its own
# `SOCK_DGRAM_TYPE = 2` specifically to avoid this.
#
# A build with a permanent warning trains people to ignore warnings.
enum SocketType {
    SOCK_STREAM = 1;
    SOCK_DGRAM = 2;
    SOCK_SEQPACKET = 5;
}

# =========================================================================
# Seccomp action
# =========================================================================

enum SeccompAction {
    SECCOMP_KILL;
    SECCOMP_TRAP;
    SECCOMP_LOG;
}

# =========================================================================
# Landlock access
# =========================================================================

enum LandlockAccess {
    LL_NO_ACCESS;
    LL_READ_ONLY;
    LL_READ_WRITE;
}

fn landlock_access_str(a) {
    if (a == LL_NO_ACCESS)   { return "none"; }
    if (a == LL_READ_ONLY)   { return "ro"; }
    if (a == LL_READ_WRITE)  { return "rw"; }
    return "unknown";
}

# =========================================================================
# Linux capabilities
# =========================================================================

# Linux capability numbers, as the KERNEL defines them
# (include/uapi/linux/capability.h). The value IS the capability number.
#
# ⚠ Rewritten at 1.11.0. This was a 13-entry list in an arbitrary order —
# CAP_NET_BIND_SERVICE was 0, CAP_SYS_ADMIN was 1 — and argonaut only ever
# used it for capability_str, so the wrong values were invisible here. They
# were not invisible downstream: agnostik defines an enum with the SAME NAME
# and the same member names, so any consumer linking both (kybernet does)
# got whichever came last in the include chain. argonaut's came last.
#
# kybernet's privilege drop builds a mask with `1 << cap` and hands it to
# capset(2), so under the old values "keep CAP_SYS_ADMIN" kept kernel
# capability 1 — CAP_DAC_OVERRIDE — and dropped CAP_SYS_ADMIN. Filed in
# kybernet's 2026-08-24 audit as cap-ordinal-vs-kernel-number; it became
# load-bearing at kybernet 1.5.2, when capability policy stopped being
# decorative.
#
# These values now match agnostik's (also corrected, at its 1.4.1), so the
# duplicate definition is value-identical and harmless. Explicit values, not
# implicit ordinals, so an insertion cannot renumber the tail.
enum LinuxCapability {
    CAP_CHOWN = 0;
    CAP_DAC_OVERRIDE = 1;
    CAP_DAC_READ_SEARCH = 2;
    CAP_FOWNER = 3;
    CAP_FSETID = 4;
    CAP_KILL = 5;
    CAP_SETGID = 6;
    CAP_SETUID = 7;
    CAP_SETPCAP = 8;
    CAP_LINUX_IMMUTABLE = 9;
    CAP_NET_BIND_SERVICE = 10;
    CAP_NET_BROADCAST = 11;
    CAP_NET_ADMIN = 12;
    CAP_NET_RAW = 13;
    CAP_IPC_LOCK = 14;
    CAP_IPC_OWNER = 15;
    CAP_SYS_MODULE = 16;
    CAP_SYS_RAWIO = 17;
    CAP_SYS_CHROOT = 18;
    CAP_SYS_PTRACE = 19;
    CAP_SYS_PACCT = 20;
    CAP_SYS_ADMIN = 21;
    CAP_SYS_BOOT = 22;
    CAP_SYS_NICE = 23;
    CAP_SYS_RESOURCE = 24;
    CAP_SYS_TIME = 25;
    CAP_SYS_TTY_CONFIG = 26;
    CAP_MKNOD = 27;
    CAP_LEASE = 28;
    CAP_AUDIT_WRITE = 29;
    CAP_AUDIT_CONTROL = 30;
    CAP_SETFCAP = 31;
    CAP_MAC_OVERRIDE = 32;
    CAP_MAC_ADMIN = 33;
    CAP_SYSLOG = 34;
    CAP_WAKE_ALARM = 35;
    CAP_BLOCK_SUSPEND = 36;
    CAP_AUDIT_READ = 37;
    CAP_PERFMON = 38;
    CAP_BPF = 39;
    CAP_CHECKPOINT_RESTORE = 40;
    CAP_LAST_CAP = 40;
}

# Canonical capability name — the lowercase cap_ spelling capsh(1),
# getcap(8) and capability(7) use, so config written against Linux
# documentation round-trips without translation.
fn capability_str(c) {
    if (c == CAP_CHOWN) { return "cap_chown"; }
    elif (c == CAP_DAC_OVERRIDE) { return "cap_dac_override"; }
    elif (c == CAP_DAC_READ_SEARCH) { return "cap_dac_read_search"; }
    elif (c == CAP_FOWNER) { return "cap_fowner"; }
    elif (c == CAP_FSETID) { return "cap_fsetid"; }
    elif (c == CAP_KILL) { return "cap_kill"; }
    elif (c == CAP_SETGID) { return "cap_setgid"; }
    elif (c == CAP_SETUID) { return "cap_setuid"; }
    elif (c == CAP_SETPCAP) { return "cap_setpcap"; }
    elif (c == CAP_LINUX_IMMUTABLE) { return "cap_linux_immutable"; }
    elif (c == CAP_NET_BIND_SERVICE) { return "cap_net_bind_service"; }
    elif (c == CAP_NET_BROADCAST) { return "cap_net_broadcast"; }
    elif (c == CAP_NET_ADMIN) { return "cap_net_admin"; }
    elif (c == CAP_NET_RAW) { return "cap_net_raw"; }
    elif (c == CAP_IPC_LOCK) { return "cap_ipc_lock"; }
    elif (c == CAP_IPC_OWNER) { return "cap_ipc_owner"; }
    elif (c == CAP_SYS_MODULE) { return "cap_sys_module"; }
    elif (c == CAP_SYS_RAWIO) { return "cap_sys_rawio"; }
    elif (c == CAP_SYS_CHROOT) { return "cap_sys_chroot"; }
    elif (c == CAP_SYS_PTRACE) { return "cap_sys_ptrace"; }
    elif (c == CAP_SYS_PACCT) { return "cap_sys_pacct"; }
    elif (c == CAP_SYS_ADMIN) { return "cap_sys_admin"; }
    elif (c == CAP_SYS_BOOT) { return "cap_sys_boot"; }
    elif (c == CAP_SYS_NICE) { return "cap_sys_nice"; }
    elif (c == CAP_SYS_RESOURCE) { return "cap_sys_resource"; }
    elif (c == CAP_SYS_TIME) { return "cap_sys_time"; }
    elif (c == CAP_SYS_TTY_CONFIG) { return "cap_sys_tty_config"; }
    elif (c == CAP_MKNOD) { return "cap_mknod"; }
    elif (c == CAP_LEASE) { return "cap_lease"; }
    elif (c == CAP_AUDIT_WRITE) { return "cap_audit_write"; }
    elif (c == CAP_AUDIT_CONTROL) { return "cap_audit_control"; }
    elif (c == CAP_SETFCAP) { return "cap_setfcap"; }
    elif (c == CAP_MAC_OVERRIDE) { return "cap_mac_override"; }
    elif (c == CAP_MAC_ADMIN) { return "cap_mac_admin"; }
    elif (c == CAP_SYSLOG) { return "cap_syslog"; }
    elif (c == CAP_WAKE_ALARM) { return "cap_wake_alarm"; }
    elif (c == CAP_BLOCK_SUSPEND) { return "cap_block_suspend"; }
    elif (c == CAP_AUDIT_READ) { return "cap_audit_read"; }
    elif (c == CAP_PERFMON) { return "cap_perfmon"; }
    elif (c == CAP_BPF) { return "cap_bpf"; }
    elif (c == CAP_CHECKPOINT_RESTORE) { return "cap_checkpoint_restore"; }
    return "unknown";
}

# Inverse of capability_str. Exact match — an unrecognised name errors
# rather than defaulting, because the failure mode of a silent default is
# retaining a capability the operator asked to drop.
#
# ⚠ Named `capability_from_str`, NOT `capability_parse`. agnostik exports
# `capability_parse` for its own (now value-identical) enum, and a consumer
# linking both — kybernet does — would get whichever came last in the
# include chain. Values agreeing makes that harmless *today*, but relying on
# "last definition wins" for a security primitive is the exact defect class
# this release exists to remove. Same resolution as `svc_hc_*` at 1.10.0.
fn capability_from_str(s) {
    if (str_eq_cstr(s, "cap_chown") == 1) { return Ok(CAP_CHOWN); }
    elif (str_eq_cstr(s, "cap_dac_override") == 1) { return Ok(CAP_DAC_OVERRIDE); }
    elif (str_eq_cstr(s, "cap_dac_read_search") == 1) { return Ok(CAP_DAC_READ_SEARCH); }
    elif (str_eq_cstr(s, "cap_fowner") == 1) { return Ok(CAP_FOWNER); }
    elif (str_eq_cstr(s, "cap_fsetid") == 1) { return Ok(CAP_FSETID); }
    elif (str_eq_cstr(s, "cap_kill") == 1) { return Ok(CAP_KILL); }
    elif (str_eq_cstr(s, "cap_setgid") == 1) { return Ok(CAP_SETGID); }
    elif (str_eq_cstr(s, "cap_setuid") == 1) { return Ok(CAP_SETUID); }
    elif (str_eq_cstr(s, "cap_setpcap") == 1) { return Ok(CAP_SETPCAP); }
    elif (str_eq_cstr(s, "cap_linux_immutable") == 1) { return Ok(CAP_LINUX_IMMUTABLE); }
    elif (str_eq_cstr(s, "cap_net_bind_service") == 1) { return Ok(CAP_NET_BIND_SERVICE); }
    elif (str_eq_cstr(s, "cap_net_broadcast") == 1) { return Ok(CAP_NET_BROADCAST); }
    elif (str_eq_cstr(s, "cap_net_admin") == 1) { return Ok(CAP_NET_ADMIN); }
    elif (str_eq_cstr(s, "cap_net_raw") == 1) { return Ok(CAP_NET_RAW); }
    elif (str_eq_cstr(s, "cap_ipc_lock") == 1) { return Ok(CAP_IPC_LOCK); }
    elif (str_eq_cstr(s, "cap_ipc_owner") == 1) { return Ok(CAP_IPC_OWNER); }
    elif (str_eq_cstr(s, "cap_sys_module") == 1) { return Ok(CAP_SYS_MODULE); }
    elif (str_eq_cstr(s, "cap_sys_rawio") == 1) { return Ok(CAP_SYS_RAWIO); }
    elif (str_eq_cstr(s, "cap_sys_chroot") == 1) { return Ok(CAP_SYS_CHROOT); }
    elif (str_eq_cstr(s, "cap_sys_ptrace") == 1) { return Ok(CAP_SYS_PTRACE); }
    elif (str_eq_cstr(s, "cap_sys_pacct") == 1) { return Ok(CAP_SYS_PACCT); }
    elif (str_eq_cstr(s, "cap_sys_admin") == 1) { return Ok(CAP_SYS_ADMIN); }
    elif (str_eq_cstr(s, "cap_sys_boot") == 1) { return Ok(CAP_SYS_BOOT); }
    elif (str_eq_cstr(s, "cap_sys_nice") == 1) { return Ok(CAP_SYS_NICE); }
    elif (str_eq_cstr(s, "cap_sys_resource") == 1) { return Ok(CAP_SYS_RESOURCE); }
    elif (str_eq_cstr(s, "cap_sys_time") == 1) { return Ok(CAP_SYS_TIME); }
    elif (str_eq_cstr(s, "cap_sys_tty_config") == 1) { return Ok(CAP_SYS_TTY_CONFIG); }
    elif (str_eq_cstr(s, "cap_mknod") == 1) { return Ok(CAP_MKNOD); }
    elif (str_eq_cstr(s, "cap_lease") == 1) { return Ok(CAP_LEASE); }
    elif (str_eq_cstr(s, "cap_audit_write") == 1) { return Ok(CAP_AUDIT_WRITE); }
    elif (str_eq_cstr(s, "cap_audit_control") == 1) { return Ok(CAP_AUDIT_CONTROL); }
    elif (str_eq_cstr(s, "cap_setfcap") == 1) { return Ok(CAP_SETFCAP); }
    elif (str_eq_cstr(s, "cap_mac_override") == 1) { return Ok(CAP_MAC_OVERRIDE); }
    elif (str_eq_cstr(s, "cap_mac_admin") == 1) { return Ok(CAP_MAC_ADMIN); }
    elif (str_eq_cstr(s, "cap_syslog") == 1) { return Ok(CAP_SYSLOG); }
    elif (str_eq_cstr(s, "cap_wake_alarm") == 1) { return Ok(CAP_WAKE_ALARM); }
    elif (str_eq_cstr(s, "cap_block_suspend") == 1) { return Ok(CAP_BLOCK_SUSPEND); }
    elif (str_eq_cstr(s, "cap_audit_read") == 1) { return Ok(CAP_AUDIT_READ); }
    elif (str_eq_cstr(s, "cap_perfmon") == 1) { return Ok(CAP_PERFMON); }
    elif (str_eq_cstr(s, "cap_bpf") == 1) { return Ok(CAP_BPF); }
    elif (str_eq_cstr(s, "cap_checkpoint_restore") == 1) { return Ok(CAP_CHECKPOINT_RESTORE); }
    return Err(EINVAL);
}

# =========================================================================
# Shutdown types
# =========================================================================

enum ShutdownType {
    SHUTDOWN_POWEROFF;
    SHUTDOWN_REBOOT;
    SHUTDOWN_HALT;
    SHUTDOWN_KEXEC;
}

fn shutdown_type_str(t) {
    if (t == SHUTDOWN_POWEROFF) { return "poweroff"; }
    if (t == SHUTDOWN_REBOOT)   { return "reboot"; }
    if (t == SHUTDOWN_HALT)     { return "halt"; }
    if (t == SHUTDOWN_KEXEC)    { return "kexec"; }
    return "unknown";
}

# =========================================================================
# Shutdown actions
# =========================================================================

enum ShutdownAction {
    SA_WALL_MESSAGE;
    SA_NOTIFY_AGENTS;
    SA_STOP_SERVICE;
    SA_FORCE_KILL;
    SA_SYNC_FS;
    SA_UNMOUNT_FS;
    SA_SWAP_OFF;
    SA_CLOSE_LUKS;
    SA_KERNEL_ACTION;
}

# =========================================================================
# Shutdown step status
# =========================================================================

enum ShutdownStepStatus {
    SS_PENDING;
    SS_IN_PROGRESS;
    SS_COMPLETE;
    SS_FAILED;
    SS_SKIPPED;
}

# =========================================================================
# Runlevel
# =========================================================================

enum Runlevel {
    RL_EMERGENCY;
    RL_RESCUE;
    RL_CONSOLE;
    RL_GRAPHICAL;
    RL_CONTAINER;
    RL_EDGE;
}

fn runlevel_str(r) {
    if (r == RL_EMERGENCY) { return "emergency"; }
    if (r == RL_RESCUE)    { return "rescue"; }
    if (r == RL_CONSOLE)   { return "console"; }
    if (r == RL_GRAPHICAL) { return "graphical"; }
    if (r == RL_CONTAINER) { return "container"; }
    if (r == RL_EDGE)      { return "edge"; }
    return "unknown";
}

fn runlevel_level(r) {
    if (r == RL_EMERGENCY) { return 0; }
    if (r == RL_RESCUE)    { return 1; }
    if (r == RL_CONSOLE)   { return 3; }
    if (r == RL_GRAPHICAL) { return 5; }
    if (r == RL_CONTAINER) { return 7; }
    if (r == RL_EDGE)      { return 8; }
    return 0 - 1;
}

fn runlevel_to_boot_mode(r) {
    if (r == RL_CONSOLE)   { return BOOT_SERVER; }
    if (r == RL_GRAPHICAL) { return BOOT_DESKTOP; }
    if (r == RL_CONTAINER) { return BOOT_MINIMAL; }
    if (r == RL_EDGE)      { return BOOT_EDGE; }
    return 0 - 1;  # Emergency/Rescue have no boot mode
}

fn boot_mode_to_runlevel(m) {
    if (m == BOOT_SERVER)   { return RL_CONSOLE; }
    if (m == BOOT_DESKTOP)  { return RL_GRAPHICAL; }
    if (m == BOOT_MINIMAL)  { return RL_CONTAINER; }
    if (m == BOOT_EDGE)     { return RL_EDGE; }
    if (m == BOOT_RECOVERY) { return RL_EMERGENCY; }
    return RL_EMERGENCY;
}

# =========================================================================
# Exit status
# =========================================================================

enum ExitStatusType {
    EXIT_CODE;
    EXIT_SIGNAL;
    EXIT_RUNNING;
    EXIT_NOT_STARTED;
}

struct ExitStatus {
    status_type;   # ExitStatusType
    value;         # exit code or signal number
}

# =========================================================================
# Crash action
# =========================================================================

enum CrashActionType {
    CRASH_RESTART;
    CRASH_IGNORE;
    CRASH_GIVE_UP;
}

struct CrashAction {
    action_type;    # CrashActionType
    delay_ms;       # for CRASH_RESTART
    reason;         # Str ptr for CRASH_GIVE_UP
}

struct ReapResult {
    name;           # Str ptr (service name)
    exit_code;      # i64
    action;         # CrashAction ptr
}

# =========================================================================
# Service definition — static configuration for a managed service
# =========================================================================

struct ServiceDefinition {
    name;                # Str ptr
    description;         # Str ptr
    binary_path;         # Str ptr
    args;                # vec of Str ptrs
    environment;         # map of Str -> Str
    depends_on;          # vec of Str ptrs
    required_for_modes;  # vec of BootMode values
    restart_policy;      # RestartPolicy enum
    restart_config;      # ptr to RestartConfig
    health_check;        # ptr to HealthCheck (0 = none)
    ready_check;         # ptr to ReadyCheck (0 = none)
    enabled;             # 1/0
    service_type;        # ServiceType enum
    env_files;           # vec of Str ptrs
    pid_file;            # Str ptr (0 = none)
    resource_limits;     # ptr to ResourceLimits (0 = none)
    log_config;          # ptr to LogConfig (0 = none)
    socket_activation;   # vec of socket specs (0 = none)
    seccomp;             # seccomp config (0 = none)
    landlock;            # landlock config (0 = none)
    capabilities;        # vec of capabilities to drop (0 = none)
    cgroup_limits;       # opaque cgroup-limits config (0 = none)
    watchdog_ms;         # sd_notify watchdog interval, ms (0 = no watchdog)
}

fn svc_def_new(name, desc, binary) {
    var sd = alloc(sizeof(ServiceDefinition));
    store64(sd, name);
    store64(sd + 8, desc);
    store64(sd + 16, binary);
    store64(sd + 24, vec_new());        # args
    store64(sd + 32, map_new());        # environment
    store64(sd + 40, vec_new());        # depends_on
    store64(sd + 48, vec_new());        # required_for_modes
    store64(sd + 56, RESTART_ON_FAILURE);
    store64(sd + 64, restart_config_default());
    store64(sd + 72, 0);                # health_check
    store64(sd + 80, 0);                # ready_check
    store64(sd + 88, 1);                # enabled
    store64(sd + 96, SVC_SIMPLE);
    store64(sd + 104, vec_new());       # env_files
    store64(sd + 112, 0);               # pid_file
    store64(sd + 120, 0);               # resource_limits
    store64(sd + 128, 0);               # log_config
    store64(sd + 136, 0);               # socket_activation
    store64(sd + 144, 0);               # seccomp
    store64(sd + 152, 0);               # landlock
    store64(sd + 160, 0);               # capabilities
    store64(sd + 168, 0);               # cgroup_limits
    store64(sd + 176, 0);               # watchdog_ms
    return sd;
}

# Accessors for ServiceDefinition
fn svc_def_name(sd)          { return load64(sd); }
fn svc_def_desc(sd)          { return load64(sd + 8); }
fn svc_def_binary(sd)        { return load64(sd + 16); }
fn svc_def_args(sd)          { return load64(sd + 24); }
fn svc_def_env(sd)           { return load64(sd + 32); }
fn svc_def_deps(sd)          { return load64(sd + 40); }
fn svc_def_modes(sd)         { return load64(sd + 48); }
fn svc_def_restart_policy(sd){ return load64(sd + 56); }
fn svc_def_restart_config(sd){ return load64(sd + 64); }
fn svc_def_health_check(sd)  { return load64(sd + 72); }
fn svc_def_ready_check(sd)   { return load64(sd + 80); }
# 1.15.0 — the field was readable and settable by nothing, so `ready_check` was
# argonaut's default on every consumer board. `init_start_service` HAS consulted
# it since 1.10 (init.cyr:467, :875); only the setter was missing.
fn svc_def_set_ready_check(sd, rc) { store64(sd + 80, rc); return sd; }
fn svc_def_enabled(sd)       { return load64(sd + 88); }
fn svc_def_service_type(sd)  { return load64(sd + 96); }
fn svc_def_env_files(sd)     { return load64(sd + 104); }
fn svc_def_pid_file(sd)      { return load64(sd + 112); }
fn svc_def_rlimits(sd)       { return load64(sd + 120); }
fn svc_def_log_config(sd)    { return load64(sd + 128); }

# Per-service security policy (1.9.0).
#
# These three fields have existed in ServiceDefinition since the struct was
# written and have been zero-initialised by svc_def_new the whole time, but
# had no accessors — so no consumer could read or set them, and argonaut's
# fork/exec path had nothing to apply. That is the argonaut half of what
# kybernet filed as its 2026-08-24 audit HIGH-1: the security stack could
# not be reached, not because the policy was missing but because there was
# no seam.
#
# Adding accessors is layout-neutral (offsets 144/152/160 are already
# allocated and already zeroed), so this is additive for every consumer.
# The values are OPAQUE to argonaut — it never interprets them. It hands
# the whole ServiceDefinition to the pre-exec hook (see process_mgmt.cyr)
# and the consumer decides what a "seccomp config" or "landlock config"
# means. 0 means "no policy for this service", which is the default.
fn svc_def_seccomp(sd)       { return load64(sd + 144); }
fn svc_def_landlock(sd)      { return load64(sd + 152); }
fn svc_def_capabilities(sd)  { return load64(sd + 160); }

# watchdog_ms (1.13.6) — the sd_notify watchdog interval, INDEPENDENT of
# health_check.
#
# ⚠ BEFORE THIS, A SERVICE WITH NO health_check HAD NO WATCHDOG AT ALL. The
# runtime watchdog arm in init_check_watchdog was gated entirely on
# `svc_def_health_check(sd) != 0`, so `WATCHDOG=1` had nothing to refresh for
# the majority of services — and the only refreshable field,
# `managed_svc_last_hc`, already meant "a probe argonaut ran and saw pass".
#
# This is the deadline a self-reported ping is allowed to satisfy, and nothing
# else: it never touches last_health_check, so a service cannot silence an
# externally-observed health failure by pinging. 0 = no notify watchdog, which
# is the default and preserves existing behaviour exactly.
fn svc_def_watchdog_ms(sd)          { return load64(sd + 176); }
fn svc_def_set_watchdog_ms(sd, ms)  { store64(sd + 176, ms); return sd; }

# cgroup_limits (1.13.0). Opaque to argonaut for the same reason seccomp and
# landlock are: argonaut does not create cgroups and does not know what a
# "limit" means. It carries the pointer so a supervisor can attach limits to
# a service definition the same way it attaches a security policy, and read
# them back at start time. kybernet stores agnostik's cgroup_limits here.
fn svc_def_cgroup_limits(sd) { return load64(sd + 168); }

# Field setters (1.10.0). Without these a consumer building a
# ServiceDefinition from config had to write raw `store64(sd + 56, ...)`
# offsets into its own source — which puts argonaut's struct layout into
# every consumer and turns any future reordering into a silent
# wrong-field write. kybernet's config parser uses these.
fn svc_def_set_desc(sd, d)            { store64(sd + 8, d); return sd; }
fn svc_def_set_binary(sd, b)          { store64(sd + 16, b); return sd; }
fn svc_def_set_restart_policy(sd, p)  { store64(sd + 56, p); return sd; }
fn svc_def_set_restart_config(sd, rc) { store64(sd + 64, rc); return sd; }
fn svc_def_set_health_check(sd, hc)   { store64(sd + 72, hc); return sd; }
fn svc_def_set_enabled(sd, on)        { store64(sd + 88, on); return sd; }
fn svc_def_set_service_type(sd, t)    { store64(sd + 96, t); return sd; }
fn svc_def_set_pid_file(sd, p)        { store64(sd + 112, p); return sd; }

fn svc_def_set_seccomp(sd, cfg)      { store64(sd + 144, cfg); return sd; }
fn svc_def_set_landlock(sd, cfg)     { store64(sd + 152, cfg); return sd; }
fn svc_def_set_capabilities(sd, caps) { store64(sd + 160, caps); return sd; }
fn svc_def_set_cgroup_limits(sd, cl)  { store64(sd + 168, cl); return sd; }

# =========================================================================
# Managed service — runtime state of a service
# =========================================================================

struct ManagedService {
    definition;          # ptr to ServiceDefinition
    state;               # ServiceState enum
    pid;                 # i64 (0 = not running)
    started_at;          # epoch ms (0 = not started)
    restart_count;       # i64
    last_health_check;   # epoch ms (0 = never)
    last_notify;         # epoch ms of the last authenticated WATCHDOG= ping
}

# ⚠ `last_notify` IS DELIBERATELY SEPARATE FROM `last_health_check`, AND
# CONFLATING THEM WOULD BE A SAFETY INVERSION.
#
# `last_health_check` means "the last health probe argonaut RAN and OBSERVED
# passing". `last_notify` means "the service SAID it was alive". Those are not
# interchangeable: refreshing the health timestamp from a self-reported ping
# lets a wedged service silence a probe that argonaut actually ran and watched
# fail. Authentication does not cure that — SCM_CREDENTIALS proves the ping came
# from the service, not that the service is honest about its own health.
#
# So the watchdog consults whichever deadline the operator configured, and never
# lets one satisfy the other.

fn managed_svc_new(definition) {
    var ms = alloc(sizeof(ManagedService));
    store64(ms, definition);
    store64(ms + 8, STATE_STOPPED);
    store64(ms + 16, 0);
    store64(ms + 24, 0);
    store64(ms + 32, 0);
    store64(ms + 40, 0);
    store64(ms + 48, 0);       # last_notify
    return ms;
}

fn managed_svc_def(ms)      { return load64(ms); }
fn managed_svc_state(ms)    { return load64(ms + 8); }
fn managed_svc_pid(ms)      { return load64(ms + 16); }
fn managed_svc_started(ms)  { return load64(ms + 24); }
fn managed_svc_restarts(ms) { return load64(ms + 32); }
fn managed_svc_last_hc(ms)  { return load64(ms + 40); }
fn managed_svc_last_notify(ms) { return load64(ms + 48); }

fn managed_svc_set_state(ms, state)     { store64(ms + 8, state); }
fn managed_svc_set_pid(ms, pid)         { store64(ms + 16, pid); }
fn managed_svc_set_started(ms, ts)      { store64(ms + 24, ts); }
fn managed_svc_set_restarts(ms, n)      { store64(ms + 32, n); }
fn managed_svc_set_last_hc(ms, ts)      { store64(ms + 40, ts); }
fn managed_svc_set_last_notify(ms, ts)  { store64(ms + 48, ts); }

# =========================================================================
# Edge boot config
# =========================================================================

#derive(Serialize)
struct EdgeBootConfig {
    readonly_rootfs;     # 1/0
    luks_enabled;        # 1/0
    tpm_attestation;     # 1/0
    max_boot_ms;
    pcr_bindings;        # Str ptr
}

fn edge_config_default() {
    var ec = alloc(sizeof(EdgeBootConfig));
    store64(ec, 1);                      # readonly_rootfs
    store64(ec + 8, 1);                  # luks_enabled
    store64(ec + 16, 1);                 # tpm_attestation
    store64(ec + 24, 3000);              # max_boot_time_ms
    store64(ec + 32, str_from("7+14"));  # pcr_bindings
    return ec;
}

# =========================================================================
# Argonaut config — top-level configuration
# =========================================================================

struct ArgonautConfig {
    boot_mode;
    services;            # vec of ServiceDefinition ptrs
    boot_timeout_ms;
    shutdown_timeout_ms;
    log_to_console;      # 1/0
    verify_on_boot;      # 1/0
    edge_boot;           # ptr to EdgeBootConfig
    tmpfiles;            # vec of tmpfile entries
    audit_persist;       # 1/0 — opt-in PatraStore audit-log persistence (1.5.3)
    audit_path;          # Str — on-disk path when audit_persist == 1
    audit_retain;        # 1/0 — keep the in-memory chain queryable (1.13.8)
}

fn argonaut_config_default() {
    var cfg = alloc(sizeof(ArgonautConfig));
    store64(cfg, BOOT_DESKTOP);
    store64(cfg + 8, vec_new());
    store64(cfg + 16, 30000);
    store64(cfg + 24, 10000);
    store64(cfg + 32, 1);
    store64(cfg + 40, 1);
    store64(cfg + 48, edge_config_default());
    store64(cfg + 56, vec_new());
    store64(cfg + 64, 0);                              # audit_persist off by default
    store64(cfg + 72, str_from("/var/log/argonaut.patra"));   # default path; unused when audit_persist == 0
    store64(cfg + 80, 0);                              # audit_retain: streaming; see config_audit_retain
    return cfg;
}

fn config_boot_mode(cfg)          { return load64(cfg); }
fn config_services(cfg)           { return load64(cfg + 8); }
fn config_boot_timeout(cfg)       { return load64(cfg + 16); }
fn config_shutdown_timeout(cfg)   { return load64(cfg + 24); }
fn config_log_console(cfg)        { return load64(cfg + 32); }
fn config_verify_boot(cfg)        { return load64(cfg + 40); }
fn config_edge(cfg)               { return load64(cfg + 48); }
fn config_tmpfiles(cfg)           { return load64(cfg + 56); }
fn config_audit_persist(cfg)      { return load64(cfg + 64); }
fn config_audit_path(cfg)         { return load64(cfg + 72); }

# 1.10.1 — boot_mode is field 0 and every consumer that wanted to change it
# wrote `store64(cfg, mode)` by hand, putting the layout in their source.
fn config_set_boot_mode(cfg, mode)     { store64(cfg, mode); return cfg; }

fn config_set_audit_persist(cfg, on)   { store64(cfg + 64, on); return cfg; }
fn config_set_audit_path(cfg, path)    { store64(cfg + 72, path); return cfg; }

# ⚠ DEFAULTS TO 0 (STREAMING), AND THAT IS A DELIBERATE BEHAVIOUR CHANGE AT 1.13.8.
#
# The in-memory audit chain retained every entry forever: measured at **240 bytes
# per record**, one record per service start/stop/crash and per health probe, in a
# supervisor whose consumer is PID 1 and never exits. At a 30 s health interval
# that is ~0.68 MB/day/service of live, reachable growth — not merely un-freeable
# arena, but a data structure that keeps growing.
#
# ⚠ `chain_with_capacity` DOES NOT FIX IT, and I checked rather than assumed:
# `_chain_auto_rotate` calls `chain_rotate`, which archives the entries vec into
# the `overflow` vec (libro.cyr). The entries stay referenced — memory is MOVED,
# not freed. Under a bump allocator that is identical growth plus archive
# overhead.
#
# libro's streaming chain is the actual fix and is documented for exactly this
# consumer shape ("wrong shape for a write-through consumer... a long-lived
# writer grew forever"). It keeps only the head hash, so **linkage across appends
# is byte-identical** — a chain persisted to a store verifies exactly as before.
# Memory is O(1).
#
# The trade is explicit: on a streaming chain `chain_len` is always 0 and every
# query returns empty. Nothing in argonaut or kybernet READS the init-owned chain
# in production — kybernet makes zero direct `audit_*` calls — so the default
# costs nothing real. A consumer that genuinely wants to query its own history in
# memory sets `audit_retain: 1` and accepts the growth knowingly.
#
# This is not silent truncation. A streaming chain never retains, so there is
# nothing for an attacker to flush by generating noise, and the durable record —
# when `audit_persist` is on — is untouched.
fn config_audit_retain(cfg)            { return load64(cfg + 80); }
fn config_set_audit_retain(cfg, on)    { store64(cfg + 80, on); return cfg; }

# =========================================================================
# Argonaut stats — snapshot of init-system statistics
# =========================================================================

#derive(Serialize)
struct ArgonautStats {
    boot_mode;
    boot_dur_ms;        # 0 = not complete
    svcs_running;
    svcs_failed;
    total_restarts;
    boot_complete;      # 1/0
}

# =========================================================================
# Shutdown step
# =========================================================================

struct ShutdownStep {
    description;        # Str ptr
    action;             # ShutdownAction enum
    action_data;        # Str ptr (service name, message, or ShutdownType)
    signal;             # signal number for SA_STOP_SERVICE
    timeout_ms;
    status;             # ShutdownStepStatus enum
}

fn shutdown_step_new(desc, action, data, signal, timeout_ms) {
    var ss = alloc(sizeof(ShutdownStep));
    store64(ss, desc);
    store64(ss + 8, action);
    store64(ss + 16, data);
    store64(ss + 24, signal);
    store64(ss + 32, timeout_ms);
    store64(ss + 40, SS_PENDING);
    return ss;
}

# =========================================================================
# Shutdown plan
# =========================================================================

struct ShutdownPlan {
    shutdown_type;       # ShutdownType enum
    steps;               # vec of ShutdownStep ptrs
    timeout_ms;
    wall_message;        # Str ptr (0 = none)
}

# =========================================================================
# Runlevel switch plan
# =========================================================================

struct RunlevelSwitchPlan {
    from;                # Runlevel
    to;                  # Runlevel
    services_to_start;   # vec of Str
    services_to_stop;    # vec of Str
    drop_to_shell;       # 1/0
}

# =========================================================================
# Runlevel switch result
# =========================================================================

struct RunlevelSwitchResult {
    from;
    to;
    stopped;             # vec of Str
    started;             # vec of Str
    errors;              # vec of Str
    drop_to_shell;       # 1/0
}

# =========================================================================
# Health check result
# =========================================================================

#derive(Serialize)
struct HealthCheckResult {
    service;            # Str ptr
    check_type_str;     # Str ptr
    passed;             # 1/0
    latency_ms;
    message;            # Str ptr (0 = none)
    checked_at;         # epoch ms
}

# =========================================================================
# Health tracker — consecutive failure counts
# =========================================================================

# Uses a map: service name -> consecutive failure count
fn health_tracker_new() {
    return map_new();
}

fn health_tracker_record(tracker, service, passed, threshold) {
    if (passed) {
        map_delete(tracker, service);
        return 0;  # no restart needed
    }
    var count = map_get(tracker, service);
    count = count + 1;
    map_set(tracker, service, count);
    return count >= threshold;  # 1 = should restart
}

fn health_tracker_count(tracker, service) {
    return map_get(tracker, service);
}

fn health_tracker_reset(tracker, service) {
    map_delete(tracker, service);
}

# =========================================================================
# SafeCommand — injection-resistant command representation
# =========================================================================

struct SafeCommand {
    binary;             # Str ptr
    args;               # vec of Str ptrs
}

fn safe_cmd_new(binary) {
    var sc = alloc(sizeof(SafeCommand));
    store64(sc, binary);
    store64(sc + 8, vec_new());
    return sc;
}

fn safe_cmd_add_arg(sc, arg) {
    vec_push(load64(sc + 8), arg);
}

fn safe_cmd_binary(sc) { return load64(sc); }
fn safe_cmd_args(sc)   { return load64(sc + 8); }

# Display: "binary arg1 arg2 ..."
fn safe_cmd_display(sc) {
    var sb = str_builder_new();
    str_builder_add(sb, safe_cmd_binary(sc));
    var args = safe_cmd_args(sc);
    for (var i = 0; i < vec_len(args); i = i + 1) {
        str_builder_add_cstr(sb, " ");
        str_builder_add(sb, vec_get(args, i));
    }
    return str_builder_build(sb);
}

# =========================================================================
# Tmpfile entry types
# =========================================================================

enum TmpfileType {
    TMP_DIRECTORY;
    TMP_SYMLINK;
    TMP_DEVICE;
}

struct TmpfileEntry {
    entry_type;         # TmpfileType
    path;               # Str ptr
    target;             # Str ptr (for symlink)
    mode;               # octal mode
    uid;                # -1 = not set
    gid;                # -1 = not set
    dev_type;           # 'b' or 'c' (for device)
    major;              # device major
    minor;              # device minor
}

# =========================================================================
# Service target — groups related services
# =========================================================================

struct ServiceTarget {
    name;               # Str ptr
    description;        # Str ptr
    requires;           # vec of Str
    wants;              # vec of Str
    active_in;          # vec of Runlevel values
}

# =========================================================================
# Emergency shell config
# =========================================================================

struct EmergencyShellConfig {
    shell_path;          # Str ptr
    environment;         # map of Str -> Str
    banner;              # Str ptr
    require_auth;        # 1/0
    auth_password_hash;  # Str ptr (0 = none)
}

fn emergency_shell_default() {
    var esc = alloc(sizeof(EmergencyShellConfig));
    store64(esc, str_from("/usr/bin/agnoshi"));
    var env = map_new();
    map_set(env, "HOME", str_from("/root"));
    map_set(env, "TERM", str_from("linux"));
    map_set(env, "PATH", str_from("/usr/sbin:/usr/bin:/sbin:/bin"));
    map_set(env, "SHELL", str_from("/usr/bin/agnoshi"));
    store64(esc + 8, env);
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "\n========================================\n");
    str_builder_add_cstr(sb, "  AGNOS Emergency Shell\n");
    str_builder_add_cstr(sb, "========================================\n\n");
    str_builder_add_cstr(sb, "The system has entered emergency mode.\n");
    str_builder_add_cstr(sb, "Use 'argonaut status' to check service state.\n");
    str_builder_add_cstr(sb, "Use 'argonaut start <service>' to start services.\n");
    str_builder_add_cstr(sb, "Use 'exit' to continue boot or 'reboot' to restart.\n");
    store64(esc + 16, str_builder_build(sb));
    store64(esc + 24, 0);   # require_auth = false
    store64(esc + 32, 0);   # no password hash
    return esc;
}

# =========================================================================
# Edge boot result
# =========================================================================

struct EdgeBootResult {
    rootfs_locked;       # 1/0
    verity_verified;     # 1/0
    luks_unlocked;       # 1/0
    boot_time_ms;
    within_budget;       # 1/0
    errors;              # vec of Str
}

# =========================================================================
# Fleet registration (edge auto-registration)
# =========================================================================

#derive(Serialize)
struct FleetRegistration {
    machine_id;          # Str ptr
    hostname;            # Str ptr
    boot_mode_str;       # Str ptr
    verity_active;       # 1/0
    luks_active;         # 1/0
    kernel_ver;          # Str ptr
    total_mem_mb;
}

# =========================================================================
# Timestamp helper — epoch milliseconds via clock_gettime
# =========================================================================

fn now_ms() {
    var buf[16];
    # clock_gettime(CLOCK_REALTIME=0, &timespec)
    ag_sys_clock_gettime(0, &buf);
    var sec = load64(&buf);
    var nsec = load64(&buf + 8);
    return sec * 1000 + nsec / 1000000;
}

# Monotonic clock for uptime/elapsed measurements
fn monotonic_ms() {
    var buf[16];
    # clock_gettime(CLOCK_MONOTONIC=1, &timespec)
    ag_sys_clock_gettime(1, &buf);
    var sec = load64(&buf);
    var nsec = load64(&buf + 8);
    return sec * 1000 + nsec / 1000000;
}
